        local key = tostring(quest.quest_name) .. "#" .. tostring(quest.quest_num)
        if API.QuestAlreadyTaken(key, quest.mob_name) then
            return true
        end
        -- Quest da hien san tren bang (vao lai server, script chay lai): dung
