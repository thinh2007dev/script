    local function sea2KeySaved()
        if type(runtime.meleeSave.Sea2Keys) ~= "table" then
            runtime.meleeSave.Sea2Keys = {}
        end
        return runtime.meleeSave.Sea2Keys
    end

    -- MONOTONIC: chi false -> true, khong bao gio true -> false. Khong thay key
    -- trong balo / remote loi / server tra nil deu KHONG duoc xoa co da bat.
    local function sea2KeyMarkDone(row, why)
        local saved = sea2KeySaved()
        if saved[row.Field] == true then
            return
        end
        saved[row.Field] = true
        pcall(writeMeleeSave)
        print(("[SEA2 KEY] %s requirement DONE (%s) -> saved"):format(
            row.Label, tostring(why)))
    end

    -- Hop nhat file save + trang thai that cua acc + key dang cam. Goi moi vong
    -- danh gia; chi ghi file khi co thay doi.
    -- ============ FIX PROBE MELEE SAI ============
    -- SUA MOT LAN nhung co da bi probe cu ghi sai. Dau tay khong the lan:
    -- dong melee co Done = true ma Bought ~= true. Mua that thi moi cho ghi
    -- Bought = true, con probe chi ghi Done.
    local function sea2KeyRepairOnce()
        local saved = sea2KeySaved()
        if saved.ProbeFix == true then
            return
        end
        saved.ProbeFix = true
        local cleared = {}
        for _, row in ipairs(SEA2_KEYS) do
            local savedMelee = runtime.meleeSave.Melee
                and runtime.meleeSave.Melee[row.Melee]
            local bogus = savedMelee ~= nil
                and savedMelee.Done == true
                and savedMelee.Bought ~= true
            if bogus then
                savedMelee.Done = nil
                local progress = runtime.meleeProgress[row.Melee]
                if progress ~= nil then
                    progress.Done = false
                end
                if saved[row.Field] == true and meleeToolByName(row.Melee) == nil then
                    saved[row.Field] = nil
                    table.insert(cleared, row.Label)
                end
            end
        end
        pcall(writeMeleeSave)
        if #cleared > 0 then
            warn(("[SEA2 KEY] xoa co bi probe cu ghi sai: %s - san lai tu dau")
                :format(table.concat(cleared, ", ")))
        end
    end

    function API.Sea2KeyState()
        sea2KeyRepairOnce()
        local saved = sea2KeySaved()
        local state = {}
        for _, row in ipairs(SEA2_KEYS) do
            -- RECONCILE: bang chung PHAI LA SO HUU THAT. Lay co `Done` lam bang
            -- chung la sai - probe check melee tra ma so (BuySharkmanKarate(true)
            -- = 3 = KHONG mua duoc) ma code cu chi loc chuoi, nen Done = true
            -- ca tren acc chua he co key -> khoa vinh vien viec di san boss.
            if saved[row.Field] ~= true then
                local savedMelee = runtime.meleeSave.Melee
                    and runtime.meleeSave.Melee[row.Melee]
                if meleeToolByName(row.Melee) ~= nil
                    or (savedMelee ~= nil and savedMelee.Bought == true)
                then
                    sea2KeyMarkDone(row, "da so huu " .. row.Melee)
                end
            end
            local done = saved[row.Field] == true
            local holding = carriesItem(row.Key)
            state[row.Field] = done
            -- DANG CAM cung la khong can san boss nua: viec con lai la di nop.
            state["Need" .. row.Field:gsub("Done$", "")] = not done and not holding
            state[row.Key] = {
                done = done,
                holding = holding,
                need = not done and not holding,
                boss = row.Boss,
                melee = row.Melee,
                label = row.Label,
            }
        end
        state.rows = SEA2_KEYS
        return state
    end

    -- Boss nao con thuc su can. Tra ve mot bang { [bossName] = row }.
    function API.Sea2KeyBossWanted()
        local state = API.Sea2KeyState()
        local wanted = {}
        for _, row in ipairs(SEA2_KEYS) do
            if state[row.Key].need then
                wanted[row.Boss] = row
            end
        end
        return wanted, state
    end

