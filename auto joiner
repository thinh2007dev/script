    function API.TPMirrorPortal(queueLabel)
        local runService = game:GetService("RunService")
        if not runtime.rootPart or not runtime.humanoid then
            return false
        end
        -- Phai HA co truoc khi bay ve cong. Con co la moi lenh TP xa hon 1000
        -- studs bi chan ngay -> nhan vat treo lo lung, khong bao gio ve cong.
        runtime.cakePrinceDoughKing = false
        runtime.cakePrinceFailed = false
        API.TP(mirrorPortalDestination, queueLabel)
        if queueLabel ~= nil and not runtime.queue:empty() and runtime.queue:top() ~= queueLabel then
            return false
        end
        if not runtime.rootPart or not runtime.humanoid or runtime.humanoid.Health <= 0 then
            return false
        end

        local map = Services.Workspace:FindFirstChild("Map")
        local cakeLoaf = map and map:FindFirstChild("CakeLoaf")
        local startedAt = tick()
        local mainPart
        local clickDetector
        repeat
            runService.Heartbeat:Wait()
            local mirror = cakeLoaf and cakeLoaf:FindFirstChild("BigMirror")
            mainPart = mirror and mirror:FindFirstChild("Main")
            clickDetector = mirror and mirror:FindFirstChildWhichIsA("ClickDetector", true)
        until mainPart or clickDetector or tick() - startedAt >= 5
        if not mainPart and not clickDetector then
            return false
        end

        local interacting = true
        local featureGeneration = runtime.featureGeneration
        local function interact()
            if clickDetector then
                fireclickdetector(clickDetector)
            end
            if mainPart and runtime.rootPart then
                firetouchinterest(runtime.rootPart, mainPart, 0)
                runService.Heartbeat:Wait()
                runService.Heartbeat:Wait()
                firetouchinterest(runtime.rootPart, mainPart, 1)
            end
        end
        task.spawn(function()
            while interacting
                and runtime.running
                and runtime.enabled
                and runtime.featureGeneration == featureGeneration
                and queueOwns(queueLabel)
                and runtime.rootPart
                and runtime.humanoid
                and runtime.humanoid.Health > 0
            do
                pcall(interact)
                task.wait(0.4)
            end
        end)

        local monitorStartedAt = tick()
        local lastPosition = runtime.rootPart.Position
        local teleported = false
        while tick() - monitorStartedAt < 3 do
            runService.Heartbeat:Wait()
            if not runtime.rootPart then
                break
            end
            if (runtime.rootPart.Position - lastPosition).Magnitude < 8 then
                lastPosition = runtime.rootPart.Position
            else
                teleported = true
                break
            end
        end
        interacting = false
        return teleported
    end

    function API.ShouldCancelTP(destination, queueLabel, bossName, trackedObjectKey)
        if not runtime.rootPart then
            return true
        end
        if destination.Position.Y + 10 < 0 then
            return true
        end
        if queueLabel ~= nil and (runtime.queue:empty() or runtime.queue:top() ~= queueLabel) then
            return true
        end
        if bossName ~= nil and API.GetBossCFrame(bossName) == "undefined" then
            return true
        end
        if trackedObjectKey ~= nil and not runtime.trackedObjects[trackedObjectKey] then
            return true
        end
        return false
    end

    local function refreshTPCharacter()
        runtime.humanoid = LocalPlayer.Character:WaitForChild("Humanoid", 1)
        runtime.rootPart = LocalPlayer.Character:WaitForChild("HumanoidRootPart", 1)
    end

    local function temporarilySuppressWhirlPoolEntrance(requestIsland)
        if requestIsland ~= "Whirl Pool" then
            return
        end

        local map = Services.Workspace:FindFirstChild("Map")
        local teleportSpawn = map and map:FindFirstChild("TeleportSpawn")
        local entrance = teleportSpawn and teleportSpawn:FindFirstChild("Entrance")
        if not entrance or not entrance:IsA("BasePart") then
            return
        end

        local guard = runtime.whirlPoolEntranceTouchGuard
        if not guard or guard.entrance ~= entrance then
            guard = {
                entrance = entrance,
                originalCanTouch = entrance.CanTouch,
                generation = 0,
            }
            runtime.whirlPoolEntranceTouchGuard = guard
        end

        guard.generation += 1
        local generation = guard.generation
        entrance.CanTouch = false
        task.delay(8, function()
            if runtime.whirlPoolEntranceTouchGuard ~= guard
                or guard.generation ~= generation
            then
                return
            end
            if entrance.Parent then
                entrance.CanTouch = guard.originalCanTouch
            end
            runtime.whirlPoolEntranceTouchGuard = nil
        end)
    end

    -- Diem den khi bam theo mot model. Quai co HumanoidRootPart va phai dung
    -- cao hon 30 studs; trai roi KHONG co HumanoidRootPart - truoc day cho nay
    -- tra ve nil roi StopTween ngay, nen Get Fruits dung im khong bao gio bay.
    local function trackedTargetCFrame(model)
        if model == nil or model.Parent == nil then
            return nil
        end
        local root = model:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            return root.CFrame * CFrame.new(0, 30, 0)
        end
        local part = model:FindFirstChildWhichIsA("BasePart", true)
        if part == nil then
            return nil
        end
        return part.CFrame
    end

    -- Diem hoi sinh gan mot vi tri nhat.
    local function nearestTeamSpawnTo(position)
        local team = LocalPlayer.Team
        local worldOrigin = Services.Workspace:FindFirstChild("_WorldOrigin")
        local playerSpawns = worldOrigin and worldOrigin:FindFirstChild("PlayerSpawns")
        local teamSpawns = team and playerSpawns and playerSpawns:FindFirstChild(team.Name)
        if not teamSpawns then
            return nil, math.huge
        end
        local best, bestDistance = nil, math.huge
        for _, spawn in ipairs(teamSpawns:GetChildren()) do
            local ok, pivot = pcall(function()
                return spawn:GetPivot()
            end)
            if ok and pivot ~= nil then
                local gap = (pivot.Position - position).Magnitude
                if gap < bestDistance then
                    best, bestDistance = spawn, gap
                end
            end
        end
        return best, bestDistance
    end

    -- Toi dao nao thi CHIEM luon diem hoi sinh cua dao do. "SetSpawnPoint"
    -- khong co tham so: server tu quyet dinh theo vi tri that cua nhan vat,
    -- nen khong the gian lan bang mot cu nhay bi tu choi.
    local function confirmSpawnPointAtCurrentIsland()
        if not runtime.rootPart
            or not runtime.commF
            or (API.RaidMapActive and API.RaidMapActive())
        then
            return false
        end
        local data = LocalPlayer:FindFirstChild("Data")
        local lastSpawnPoint = data and data:FindFirstChild("LastSpawnPoint")
        if not lastSpawnPoint then
            return false
        end
        local nearest, gap = nearestTeamSpawnTo(runtime.rootPart.Position)
        if not nearest or gap > 2500 or lastSpawnPoint.Value == nearest.Name then
            return false
        end
        runtime.spawnConfirmAt = runtime.spawnConfirmAt or {}
        if tick() - (runtime.spawnConfirmAt[nearest.Name] or 0) < 20 then
            return false
        end
        runtime.spawnConfirmAt[nearest.Name] = tick()
        local ok, result = pcall(function()
            return runtime.commF:InvokeServer("SetSpawnPoint")
        end)
        if not ok or result == -1 or result == 0 then
            return false
        end
        local deadline = tick() + 1
        repeat
            task.wait(0.1)
        until lastSpawnPoint.Value == nearest.Name or tick() >= deadline
        return lastSpawnPoint.Value == nearest.Name
    end

    function API.TP(destination, queueLabel, shouldNotBypass, bossName, trackedObjectKey, targetModel)
        shouldNotBypass = shouldNotBypass or API.ShouldNotBypassTP()
        local lastDestinationPosition = nil
        local hopRestUntil = 0
        local closestDistance = nil
        local rollbacks = 0
        local hopsPlayed = 0
        -- stepHoldFrame = cho phai giu khi tween xong, de khong bi roi.
        local stepDir = Vector3.new(0, 1, 0)
        local stepHoldFrame = nil
        -- Toi da 1 lan "bay veo qua roi reset" cho moi chuyen di.
        local spawnShortcutUsed = false
        local islandHops = 0
        -- requestEntrance la cong hai chieu. Trong cung mot chuyen TP, goi lai
        -- cung cong sau khi da qua se day nhan vat nguoc ve diem cu; neu cong
        -- khong nhan ma lap lai moi vong thi worker cung ket tai day mai mai.
        local attemptedEntrances = {}

        while true do
            task.wait(0.01)
            if not runtime.humanoid or not runtime.rootPart then
                pcall(refreshTPCharacter)
            end
            if targetModel then
                local targetFrame = trackedTargetCFrame(targetModel)
                if targetFrame == nil then
                    API.StopTween()
                    return
                end
                destination = targetFrame
            end
            if API.ShouldCancelTP(destination, queueLabel, bossName, trackedObjectKey) then
                API.StopTween()
                return
            end
            if not runtime.humanoid or not runtime.rootPart then
                API.StopTween()
                return
            end

            if runtime.humanoid.Health <= 0 then
                if runtime.cakePrinceDoughKing == true then
                    runtime.cakePrinceFailed = true
                    return
                end
                repeat
                    task.wait(1)
                until runtime.rootPart
                    and runtime.humanoid
                    and runtime.humanoid.Health > 0
                API.RemoveVelocity()
            end
            -- BodyVelocity phai THAO RA trong luc tween cam rootPart. De no gan
            -- vao la hai thu cung ghi mot vat the moi frame -> server dut ve.
            -- Do la ly do bay bi giat; thao ra thi bay muot, khong bi keo lai.
            API.RemoveVelocity()
            if runtime.humanoid.Sit == true then
                runtime.humanoid.Sit = false
                runtime.humanoid.Jump = true
            end

            local distance = (destination.Position - runtime.rootPart.Position).Magnitude

            -- ============ BAY VEO SANG DAO KHAC ============
            -- Nhay thang toi dao gan dich nhat roi reset de hoi sinh tai do.
            -- Day la co che di dao nhanh; thieu no la moi chuyen deu phai bay
            -- tay tung hop 140 studs.
            if islandHops < 3
                and not shouldNotBypass
                and distance > 1500
                and runtime.cakePrinceDoughKing ~= true
                and not (API.HasEntranceFor and API.HasEntranceFor(destination))
                and not (API.RaidMapActive and API.RaidMapActive())
            then
                local gapBefore = distance
                if API.ResetToIsland(destination) then
                    islandHops += 1
                    lastDestinationPosition = nil
                    hopRestUntil = 0
                    if runtime.rootPart == nil
                        or (destination.Position - runtime.rootPart.Position).Magnitude
                            >= gapBefore - 100
                    then
                        islandHops = 3
                    end
                    continue
                end
                islandHops = 3
            end

            -- ============ BAY VEO QUA DAO ROI RESET ============
            -- Khong nhay CFrame, khong pha Head. Dat diem hoi sinh bang
            -- SetSpawnPoint (server tu xac nhan theo vi tri that), doi server
            -- bao da ghi dung dao gan DICH nhat, roi moi chet -> hoi sinh ngay
            -- canh dich, chi con doan ngan de bay.
            --
            -- CO CONG THI DUNG CONG, KHONG RESET. Khoi cong nam DUOI khoi nay
            -- nen truoc day reset luon an truoc - do la ly do Sky 1 / Sky 2 /
            -- Fishman khong bao gio di bang cong ma cu chet reset. Cong la tuc
            -- thi va khong ton mang; reset ton mot mang moi chang.
            if not spawnShortcutUsed
                and not shouldNotBypass
                and not (API.HasEntranceFor and API.HasEntranceFor(destination))
                and distance > 150
                and runtime.commF ~= nil
                and not (API.RaidMapActive and API.RaidMapActive())
            then
                local targetSpawn, targetGap = nearestTeamSpawnTo(destination.Position)
                local targetPivot = nil
                if targetSpawn ~= nil then
                    local ok, pivot = pcall(function()
                        return targetSpawn:GetPivot()
                    end)
                    targetPivot = ok and pivot or nil
                end
                if targetSpawn ~= nil
                    and targetPivot ~= nil
                    -- Dao do phai that su sat dich, minh phai dang dung gan no,
                    -- va reset phai rut ngan duong that su.
                    and targetGap <= 2500
                    and (targetPivot.Position - runtime.rootPart.Position).Magnitude <= 900
                    and targetGap + 75 < distance
                then
                    runtime.spawnShortcutAt = runtime.spawnShortcutAt or {}
                    if tick() - (runtime.spawnShortcutAt[targetSpawn.Name] or 0) >= 60 then
                        spawnShortcutUsed = true
                        runtime.spawnShortcutAt[targetSpawn.Name] = tick()
                        local data = LocalPlayer:FindFirstChild("Data")
                        local lastSpawnPoint = data and data:FindFirstChild("LastSpawnPoint")
                        if lastSpawnPoint ~= nil
                            and lastSpawnPoint.Value ~= targetSpawn.Name
                        then
                            pcall(function()
                                runtime.commF:InvokeServer("SetSpawnPoint")
                            end)
                            local confirmDeadline = tick() + 1
                            repeat
                                task.wait(0.1)
                            until lastSpawnPoint.Value == targetSpawn.Name
                                or tick() >= confirmDeadline
                        end
                        -- CHI chet khi server DA xac nhan dung dao. Chet ma
                        -- chua xac nhan la hoi sinh lai cho cu, mat cong.
                        if lastSpawnPoint ~= nil
                            and lastSpawnPoint.Value == targetSpawn.Name
                        then
                            local oldCharacter = LocalPlayer.Character
                            API.CancelTween()
                            API.RemoveVelocity()
                            print(("fly | da xac nhan spawn %s - reset de vao dao nhanh")
                                :format(targetSpawn.Name))
                            pcall(function()
                                runtime.humanoid.Health = 0
                            end)
                            local respawnDeadline = tick() + 12
                            repeat
                                task.wait(0.25)
                                pcall(refreshTPCharacter)
                            until (LocalPlayer.Character ~= oldCharacter
                                    and runtime.humanoid ~= nil
                                    and runtime.rootPart ~= nil
                                    and runtime.humanoid.Health > 0)
                                or tick() >= respawnDeadline
                            if LocalPlayer.Character == oldCharacter
                                or runtime.humanoid == nil
                                or runtime.rootPart == nil
                                or runtime.humanoid.Health <= 0
                            then
                                API.StopTween()
                                return
                            end
                            lastDestinationPosition = nil
                            hopRestUntil = 0
                            continue
                        end
                    end
                end
            end

            if runtime.cakePrinceDoughKing == true and distance >= 1000 then
                runtime.cakePrinceFailed = true
                return
            end
            if distance > 100 then
                local indraDefeated = runtime.unlockables and runtime.unlockables.DefeatedIndraTrueForm
                if indraDefeated or not table.find(XeroQuestData.PlaceIds[3], game.PlaceId) then
                    local requestIsland = API.GetNearestRequestIsland(destination)
                    if requestIsland ~= nil and not attemptedEntrances[requestIsland] then
                        -- Mot block da co san 3 lan thu. Danh dau ngay de du thanh
                        -- cong hay that bai, vong TP sau van bay tiep thay vi dung
                        -- yen spam cung mot cong vo han.
                        attemptedEntrances[requestIsland] = true
                        API.CancelTween()
                        -- Cong 2 CHIEU: ban them mot phat sau khi da qua se day
                        -- nguoc tro lai. Ban 1 lan roi NHIN, khong ban lien tuc.
                        -- ============ FIX CONG SKY / FISHMAN ============
                        -- THU CA HAI TOA DO: gia tri trong bang truoc (diem dap
                        -- xuong), khong an thi lay toa do cua CHINH doi tuong
                        -- cong trong map. Sky Area 1 trong bang cach cong that
                        -- 1350 studs nen mot minh no co the khong bao gio an.
                        -- Tu sua theo ket qua that chu khong doan.
                        local candidates = API.EntranceGateList ~= nil
                            and API.EntranceGateList(requestIsland)
                            or { runtime.requestIslands[requestIsland].Position }
                        local entranceFrom = runtime.rootPart and runtime.rootPart.Position
                        local entranceDone = false
                        for _, entrancePos in ipairs(candidates) do
                            for _ = 1, 2 do
                                pcall(function()
                                    runtime.commF:InvokeServer("requestEntrance", entrancePos)
                                end)
                                local settleUntil = tick() + 1.5
                                repeat
                                    task.wait(0.1)
                                    if runtime.rootPart then
                                        local here = runtime.rootPart.Position
                                        -- Toi noi, HOAC da bi day di rat xa = cong an
                                        if (entrancePos - here).Magnitude <= 30
                                            or (entranceFrom ~= nil
                                                and (here - entranceFrom).Magnitude >= 200)
                                        then
                                            entranceDone = true
                                        end
                                    end
                                until entranceDone or not runtime.rootPart or tick() >= settleUntil
                                if entranceDone or not runtime.rootPart then
                                    break
                                end
                            end
                            if entranceDone or not runtime.rootPart then
                                break
                            end
                        end
                        -- ============ FIX CONG SKY / FISHMAN ============
                        -- DUONG 2: CHAM THANG VAO PART CUA. Khong phu thuoc
                        -- toa do gui len server nen con dung khi game doi cho
                        -- cua. Chi lam khi ban remote da khong an.
                        if not entranceDone and runtime.rootPart ~= nil then
                            local part = API.EntrancePart ~= nil
                                and API.EntrancePart(requestIsland) or nil
                            if part ~= nil then
                                pcall(function()
                                    if firetouchinterest ~= nil then
                                        firetouchinterest(runtime.rootPart, part, 0)
                                        task.wait(0.06)
                                        firetouchinterest(runtime.rootPart, part, 1)
                                    end
                                    for _, node in ipairs(part:GetDescendants()) do
                                        if node:IsA("ProximityPrompt")
                                            and fireproximityprompt ~= nil
                                        then
                                            pcall(fireproximityprompt, node, 0)
                                        elseif node:IsA("ClickDetector")
                                            and fireclickdetector ~= nil
                                        then
                                            pcall(fireclickdetector, node)
                                        end
                                    end
                                end)
                                local settleUntil = tick() + 1.5
                                repeat
                                    task.wait(0.1)
                                    if runtime.rootPart ~= nil
                                        and entranceFrom ~= nil
                                        and (runtime.rootPart.Position - entranceFrom).Magnitude >= 200
                                    then
                                        entranceDone = true
                                    end
                                until entranceDone or not runtime.rootPart or tick() >= settleUntil
                            end
                        end
                        temporarilySuppressWhirlPoolEntrance(requestIsland)
                        task.wait(0.5)
                        if runtime.rootPart then
                            distance = (destination.Position - runtime.rootPart.Position).Magnitude
                        end
                    end
                end

                -- Bo snap truc Y: doi CFrame 1 frame la teleport, server dut ve ngay.
                -- De hop bay lo do cao luon.
                local teamSpawns = Services.Workspace._WorldOrigin.PlayerSpawns[LocalPlayer.Team.Name]
                local lastSpawn = teamSpawns[LocalPlayer.Data.LastSpawnPoint.Value]
                if not shouldNotBypass
                    and not runtime.jumpPathDisabled
                    and runtime.longDistanceFailures <= 3
                    and distance > 4000
                    and lastSpawn
                then
                    local jumpPath = API.GetJumpPath(destination, lastSpawn.WorldPivot)
                    runtime.jumpPathActive = true
                    if runtime.cakePrinceDoughKing == true and distance >= 1000 then
                        runtime.cakePrinceFailed = true
                        return
                    end

                    for _, step in ipairs(jumpPath) do
                        API.CancelTween()
                        -- Duoi 10000 studs: teleport thang toi dao roi reset de hoi sinh tai do
                        if API.IslandTeleportReset(
                            step.island.WorldPivot,
                            step.island.Name,
                            step.region
                        ) then
                            continue
                        end
                        -- Chang nay khong reset duoc thi BO QUA, bay tiep. Doan
                        -- cu o day pha Head roi SetPrimaryPartCFrame lien tuc
                        -- moi giay - dung kieu nhay 1 frame ma server dut ve.
                        runtime.badResetIslands[step.island.Name] = true
                        runtime.longDistanceFailures += 1
                        if API.ShouldCancelTP(destination, queueLabel, bossName, trackedObjectKey)
                            or not runtime.jumpPathActive
                        then
                            API.StopTween()
                            return
                        end
                    end
                    runtime.jumpPathActive = false
                    if runtime.rootPart then
                        distance = (destination.Position - runtime.rootPart.Position).Magnitude
                    end
                end
            end

            API.NoClip("on")
            runtime.humanoid.PlatformStand = true
            if runtime.cakePrinceDoughKing == true and distance >= 1000 then
                runtime.cakePrinceFailed = true
                return
            end
            -- Bay tung hop ngan roi nghi, thay vi 1 tween dai bi server tu choi
            local hopRested = tick() >= hopRestUntil
            if hopRested
                and (lastDestinationPosition == nil
                    or (lastDestinationPosition - destination.Position).Magnitude > 5
                    or not runtime.currentTween
                    or runtime.currentTween.PlaybackState ~= Enum.PlaybackState.Playing)
            then
                if runtime.cakePrinceDoughKing == true and distance >= 1000 then
                    runtime.cakePrinceFailed = true
                    return
                end
                API.CancelTween()
                lastDestinationPosition = destination.Position

                local origin = runtime.rootPart.Position
                distance = (destination.Position - origin).Magnitude

                -- Bay THANG toi dich, cat thanh tung hop ngan. Moi lan bi dut
                -- ve thi backoff tang: hop ngan lai va cham lai cho den khi
                -- server chiu nhan, bay sach mot chuyen thi tra ve nhu cu.
                local backoff = math.min(math.max(rollbacks, runtime.flyBackoff or 0), 4)
                local ease = 1 / (1 + backoff * 0.25)
                local baseStep = math.clamp(runtime.flyStep or 140, 80, 160)
                local flyStep = math.clamp(
                    baseStep - (runtime.flyStepPenalty or 0),
                    math.min(100, baseStep),
                    20000
                )
                local flySpeed = math.clamp((runtime.tpSpeed or 220) * ease, 60, 220)

                local goal = destination
                local goalDistance = distance
                stepDir = distance > 0.001
                    and (destination.Position - origin).Unit
                    or Vector3.new(0, 1, 0)
                if distance > flyStep then
                    goalDistance = flyStep
                    goal = CFrame.lookAt(
                        origin + stepDir * flyStep,
                        destination.Position
                    )
                end
                stepHoldFrame = goal

                local hopSeconds = goalDistance / flySpeed
                runtime.currentTween = Services.TweenService:Create(
                    runtime.rootPart,
                    TweenInfo.new(hopSeconds, Enum.EasingStyle.Linear),
                    { CFrame = goal }
                )
                runtime.currentTween:Play()
                hopsPlayed += 1
                hopRestUntil = tick() + hopSeconds
                    + (runtime.flyPause or 0) * (1 + backoff * 0.5)
            end

            -- GIU CHO SAU MOI BUOC. Tween xong la het cai giu nhan vat: NoClip
            -- da tat CanCollide va PlatformStand dang bat, nen no roi thang
            -- xuong trong quang nghi giua hai buoc. Ghi lai CFrame va khoa van
            -- toc moi vong cho den luc buoc ke tiep bat dau.
            if stepHoldFrame ~= nil
                and (runtime.currentTween == nil
                    or runtime.currentTween.PlaybackState ~= Enum.PlaybackState.Playing)
            then
                pcall(function()
                    runtime.rootPart.CFrame = stepHoldFrame
                    runtime.rootPart.AssemblyLinearVelocity = Vector3.zero
                end)
            end

            distance = (destination.Position - runtime.rootPart.Position).Magnitude
            if distance <= 30 then
                -- Toi noi thi chiem luon diem hoi sinh cua dao nay.
                pcall(confirmSpawnPointAtCurrentIsland)
                runtime.longDistanceFailures = 0
                -- Bay sach ca chuyen = server chiu tam nay: tra backoff va buoc
                -- ve nhu cu, khong de mot server te keo cham cho ca phien.
                if rollbacks == 0 then
                    if (runtime.flyBackoff or 0) > 0 then
                        runtime.flyBackoff -= 1
                    end
                    if hopsPlayed > 0 then
                        runtime.flyRollbackRun = 0
                        runtime.flyStepPenalty = 0
                    end
                end
                API.AddVelocity()
                return
            end

            if closestDistance == nil or distance < closestDistance then
                closestDistance = distance
            elseif distance - closestDistance > 60 then
                -- BI DUT VE: tween cu dang noi suy tu cho KHONG con dung nua,
                -- cang bay cang bi keo lai. Huy tween, giu yen tai cho SERVER
                -- vua dat minh, roi bat lai tu vi tri that. Cham lai va rut
                -- ngan buoc de server chiu nhan.
                rollbacks += 1
                runtime.flyBackoff = math.min((runtime.flyBackoff or 0) + 1, 4)
                local baseStep = math.clamp(runtime.flyStep or 140, 80, 160)
                local floorStep = math.min(100, baseStep)
                runtime.flyRollbackRun = (runtime.flyRollbackRun or 0) + 1
                if runtime.flyRollbackRun >= 10 then
                    runtime.flyRollbackRun = 0
                    local penalty = runtime.flyStepPenalty or 0
                    if baseStep - penalty > floorStep then
                        runtime.flyStepPenalty =
                            math.min(penalty + 50, baseStep - floorStep)
                    end
                end
                API.CancelTween()
                lastDestinationPosition = nil
                -- Giu tai cho server vua keo ve, KHONG ghi lai diem cu: dung
                -- yen la thu duy nhat chua duoc mot lan dut ve.
                task.wait(0.6)
                if runtime.rootPart ~= nil then
                    stepHoldFrame = runtime.rootPart.CFrame
                    closestDistance =
                        (destination.Position - runtime.rootPart.Position).Magnitude
                else
                    stepHoldFrame = nil
                    closestDistance = nil
                end
                hopRestUntil = tick()
                    + (runtime.flyPause or 0) * (1 + runtime.flyBackoff * 0.5)
            end
        end
    end

    -- Bay 1 mach toi dich voi tpSpeed
    function API.StepFly(destination, queueLabel, targetModel)
        if not runtime.rootPart then
            return
        end
        if targetModel then
            local targetFrame = trackedTargetCFrame(targetModel)
            if targetFrame == nil then
                return
            end
            destination = targetFrame
        end
        API.TP(destination, queueLabel, false, nil, nil, targetModel)
