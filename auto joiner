            runtime.commF:InvokeServer("TalkTrevor", "2")
            runtime.commF:InvokeServer("TalkTrevor", "3")
            runtime.allowFruitStorage = true
            runtime.flamingoAccess = true
        end

        if runtime.queue:empty() or runtime.queue:top() ~= "Auto Farm Level" then
            API.StopTween()
            return
        end

        local check = runtime.commF:InvokeServer("ZQuestProgress", "Check")
        if check == nil then
            API.FarmBoss("Don Swan", "Auto Farm Level", true)
            return
        end

        if runtime.queue:empty() or runtime.queue:top() ~= "Auto Farm Level" then
            API.StopTween()
            return
        end

        runtime.progress.ZQuest = runtime.commF:InvokeServer("ZQuestProgress")
        local progress = runtime.progress.ZQuest
        if not progress then
            return
        end
        if progress.KilledIndraBoss then
            runtime.commF:InvokeServer("TravelZou")
            task.wait(5)
            return
        end

        -- Tim boss TRUOC. Co boss roi thi khong ban "Begin" nua - truoc day
        -- "Begin" ban moi vong danh gia (~100 lan/giay) ke ca khi boss da o day.
        local indra = nil
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if enemy.Name == "rip_indra"
                and enemy:FindFirstChild("HumanoidRootPart")
                and enemy:FindFirstChild("Humanoid")
            then
                indra = enemy
                break
            end
        end
        if indra == nil then
            -- Chua co boss: ban Begin, co gian cach.
            if tick() - (runtime.indraBeginAt or 0) > 5 then
                runtime.indraBeginAt = tick()
                setStatus("Auto Farm Level | Third Sea: trieu hoi rip_indra")
                pcall(function()
                    runtime.commF:InvokeServer("ZQuestProgress", "Begin")
                end)
            end
            return
        end

        do
            local enemy = indra
            if runtime.queue:empty() or runtime.queue:top() ~= "Auto Farm Level" then
                API.StopTween()
                return
            end
            do
                API.AddVelocity()
                task.wait(runtime.attackDelay)
                if runtime.humanoid.Health <= 0 then
                    return
                end
                local gap = (enemy.HumanoidRootPart.Position
                    - runtime.rootPart.Position).Magnitude
                if gap > 20000 then
                    return
                end
                if gap > 1000 then
                    -- Tham so 3 = true: khong reset (chet la mat quest ZQuest).
                    API.TP(
                        enemy.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0),
                        "Auto Farm Level",
                        true,
                        nil,
                        nil,
                        enemy
                    )
                    return
                end
                if runtime.queue:empty() or runtime.queue:top() ~= "Auto Farm Level" then
                    API.StopTween()
                    return
                end
                -- Chi ngoi lai khi boss troi that xa: ghi CFrame moi vong la
                -- nhay 1 frame, server dut ve ngay.
                if gap > 50 then
                    API.TP(
                        enemy.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0),
                        "Auto Farm Level",
                        true,
                        nil,
                        nil,
                        enemy
                    )
                end
                setSingleCombatTarget(enemy)

                local healthPercent = enemy.Humanoid.Health / enemy.Humanoid.MaxHealth * 100
                if runtime.useSwordAtMaxMastery
                    and (
                        healthPercent <= runtime.configs["Farm Mastery"]["Mastery Health (%)"]
                        or LocalPlayer.Data.Stats.Sword.Level.Value == 2800
                    )
                then
                    API.EquipWeapon("Sword")
                else
                    API.EquipWeapon(runtime.activeWeaponCategory)
                end
                API.Attack()
                healthPercent = enemy.Humanoid.Health / enemy.Humanoid.MaxHealth * 100
                if math.floor(healthPercent) < 50 then
                    task.wait(3)
                end
            end
        end
    end

