    -- Tra ve true khi vua tieu het ngan sach (goi la phai NGHI, khong hop nua).
    function API.Sea2KeyHopSpend(rest, budget)
        local saved = sea2KeySaved()
        saved.HopAt = os.time()
        saved.HopCount = (tonumber(saved.HopCount) or 0) + 1
        local exhausted = saved.HopCount > budget
        if exhausted then
            saved.HopCount = 0
            saved.HopStandDownUntil = os.time() + rest
        end
        pcall(writeMeleeSave)
        return exhausted
    end

    function API.Sea2KeyHopReset()
        local saved = sea2KeySaved()
        if (tonumber(saved.HopCount) or 0) == 0
            and (tonumber(saved.HopStandDownUntil) or 0) == 0
        then
            return
        end
        saved.HopCount = 0
        saved.HopStandDownUntil = 0
        pcall(writeMeleeSave)
    end

