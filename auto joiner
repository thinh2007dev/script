    -- Tra ve true khi DA ban lenh teleport, false khi bi chan hoac loi. Cac
    -- caller (nhat la san key sea 2) doc gia tri nay de fallback thay vi treo.
    function API.HopServer(cursor, httpOnly, forAdmin, reason)
        local allowed, policy = hopAllowed(reason, forAdmin)
        if not allowed then
            if tick() - (runtime.hopBlockSaidAt or 0) > 120 then
                runtime.hopBlockSaidAt = tick()
                print(("hop | bi chan boi '%s' (reason=%s)"):format(
                    tostring(policy), tostring(reason or "Normal")))
            end
            return false
        end
        -- CO PCALL. Truoc day `request(...)` va `JSONDecode(...)` de tran: HTTP
        -- loi / body rong la THROW ra ngoai, keo chet ca vong danh gia cua
        -- caller. Do la duong "hop loi -> treo".
        local cursorSuffix = cursor and ("&cursor=" .. cursor) or ""
        local httpOk, decoded = pcall(function()
            local response = request({
                Url = "https://games.roblox.com/v1/games/"
                    .. game.PlaceId
                    .. "/servers/Public?sortOrder=Asc&limit=100"
                    .. cursorSuffix,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
                    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
                },
            })
            return Services.HttpService:JSONDecode(response.Body)
        end)
        if not httpOk or type(decoded) ~= "table" then
            runtime.hopLastError = "server list loi"
            if tick() - (runtime.hopHttpSaidAt or 0) > 60 then
                runtime.hopHttpSaidAt = tick()
                warn(("hop | doc danh sach sever loi (reason=%s) - de caller"
                    .. " tu xu ly, khong treo"):format(tostring(reason or "Normal")))
            end
            return false
        end
        local nextCursor = decoded.nextPageCursor

        -- MOI LENH __ServerBrowser deu boc pcall: teleport bi tu choi / sever
        -- full / remote loi la throw, va throw o day keo chet vong danh gia.
        local fired = false
        local function tryTeleport(jobId)
            local ok = pcall(function()
                Services.ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", jobId)
            end)
            if ok then
                fired = true
                task.wait(5)
            end
            return ok
        end

        if not httpOnly then
            pcall(function()
                for page = 2, 100 do
                    for jobId, server in Services.ReplicatedStorage.__ServerBrowser:InvokeServer(page) do
                        if jobId ~= game.JobId and server.Count <= 8 then
                            tryTeleport(jobId)
                        end
                    end
                end
            end)
            return fired
        end

        if decoded.data then
            for index = #decoded.data, 1, -1 do
                local server = decoded.data[index]
                if server.id ~= game.JobId
                    and server.ping
                    and server.playing < server.maxPlayers
                    and server.ping < 300
                then
                    table.insert(runtime.serverCandidates, server.id)
                end
            end
            if #runtime.serverCandidates > 0 then
                pcall(function()
                    writefile(
                        "Xero Hub/" .. tostring(game.PlaceId) .. ".txt",
                        Services.HttpService:JSONEncode(runtime.serverCandidates)
                    )
                end)
                shuffleInPlace(runtime.serverCandidates)
                for _, jobId in runtime.serverCandidates do
                    tryTeleport(jobId)
                end
                return fired
            end
        elseif isfile("Xero Hub/" .. tostring(game.PlaceId) .. ".txt") then
            local cacheOk, cached = pcall(function()
                return Services.HttpService:JSONDecode(
                    readfile("Xero Hub/" .. tostring(game.PlaceId) .. ".txt")
                )
            end)
            if cacheOk and type(cached) == "table" then
                runtime.serverCandidates = cached
                shuffleInPlace(runtime.serverCandidates)
                for _, jobId in runtime.serverCandidates do
                    tryTeleport(jobId)
                end
            end
            return fired
        else
            -- Chuyen doi sever nay da qua cong roi, nen may lan goi lai de lat
            -- trang phai mang theo forAdmin, khong thi tu chan chinh minh.
            return API.HopServer(nil, nil, forAdmin, reason)
        end

        if nextCursor == nil or nextCursor == "" then
            return API.HopServer(nil, true, forAdmin, reason)
        else
            return API.HopServer(nextCursor, true, forAdmin, reason)
        end
    end

