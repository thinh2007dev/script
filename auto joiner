    function API.GetJumpPath(destination, origin)
        local output = {}
        local visited = {}
        local selectedSpawns = {}
        local currentPosition = origin and origin.Position or runtime.rootPart.Position
        local destinationPosition = destination.Position
        local spawns = Services.Workspace._WorldOrigin.PlayerSpawns[LocalPlayer.Team.Name]:GetChildren()
        -- Sea 2/3 co diem hoi sinh duoi nuoc va diem server tu choi. Nhay vao do
        -- la chet duoi / ket -> bo qua, tru khi dich den cung o duoi nuoc.
        local allowUnderwater = destinationPosition.Y < 0

        while true do
            local directDistance = (destinationPosition - currentPosition).Magnitude
            local nearestSpawn = nil
            local nearestDestinationDistance = directDistance
            for _, spawn in ipairs(spawns) do
                if not visited[spawn]
                    and not runtime.badResetIslands[spawn.Name]
                    and (allowUnderwater or spawn.WorldPivot.Position.Y > 5)
                then
                    local spawnPosition = spawn.WorldPivot.Position
                    local jumpDistance = (spawnPosition - currentPosition).Magnitude
                    local destinationDistance = (spawnPosition - destinationPosition).Magnitude
                    if jumpDistance <= 10000 and destinationDistance < nearestDestinationDistance then
                        nearestDestinationDistance = destinationDistance
                        nearestSpawn = spawn
                    end
                end
            end
            if not nearestSpawn then
                break
            end
            visited[nearestSpawn] = true
            table.insert(selectedSpawns, nearestSpawn)
            currentPosition = nearestSpawn.WorldPivot.Position
        end

        for _, spawn in ipairs(selectedSpawns) do
            table.insert(output, {
                island = spawn,
                region = API.GetNearestRegion(spawn.WorldPivot),
            })
        end
        return output
    end

