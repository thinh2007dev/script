    function API.ShootGun(enemy, weaponCategory)
        local weaponName = runtime.combatUtil:GetWeaponName(runtime.tools[weaponCategory])
        local weaponData = runtime.combatUtil:GetWeaponData(weaponName)
        local aimPosition = enemy.Head.Position
        local validator = runtime.gunValidator

        local state12 = debug.getupvalue(validator, 12)
        local state15 = debug.getupvalue(validator, 15)
        local state13 = debug.getupvalue(validator, 13)
        local state17 = debug.getupvalue(validator, 17)
        local state16 = debug.getupvalue(validator, 16)
        local state18 = debug.getupvalue(validator, 18)
        local state14 = debug.getupvalue(validator, 14)

        local product = state12 * state13
        local mixed = (state14 * state13 + state12 * state15) % state16
        local nextState = (mixed * state16 + product) % state17
        state14 = math.floor(nextState / state16)
        state12 = nextState - state14 * state16
        state18 += 1

        ReplicatedStorage.Remotes.Validator2:FireServer(
            math.floor(nextState / state17 * 16777215),
            state18
        )
        debug.setupvalue(validator, 14, state14)
        debug.setupvalue(validator, 12, state12)
        debug.setupvalue(validator, 18, state18)

        if weaponData.ShootType == "HitscanSingleShot" or weaponData.ShootType == "HitscanBurst" then
            runtime.shootGunEvent:FireServer(aimPosition, runtime.gunTargets)
        elseif weaponData.ShootType == "Projectile" then
            runtime.shootGunEvent:FireServer(aimPosition)
        else
            runtime.tools[weaponCategory].RemoteEvent:FireServer("TAP", aimPosition)
        end
        task.wait(0.1)
    end

