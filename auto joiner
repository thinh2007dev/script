            -- BossDropTargets KHONG co khoa ID moi nao, nen tra bang
            -- game.PlaceId luon ra nil -> `or {}` lam vong duoi khong bao gio
            -- chay, tuc ca job san do roi boss chet im lang.
            local targets = BossDropTargets[category][placeKey()]
                or BossDropTargets[category][game.PlaceId]
                or {}
            for itemName, target in pairs(targets) do
