    local function nextHopStreamState(state)
        return (state * 1103515 + 12345) % 4294967296
    end

    local function decodeHopServerKey(encryptedKey)
        if type(encryptedKey) ~= "string"
            or #encryptedKey == 0
            or #encryptedKey % 2 ~= 0
            or encryptedKey:find("[^%da-fA-F]")
        then
            return nil
        end

        local cipherBytes = {}
        for index = 1, #encryptedKey, 2 do
            local byte = tonumber(encryptedKey:sub(index, index + 1), 16)
            if byte == nil then
                return nil
            end
            cipherBytes[#cipherBytes + 1] = byte
        end
        if #cipherBytes == 0 then
            return nil
        end

        local state = (0x5F2A93C1 + #cipherBytes * 977) % 4294967296
        local characters = {}
        for index = #cipherBytes, 1, -1 do
            state = nextHopStreamState(state)
            local streamByte = math.floor(state / 65536) % 256
            characters[index] = string.char(
                (bit32.bxor(cipherBytes[index], streamByte) + index * 7) % 256
            )
        end

        return table.concat(characters)
    end

    local function splitJoinFields(value)
        local fields = {}
        local field = ""
        for index = 1, #value do
            local character = value:sub(index, index)
            if character == "|" then
                table.insert(fields, field)
                field = ""
            else
                field ..= character
            end
        end
        if field ~= "" then
            table.insert(fields, field)
        end
        return fields
    end

    function API.SubmitJoinTarget(text)
