    --
    -- BANG QUEST KHONG DUOC DUNG DE PHU DINH. Do bang xero_dump: nhan
    -- Container.QuestTitle.Title bi STALE (doc "DEFEAT 5 BANDITS (0/5)" tren acc
    -- lv1382 sea2) va Main.Quest.Visible = false ngay khi dang co quest. Bang
    -- chi xac nhan duoc "co quest", khong bao gio noi duoc "mat quest".
    -- Mat quest that chi co hai duong: CHET (deathCount) va qua han.
    --
    -- HAN 15 PHUT, khong phai 5. Farm sach mot bai roi dung cho spawn thi mot
    -- quest 8 con qua 5 phut la binh thuong; het han giua chung la nhan lai va
    -- RESET bo dem - dung cai "lau lau tu nhan lai khi vua farm xong bai quai".
    -- Han nay chi de go cho quest bi mat theo duong khac, khong phai de dem gio.
    -- ============ FIX CHET LA NHAN LAI QUEST ============
    -- BANG QUEST SONG. Do bang MCP tren acc lv376:
    --   TrackedQuestFrame.Frame.header.textLabel = "Defeat 8 Fishman Warriors"
    --   TrackedQuestFrame.Frame.description      = "Fishman Warrior"  <- TEN MOB,
    --                                               sach va SO IT, khong phai
    --                                               tieu de so nhieu
    --   TrackedQuestFrame.Frame.progress         = "0/8"
    -- Cung luc do Main.Quest.Container.QuestTitle.Title van ghi "DEFEAT 5
    -- BANDITS (0/5)" tu hoi acc con lv1, va Main.Quest.Visible = false - dung
    -- cai stale ma ghi chu duoi day canh bao. TrackedQuestFrame moi la bang
    -- song, va no co ca abandonQuestButton nen chi hien khi thuc su co quest.
    --
    -- Tra ve mobName, soDaLam, soCan. nil = khong doc duoc hoac khong co quest.
    function API.TrackedQuest()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local screen = playerGui ~= nil
            and playerGui:FindFirstChild("TrackedQuestFrame") or nil
        if screen == nil then
            return nil
        end
        local enabledOk, enabled = pcall(function()
            return screen.Enabled
        end)
        if enabledOk and enabled == false then
            return nil
        end
        local frame = screen:FindFirstChild("Frame")
        if frame == nil then
            return nil
        end
        local visibleOk, visible = pcall(function()
            return frame.Visible
        end)
        if visibleOk and visible == false then
            return nil
        end
        local mob = nil
        local description = frame:FindFirstChild("description")
        if description ~= nil then
            local ok, text = pcall(function()
                return description.Text
            end)
            if ok and type(text) == "string" and text ~= "" then
                mob = text
            end
        end
        if mob == nil then
            return nil
        end
        local done, total = nil, nil
        local progress = frame:FindFirstChild("progress")
        if progress ~= nil then
            local ok, text = pcall(function()
                return progress.Text
            end)
            if ok and type(text) == "string" then
                local a, b = string.match(text, "(%d+)%s*/%s*(%d+)")
                done, total = tonumber(a), tonumber(b)
            end
        end
        return mob, done, total
    end

    function API.QuestAlreadyTaken(key, mobName)
        local taken = runtime.questTaken
        if taken == nil then
            return false
        end
        -- Quest cu DA XONG thi phai nhan quest moi, khong duoc coi la con.
        if runtime.questCompletedTick ~= taken.stamp then
            return false
        end
        -- ============ FIX CHET LA NHAN LAI QUEST ============
        -- CHET KHONG CON TU DONG NGHIA LA MAT QUEST. Truoc day chi can
        -- deathCount doi la ket luan mat roi nhan lai, ma StartQuest RESET bo
        -- dem ve 0 - dung cai "chet mot cai la farm lai tu dau". Do tren acc
        -- that: deathCount = 24 ma questTaken.deaths = 15.
        --
        -- Gio HOI bang quest song. Chi dung de XAC NHAN QUEST CON, tuyet doi
        -- khong dung de ket luan MAT - doc khong ra thi roi ve cach cu.
        if taken.deaths ~= (runtime.deathCount or 0) then
            local wanted = mobName or taken.mob
            local trackedMob = API.TrackedQuest ~= nil and API.TrackedQuest() or nil
            if wanted ~= nil and trackedMob ~= nil and trackedMob == wanted then
                -- Quest SONG SOT qua lan chet: dong moc lai de khong phai doc
                -- bang moi vong, va KHONG nhan lai.
                taken.deaths = runtime.deathCount or 0
                return true
            end
            return false
        end
        if tick() - taken.at >= 900 then
            return false
        end
        if taken.key == tostring(key) then
            return true
        end
        return mobName ~= nil and taken.mob == mobName
    end

    function API.MarkQuestTaken(key, mobName)
        runtime.questTaken = {
            key = tostring(key),
            mob = mobName,
            at = tick(),
            stamp = runtime.questCompletedTick,
            deaths = runtime.deathCount or 0,
        }
    end

    -- Nhan quest chi can GUI LENH tai cho dang dung. Dung yen, ban 5 lan, ghi
    -- so ngay. So do CHI xoa khi server bao "QUEST COMPLETED!" (doi
    -- questCompletedTick) hoac qua 5 phut - nen chac chan xong quest cu roi
    -- moi nhan quest tiep.
    function API.SendStartQuest(questName, questNumber, mobName, attempts)
        local key = tostring(questName) .. "#" .. tostring(questNumber)
        if API.QuestAlreadyTaken(key, mobName) then
            return true
        end
        -- Chong ban don. TRA VE TRUE khi bi chot: day chi la "chua toi luc ban
        -- lai", KHONG phai "khong co quest". Tra ve false o day la ca ham
        -- AutoFarmLevel dung yen suot 5 giay moi 5 giay -> dung im hoan toan,
        -- dung cai ket o lv452.
        if tick() - (runtime.lastQuestStartedAt or 0) < 5 then
            return true
        end
        runtime.lastQuestStartedAt = tick()
        API.StopTween()

        -- MOT PHAT, ROI NHIN. Ban 5 phat cach nhau 0.2s la NPC chan spam va tra
        -- "Try again soon." cho ca 5 - dung cai chu do day man hinh. Ban mot
        -- lan, doi bang quest hien dung ten quai; chua duoc thi vong sau thu
        -- lai (da co chot 5 giay o tren).
        attempts = tonumber(attempts) or 1
        for _ = 1, attempts do
            pcall(function()
                runtime.commF:InvokeServer("StartQuest", questName, questNumber)
            end)
            local deadline = tick() + 2
            local active = false
            repeat
                task.wait(0.15)
                active = questTitleCoversMob(mobName)
            until active or tick() >= deadline
            if active then
                break
            end
        end

        -- LENH DA GUI THI GHI SO, khong phu thuoc bang.
        -- Truoc day bang khong hien ten quai thi dem 3 lan roi ban lai - nhung
        -- nhan quest bi stale nen "khong hien" khong co nghia la chua nhan. Ket
        -- qua la nhan roi van ban lai, moi lan ban la reset bo dem ve 0.
        API.MarkQuestTaken(key, mobName)
        print(("quest | da nhan %s - khong goi lai cho den khi xong"):format(key))
        return true
    end

    function API.FarmMob(mobNames, queueLabel, enforceQuest, questLevel, skipMastery)
        if not runtime.humanoid or not runtime.rootPart then
            return
        end
        if #mobNames < runtime.mobIndex then
            runtime.mobIndex = 1
        end

        local mobName = mobNames[runtime.mobIndex]
        local spotList = runtime.mobPositions[mobName]
        local destination = API.PickMobSpot(mobName, spotList)
        if destination == nil then
            runtime.mobIndex += 1
            return
        end
        -- MOT LAN MOI VONG, khong phai moi con quai. Truoc day nam trong vong
        -- lap enemy nen moi con la mot lenh StartQuest -> reset bo dem lien tuc.
        if enforceQuest and questLevel and questLevel < LocalPlayer.Data.Level.Value then
            local quest = API.GetQuest(questLevel)
            if quest and table.find(mobNames, quest.mob_name) then
                API.SendStartQuest(quest.quest_name, quest.quest_num, quest.mob_name)
            end
        end

        -- Ngoi GIUA dan, khong ngoi tren con dau tien tim thay -> danh trung
        -- ca bai chu khong chi vai con o mep bai.
        local packAnchor, packLead = API.MobPackAnchor(mobName)

        local found = false
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if enemy.Name == mobName then
                local enemyHumanoid = enemy:FindFirstChild("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    found = true
                end
            end
        end

        if found then
            runtime.mobWaitStartedAt = tick()
            runtime.mobSpotSince = runtime.mobSpotSince or tick()
            runtime.mobFarSince = nil
        else
            -- Y het farm lv: bay toi bai, dung yen cho spawn, 25 giay moi doi bai.
            setStatus(queueLabel .. " | Waiting mob")
            local travelGap = runtime.rootPart ~= nil
                and (destination.Position - runtime.rootPart.Position).Magnitude
                or 0
            -- ============ FIX DUNG CONG THAY VI RESET ============
            -- Cung loi nhu khoi cho quai o Auto Farm Level: chi duoc reset khi
            -- KHONG con rut ngan duoc khoang cach, chu khong phai cu xa la reset.
            if travelGap > 1500 then
                local best = runtime.mobFarBest
                if best == nil or travelGap < best - 150 then
                    runtime.mobFarBest = travelGap
                    runtime.mobFarSince = tick()
                else
                    runtime.mobFarSince = runtime.mobFarSince or tick()
                end
            else
                runtime.mobFarSince = nil
                runtime.mobFarBest = nil
            end
            if runtime.mobFarSince ~= nil
                and tick() - runtime.mobFarSince > 15
                and tick() - (runtime.mobResetAt or 0) > 30
            then
                runtime.mobFarSince = nil
                runtime.mobFarBest = nil
                runtime.mobResetAt = tick()
                API.ResetToIsland(destination)
            end
            API.StepFly(destination, queueLabel)
            API.AddVelocity()
            if not queueOwns(queueLabel) then
                API.StopTween()
                return
            end

            local now = tick()
            runtime.mobSpotSince = runtime.mobSpotSince or now
            local atSpot = runtime.rootPart ~= nil
                and (destination.Position - runtime.rootPart.Position).Magnitude <= 250
            if not atSpot then
                runtime.mobSpotSince = now
            elseif now - runtime.mobSpotSince > 25 then
                runtime.mobSpotSince = now
                API.AdvanceMobSpot(mobName, spotList)
                runtime.mobIndex += 1
            end
            if now - runtime.mobWaitStartedAt > 60 then
                runtime.mobWaitStartedAt = now
                API.HopServer(nil, true)
            end
            return
        end

        -- Quai co the vua spawn sau khi bay toi bai -> tinh lai giua dan.
        if packLead == nil or packLead.Parent == nil then
            packAnchor, packLead = API.MobPackAnchor(mobName)
        end

        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if not queueOwns(queueLabel) then
                API.StopTween()
                return
            end
            local enemyHumanoid = enemy:FindFirstChild("Humanoid")
            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
            local enemyHead = enemy:FindFirstChild("Head")
            if enemy.Name == mobName
                and (packLead == nil or enemy == packLead)
                and enemyHumanoid
                and enemyHumanoid.Health > 0
                and enemyRoot
                and enemyHead
            then
                setStatus(queueLabel .. " | Attacking mob")

                -- GIUA DAN, khong phai vi tri cua rieng con nay.
                local savedCFrame = packAnchor or enemyRoot.CFrame
                local attackStartedAt = tick()
                local originalPosition = savedCFrame.Position
                local questStamp = runtime.questCompletedTick

                while enemyHumanoid.Health > 0 do
                    task.wait(runtime.attackDelay)

                    -- Xong quest la DUNG NGAY, di nhan quest moi.
                    if enforceQuest ~= false
                        and runtime.questCompletedTick ~= questStamp
                    then
                        API.StopTween()
                        return
                    end

                    if not enemy.Parent
                        or enemyRoot.Parent ~= enemy
                        or enemyHead.Parent ~= enemy
                    then
                        break
                    end

                    if tick() - attackStartedAt >= 10 and enemyHumanoid.Health == enemyHumanoid.MaxHealth then
                        enemy:Destroy()
                        break
                    end
                    API.RefreshWeaponIfStuck(enemyHumanoid.Health)

                    if not runtime.humanoid or runtime.humanoid.Health <= 0 or not runtime.rootPart then
                        repeat
                            task.wait(1)
                        until runtime.humanoid and runtime.rootPart and runtime.humanoid.Health > 0
                        API.AddVelocity()
                    end

                    if (enemyRoot.Position - originalPosition).Magnitude > 200 then
                        break
                    end
                    -- ============ FIX BAY LEN TROI ============
                    -- Da co chot cho QUAI di xa 200 studs, nhung khong co chot
                    -- nao cho NHAN VAT. Hover danh quai chi cao 30 studs; cao
                    -- hon 300 la dang bay len khong dung lai duoc. Dat thang ve
                    -- diem farm, khoa van toc, roi thoat de danh gia lai.
                    if runtime.rootPart.Position.Y - originalPosition.Y > 300 then
                        API.StopTween()
                        pcall(function()
                            runtime.rootPart.CFrame = savedCFrame + Vector3.new(0, 30, 0)
                            runtime.rootPart.AssemblyLinearVelocity = Vector3.zero
                        end)
                        warn("farm | nhan vat bay len qua cao - keo lai diem farm")
                        break
                    end
                    -- Bam vao giua dan, KHONG chay theo con dang bo chay.
                    -- 30 studs nhu cu: 10 la dung sat quai nen bi danh trung.
                    local farmSpot = savedCFrame + Vector3.new(0, 30, 0)
                    if (farmSpot.Position - runtime.rootPart.Position).Magnitude > 50 then
                        API.StepFly(farmSpot, queueLabel)
                        API.AddVelocity()
                    end

                    if not queueOwns(queueLabel) then
                        API.StopTween()
                        return
                    end

                    enemyRoot.CFrame = savedCFrame
                    API.BringMob(savedCFrame, enemy.Name, false, enemy)
                    table.insert(runtime.hitTargets, 1, { enemy, enemyHead })
                    table.insert(runtime.gunTargets, 1, enemyHead)

                    local masteryConfig = runtime.configs["Farm Mastery"]
                    local healthPercent = enemyHumanoid.Health / enemyHumanoid.MaxHealth * 100
                    if not skipMastery
                        and masteryConfig.Enable
                        and runtime.masteryCategory
                        and healthPercent <= masteryConfig["Mastery Health (%)"]
                    then
                        API.EquipWeapon(runtime.masteryCategory)
                        API.FarmMastery(enemy, savedCFrame, runtime.masteryCategory)
                    else
                        if runtime.useSwordAtMaxMastery
                            and (
                                healthPercent <= masteryConfig["Mastery Health (%)"]
                                or LocalPlayer.Data.Stats.Sword.Level.Value == 2800
                            )
                        then
                            API.EquipWeapon("Sword")
                        else
                            API.EquipWeapon(runtime.activeWeaponCategory)
                        end
                        API.Attack()
                    end
                end
            end
        end

        -- CHI nhay bai khi bai nay da sach. Con mot con song la o lai danh tiep,
        -- khong xoay sang ten quai khac giua chung.
        local alive = false
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if enemy.Name == mobName then
                local enemyHumanoid = enemy:FindFirstChild("Humanoid")
                if enemyHumanoid and enemyHumanoid.Health > 0 then
                    alive = true
                    break
                end
            end
        end
        if not alive then
            runtime.mobSpotSince = tick()
            runtime.mobIndex += 1
        end
    end

    local function loadBossAnimationCache(fileName, bossName)
        local cache = {}
        if isfile and isfile(fileName) then
            pcall(function()
                local decoded = Services.HttpService:JSONDecode(readfile(fileName))
                if decoded and decoded[bossName] then
                    cache = decoded[bossName]
                end
            end)
        end
        return cache
    end

    local function makeBossAnimationCacheSaver(fileName, bossName, animationCache)
        return function()
            if not writefile then
                return
            end
            pcall(function()
                local allBosses = {}
                if isfile and isfile(fileName) then
                    allBosses = Services.HttpService:JSONDecode(readfile(fileName)) or {}
                end
                allBosses[bossName] = animationCache
                writefile(fileName, Services.HttpService:JSONEncode(allBosses))
            end)
        end
    end

    function API.FarmBoss(bossName, queueLabel, hopIfMissing, eliteQuest, skipQuest)
        runtime.cakePrinceDoughKing = false
        runtime.cakePrinceFailed = false
        if not runtime.humanoid or not runtime.rootPart then
            return
        end

        local bossConnectionScope
        local function finishBossFarm()
            closeFeatureConnectionScope(bossConnectionScope)
            bossConnectionScope = nil
            runtime.vipBossBusy = false
            runtime.bossFarmBusy = false
            if queueLabel == "Vip Boss" then
                API.LoadProgress()
            end
        end

        local bossCFrame = API.GetBossCFrame(bossName)
        if bossCFrame == "undefined" then
            if hopIfMissing == true then
                API.HopServer(nil, true)
            end
            finishBossFarm()
            return
        end

        setStatus(queueLabel .. " | " .. bossName)
        if eliteQuest == true then
            -- Quest elite chi la them diem, khong phai dieu kien de danh: gui
            -- lenh tai cho, khong bay ve NPC.
            if not API.QuestAlreadyTaken("EliteHunter#1", bossName) then
                API.MarkQuestTaken("EliteHunter#1", bossName)
                pcall(function()
                    runtime.commF:InvokeServer("EliteHunter")
                end)
            end
        end

        local isCakeBoss = bossName == "Cake Prince" or bossName == "Dough King"
        if isCakeBoss and (runtime.rootPart.Position - bossCFrame.Position).Magnitude >= 1000 then
            API.TPMirrorPortal(queueLabel)
            runtime.cakePrinceDoughKing = true
            API.AddVelocity()
        else
            if isCakeBoss then
                runtime.cakePrinceDoughKing = true
            end
            API.TP(bossCFrame * CFrame.new(0, 30, 0), queueLabel, false, bossName)
            API.AddVelocity()
        end
        if runtime.cakePrinceFailed == true then
            runtime.cakePrinceFailed = false
            runtime.cakePrinceDoughKing = false
            closeFeatureConnectionScope(bossConnectionScope)
            return
        end

        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if not queueOwns(queueLabel) or API.GetBossCFrame(bossName) == "undefined" then
                runtime.cakePrinceDoughKing = false
                API.StopTween()
                return
            end

            local enemyHumanoid = enemy:FindFirstChild("Humanoid")
            if enemy.Name == bossName and enemyHumanoid and enemyHumanoid.Health > 0 then
                if not skipQuest and not eliteQuest then
                    local displayedLevel = tonumber(enemyHumanoid.DisplayName:match("%d+"))
                    if displayedLevel and displayedLevel <= LocalPlayer.Data.Level.Value then
                        local quest = API.GetBossQuest(displayedLevel)
                        if quest and quest.boss_name == enemy.Name then
                            API.SendStartQuest(
                                quest.quest_name,
                                quest.quest_num,
                                quest.boss_name
                            )
                        end
                    end
                end

                local dodging = false
                local animationPlays = 0
                local currentAnimationId = nil
                local animationStartedAt = tick()
                local previousHealth = runtime.humanoid.Health
                closeFeatureConnectionScope(bossConnectionScope)
                bossConnectionScope = beginFeatureConnectionScope("FarmBoss")
                local cacheFile = "Xero_Boss_Anim_Cache.json"
                local animationCache = loadBossAnimationCache(cacheFile, bossName)
                local saveAnimationCache = makeBossAnimationCacheSaver(cacheFile, bossName, animationCache)

                local function onHealthChanged()
                    local currentHealth = runtime.humanoid.Health
                    if currentHealth < previousHealth then
                        local damage = previousHealth - currentHealth
                        local inCombat = runtime.humanoid.Parent
                            and runtime.humanoid.Parent:GetAttribute("InCombat") == true
                        local elapsed = tick() - animationStartedAt
                        if not inCombat and elapsed < 8 and currentAnimationId then
                            local row = animationCache[currentAnimationId]
                            if row then
                                row.damage_score += damage
                                row.safe_plays = 0
                                if damage > runtime.humanoid.MaxHealth * 0.05 then
                                    row.is_skill = true
                                    local learnedDuration = elapsed + 1.25
                                    local oldDuration = row.dodge_duration or 2
                                    if oldDuration < learnedDuration then
                                        row.dodge_duration = math.min(learnedDuration, 8)
                                    end
                                    saveAnimationCache()
                                end
                            end
                        end
                    end
                    previousHealth = currentHealth
                end

                local function onAnimationPlayed(track)
                    if track.Priority ~= Enum.AnimationPriority.Action
                        and track.Priority ~= Enum.AnimationPriority.Action2
                    then
                        return
                    end

                    local animationId = track.Animation.AnimationId:match("%d+")
                    if not animationId then
                        return
                    end
                    local now = tick()
                    currentAnimationId = animationId
                    animationStartedAt = now
                    animationPlays += 1
                    local duration = track.Length > 0 and track.Length or 1.5
                    local row = animationCache[animationId]
                    if not row then
                        row = {
                            plays = 0,
                            cooldown_samples = 0,
                            last_tick = now,
                            avg_cooldown = 0,
                            damage_score = 0,
                            is_skill = duration > 1.25,
                            dodge_duration = math.max(duration, 2),
                            safe_plays = 0,
                        }
                        animationCache[animationId] = row
                        saveAnimationCache()
                    end

                    if row.cooldown_samples == nil then
                        row.cooldown_samples = row.plays
                    end
                    if row.dodge_duration == nil then
                        row.dodge_duration = math.max(duration, 2)
                    end
                    if row.safe_plays == nil then
                        row.safe_plays = 0
                    end
                    if row.plays > 0 then
                        local cooldown = now - row.last_tick
                        if cooldown < 60 then
                            row.avg_cooldown = (
                                row.avg_cooldown * row.cooldown_samples + cooldown
                            ) / (row.cooldown_samples + 1)
                            row.cooldown_samples += 1
                        end
                    end

                    row.plays += 1
                    row.safe_plays += 1
                    row.last_tick = now
                    duration = math.max(duration, 2)
                    row.damage_score *= 0.98
                    if row.is_skill and row.safe_plays >= 5 and duration < row.dodge_duration then
                        row.dodge_duration = math.max(duration, row.dodge_duration - 0.25)
                        row.safe_plays = 0
                        saveAnimationCache()
                    end

                    local frequency = row.plays / animationPlays
                    if row.damage_score > runtime.humanoid.MaxHealth * 0.1 then
                        row.is_skill = true
                    elseif row.is_skill and row.damage_score < runtime.humanoid.MaxHealth * 0.05 then
                        if not (frequency < 0.2 and row.avg_cooldown > 2.5) then
                            row.is_skill = false
                            saveAnimationCache()
                        end
                    elseif not row.is_skill and frequency < 0.2 and row.avg_cooldown > 2.5 then
                        row.is_skill = true
                    end

                    if row.is_skill then
                        dodging = true
                        task.delay(math.max(row.dodge_duration, duration), function()
                            dodging = false
                        end)
                    end
                end

                connectFeatureSignal(
                    bossConnectionScope,
                    runtime.humanoid:GetPropertyChangedSignal("Health"),
                    onHealthChanged
                )
                local animator = enemyHumanoid:FindFirstChild("Animator")
                if animator then
                    connectFeatureSignal(bossConnectionScope, animator.AnimationPlayed, onAnimationPlayed)
                end
                connectFeatureSignal(bossConnectionScope, enemyHumanoid.ChildAdded, function(child)
                    if child:IsA("Animator") then
                        connectFeatureSignal(bossConnectionScope, child.AnimationPlayed, onAnimationPlayed)
                    end
                end)

                while enemyHumanoid.Health > 0 do
                    task.wait(0.01)
                    API.RefreshWeaponIfStuck(enemyHumanoid.Health)
                    local refreshedCharacter = false
                    while not runtime.humanoid or runtime.humanoid.Health <= 0 or not runtime.rootPart do
                        task.wait(1)
                        refreshedCharacter = true
                    end
                    API.AddVelocity()
                    if refreshedCharacter then
                        connectFeatureSignal(
                            bossConnectionScope,
                            runtime.humanoid:GetPropertyChangedSignal("Health"),
                            onHealthChanged
                        )
                    end

                    local bossGap =
                        (enemy.HumanoidRootPart.Position - runtime.rootPart.Position).Magnitude
                    if bossGap < 1000 then
                        runtime.cakePrinceFailed = false
                    end

                    -- Bi day ra khoi guong (chet hoac het gio): bay lai cong
                    -- vao lai. Truoc day cho nay chi dung im nen tu lan thu hai
                    -- la treo tren khong, khong bao gio ve cong nua.
                    if isCakeBoss and bossGap >= 1000 then
                        API.TPMirrorPortal(queueLabel)
                        runtime.cakePrinceDoughKing = true
                        API.AddVelocity()
                    elseif bossGap > 50
                        and not dodging
                        and runtime.cakePrinceFailed ~= true
                    then
                        API.TP(
                            enemy.HumanoidRootPart.CFrame + enemy.HumanoidRootPart.CFrame.UpVector * 30,
                            queueLabel,
                            false,
                            bossName
                        )
                        API.AddVelocity()
                    end

                    if dodging then
                        local back = -enemy.HumanoidRootPart.CFrame.LookVector
                        local position = enemy.HumanoidRootPart.Position + back * 40 + Vector3.new(0, 30, 0)
                        runtime.rootPart.CFrame = CFrame.lookAt(position, enemy.HumanoidRootPart.Position)
                    end

                    if not queueOwns(queueLabel) then
                        runtime.cakePrinceDoughKing = false
                        closeFeatureConnectionScope(bossConnectionScope)
                        bossConnectionScope = nil
                        saveAnimationCache()
                        API.StopTween()
                        return
                    end

                    runtime.hitTargets = { { enemy, enemy.Head } }
                    runtime.gunTargets = { enemy.Head }
                    if runtime.useSwordAtMaxMastery and LocalPlayer.Data.Stats.Sword.Level.Value == 2800 then
