            and ownsProgress("Wear", "Valkyrie Helm")
        then
            if runtime.raceV4State >= 0 and runtime.raceV4State < 4 then
                needsLever = true
            else
                local mystic = runtime.islands.MysticIsland
                local night = Services.Lighting.ClockTime <= 5
                    or Services.Lighting.ClockTime >= 14
                needsLever = ownsProgress("Material", "Mirror Fractal")
                    and not runtime.templeDoorOpen
                    and mystic.spawned
                    and night
                    and runtime.raceV3State == -2
            end
