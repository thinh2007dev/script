    local function rotateFarmMelee()
        if tick() - (runtime.meleeRotateAt or 0) < 5 then
            return
        end
        runtime.meleeRotateAt = tick()

        local blocking = runtime.meleeDefinitions[runtime.meleeIndex or 0]
        local blockingTool, bestTool, bestLevel = nil, nil, nil
        for _, row in ipairs(runtime.meleeDefinitions) do
            local tool = meleeToolByName(row.Name)
            if tool ~= nil then
                local level = toolLevel(tool)
                row.Level = level
                -- SO HUU that su thi mon do khong con gi phai check lai o phien
                -- sau: ghi luon Done de startup khoi ban lenh kiem tra.
                row.Done = true
                if mergeMeleeSave(row.Name, {
                    Level = level,
                    Bought = true,
                    MasteryDone = level >= 400,
                    Done = true,
                }) then
                    pcall(writeMeleeSave)
                end
                if level < 400 then
                    -- Mon dang CHAN chuoi mua (meleeIndex chi nhich khi no du
                    -- 400) duoc uu tien: khong farm no thi khong mua them duoc
                    -- mon nao nua.
                    if blocking ~= nil and row.Name == blocking.Name then
                        blockingTool = tool
                    elseif bestLevel == nil or level < bestLevel then
                        bestTool, bestLevel = tool, level
                    end
                end
            end
        end

        local pick = blockingTool or bestTool
        if pick == nil then
            return
        end
        if runtime.tools.Melee ~= pick then
            print(("melee | doi sang %s (mastery %d)"):format(
                pick.Name, toolLevel(pick)))
        end
        -- Ghim: mon vua thao ra roi vao Backpack se ban ChildAdded va ghi de
        -- runtime.tools.Melee bang chinh no - khong ghim thi doi qua doi lai.
        runtime.tools.Melee = pick
        runtime.meleePinned = pick
    end
