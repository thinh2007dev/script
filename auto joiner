    function API.HasFruitToCollect()
        runtime.fruitRetryAt = runtime.fruitRetryAt or {}
        for _, fruitModel in pairs(runtime.fruitTracker.objects) do
            if fruitAlreadyStored(fruitModel) then
                runtime.untrackDroppedFruit(fruitModel)
                runtime.fruitRetryAt[fruitModel] = nil
            elseif fruitModel.Parent == Services.Workspace
                and tick() >= (runtime.fruitRetryAt[fruitModel] or 0)
            then
                return true
            end
        end
        return false
    end

    runtime.controllers.FruitCollector = function()
        if not runtime.humanoid or not runtime.rootPart then
            return
        end
        -- Chup danh sach TRUOC: fruitTracker.objects bi ChildAdded/ChildRemoved
        -- sua ngay trong luc chay, them key giua pairs() la loi "invalid key to next".
        runtime.fruitRetryAt = runtime.fruitRetryAt or {}
        local pending = {}
        for _, fruitModel in pairs(runtime.fruitTracker.objects) do
            if fruitModel.Parent ~= Services.Workspace then
                -- Roi khoi Workspace = da nhat duoc HOAC bi nguoi khac cuop.
                -- Ca hai deu la xong voi trai nay, di lam viec khac.
                runtime.untrackDroppedFruit(fruitModel)
                runtime.fruitRetryAt[fruitModel] = nil
            elseif fruitAlreadyStored(fruitModel) then
                -- Da co trong ruong: bo tu xa, khong cat ngang farm de bay toi.
                runtime.untrackDroppedFruit(fruitModel)
                runtime.fruitRetryAt[fruitModel] = nil
            elseif tick() >= (runtime.fruitRetryAt[fruitModel] or 0) then
                table.insert(pending, fruitModel)
            end
        end
        -- Khong con trai nao den luot: NHA QUEUE, dung om cho ve farm lv.
        if #pending == 0 then
            API.StopTween()
            runtime.queue:pop("Get Fruits")
            return
        end

        -- Bo phan tu cua trai trong model. Fruit roi co 3 hinh dang khac nhau.
        local function fruitPart(model)
            if not model or model.Parent ~= Services.Workspace then
                return nil
            end
            local handle = model:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                return handle
            end
            local container = model:FindFirstChild("Fruit")
            if container then
                if container:IsA("BasePart") then
                    return container
                end
                local inner = container:FindFirstChild("Fruit")
                if inner and inner:IsA("BasePart") then
                    return inner
                end
                return container:FindFirstChildWhichIsA("BasePart", true)
            end
            return model:FindFirstChildWhichIsA("BasePart", true)
        end

        for _, fruitModel in ipairs(pending) do
            if not queueOwns("Get Fruits") then
                API.StopTween()
                return
            end
            print("Getting: ", fruitModel.Name)

            -- Dong ho chi chay khi DA DUNG CANH trai. Cai cu dem tu vong dau va
            -- khong reset -> bay dai la het 10s roi Destroy(), tu vut mat trai.
            local closeSince = nil
            local chaseUntil = tick() + 60
            local resetDone = false

            while fruitModel.Parent == Services.Workspace and tick() < chaseUntil do
                if not queueOwns("Get Fruits") then
                    API.StopTween()
                    return
                end
                local part = fruitPart(fruitModel)
                if part == nil then
                    -- Khong doc duoc phan tu: hen lai, khong ke la da nhat.
                    runtime.fruitRetryAt[fruitModel] = tick() + 60
                    break
                end
                if runtime.rootPart == nil then
                    API.StopTween()
                    return
                end

                if not resetDone then
                    resetDone = true
                    API.ResetToIsland(part.CFrame)
                end
                API.StepFly(part.CFrame, "Get Fruits", fruitModel)

                if runtime.rootPart ~= nil and part.Parent ~= nil then
                    local gap = (part.Position - runtime.rootPart.Position).Magnitude
                    -- 60 studs, khong phai 20: API.TP chi hua toi trong 30 studs.
                    if gap > 60 then
                        closeSince = nil
                    else
                        closeSince = closeSince or tick()
                        -- Cham thang bang firetouchinterest: NoClip tat CanCollide
                        -- va nhan vat di bang CFrame nen Touched hau nhu khong no.
                        if type(firetouchinterest) == "function" then
                            pcall(function()
                                firetouchinterest(runtime.rootPart, part, 0)
                                task.wait(0.05)
                                firetouchinterest(runtime.rootPart, part, 1)
                            end)
                        end
                        local confirmUntil = tick() + 1
                        repeat
                            task.wait(0.1)
                        until fruitModel.Parent ~= Services.Workspace
                            or tick() >= confirmUntil
                        -- Chua nhat duoc thi KHONG bo theo doi (bo theo doi la
                        -- tu ke nhu da nhat). Hen lai sau, lam trai khac truoc.
                        if closeSince ~= nil and tick() - closeSince >= 15 then
                            runtime.fruitRetryAt[fruitModel] = tick() + 60
                            print(fruitModel.Name, "chua nhat duoc - de lat quay lai")
                            break
                        end
                    end
                end

                API.AddVelocity()
                if fruitModel.Parent ~= Services.Workspace then
                    runtime.untrackDroppedFruit(fruitModel)
                    runtime.fruitRetryAt[fruitModel] = nil
                    break
                end
                task.wait(0.1)
            end
        end
    end

