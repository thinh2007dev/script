    -- ============ LIGHTNING BOLT: PHA DAM MAY BAO O SKYLANDS ============
    -- Ban ghi remote da chi ro het, khong con phai doan mau nua:
    --   Workspace.CloudPieces.cloudPiece -> dam may bao, DANH CAI NAY
    --   Workspace.Map.Sky.cloud          -> may nen cua map, khong phai muc tieu
    --   ClownJewelsCloud                 -> su kien khac, bo qua
    -- Chuoi day du do duoc trong log 23:33 (sea 1):
    --   CommF_("ElectroQuestState")   -> so buoc dang o (5 chua nhan, 4 dang
    --                                    tim ngoc, 2 da nop ngoc)
    --   CommF_("AcceptElectroQuest")  -> nhan viec, state 5 -> 4
    --   RegisterAttack(0.4, n) + RegisterHit(cloudPiece) tung part -> ra ngoc
    --   CommF_("DeliverLightningBolt")-> nop ngoc, state 4 -> 2
    --   CommF_("BuyElectro", true)    -> nhan Electro
    -- Ten NPC giao viec trong BonusMomentsGuide la "SkyElectroTeacher".
    local CLOUD_FOLDER = "CloudPieces"
    local CLOUD_PART = "cloudpiece"
    local ELECTRO_NPCS = { "SkyElectroTeacher", "Mad Scientist" }

    -- Server la nguon su that, khong phai co runtime.electroQuestTaken: chet
    -- hoac vao lai server la co bi lech, con state thi luon dung.
    local function electroQuestState()
        local ok, state = pcall(function()
            return runtime.commF:InvokeServer("ElectroQuestState")
        end)
        return ok and tonumber(state) or nil
    end

    local function electroNPCCFrame()
        for _, name in ipairs(ELECTRO_NPCS) do
            local frame = API.GetNPCCFrame(name)
            if typeof(frame) == "CFrame" then
                return frame
            end
        end
        return nil
    end

    local function lightningCloudParts()
        local found = {}
        local folder = Services.Workspace:FindFirstChild(CLOUD_FOLDER)
        if folder == nil then
            return found
        end
        pcall(function()
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart")
                    and string.find(string.lower(obj.Name), CLOUD_PART, 1, true)
                then
                    -- Model ngoai map da co mau that tu xa. Chi may den/toi moi
                    -- la may tich dien co Lightning Bolt; may trang khong danh.
                    local color = obj.Color
                    local luminance = color.R * 0.2126
                        + color.G * 0.7152
                        + color.B * 0.0722
                    if luminance <= 0.55 then
                        table.insert(found, obj)
                    end
                end
            end
        end)
        return found
    end

