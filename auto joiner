    local function handleBackpackChildAdded(child)
        local name = child.Name
        if trackedCarriedNames[name] or name == runtime.configs["Eat Fruit"] then
            local carried = runtime.carried[name] or {}
            carried.Backpack = true
            runtime.carried[name] = carried
            -- KHONG ban BuyElectro o day: ngoc roi giua troi, cach Mad Scientist
            -- ca ngan studs, ban tu xa la bi tu choi va mat luot. Chi bao Buy
            -- Melee quet lai ngay de no bay toi thay roi nop.
            -- Fire Essence / Lightning Bolt nam trong bang nay nen nhanh tren
            -- return TRUOC khi toi backpackPickupActions - muc nop o duoi la
            -- CODE CHET. Do la ly do ngoc Fire Essence khong bao gio duoc nop
            -- va Dragon Talon khong bao gio mua duoc.
            if name == "Lightning Bolt" or name == "Fire Essence" then
                runtime.meleeBuyAt = 0
                print(("melee | co %s - bay toi NPC nop"):format(name))
            end
            return
        end

        local action = backpackPickupActions[name]
        if action then
            if action.type == "Once" then
                runtime.commF:InvokeServer(table.unpack(action.args))
            else
                local ownerProgress = runtime.meleeProgress[action.owner]
                if ownerProgress then
                    if not ownerProgress.Done then
                        runtime.commF:InvokeServer(table.unpack(action.args))
                        ownerProgress.Done = true
                    end
                elseif action.type then
                    local inventoryType = runtime.inventory[action.type]
                    if not inventoryType or not inventoryType[action.owner] then
                        runtime.commF:InvokeServer(table.unpack(action.args))
                        inventoryType = inventoryType or {}
                        runtime.inventory[action.type] = inventoryType
                        inventoryType[action.owner] = true
                    end
                end
            end
            return
        end

        if child:IsA("Tool") and runtime.tools[child.ToolTip] ~= nil then
            -- Melee da duoc ghim thi khong ghi de: thao mon cu ra la no roi vao
            -- Backpack va ban ChildAdded, ghi de o day se keo nguoc ve mon vua bo.
            local pinned = runtime.meleePinned
            if child.ToolTip ~= "Melee"
                or pinned == nil
                or pinned.Parent == nil
            then
                runtime.tools[child.ToolTip] = child
            end
            return
        end

        storeFruitIfAllowed(child)
    end

