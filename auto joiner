local PriorityQueue = {}
PriorityQueue.__index = PriorityQueue

local function swapQueueEntries(queue, left, right)
    local heap = queue.heap
    heap[left], heap[right] = heap[right], heap[left]
    queue.indexMap[heap[left].element] = left
    queue.indexMap[heap[right].element] = right
end

local function siftQueueUp(queue, index)
    while index > 1 do
        local parent = math.floor(index / 2)
        if queue.heap[index].priority > queue.heap[parent].priority then
            swapQueueEntries(queue, index, parent)
            index = parent
        else
            return
        end
    end
end

local function siftQueueDown(queue, index)
    local heapSize = #queue.heap
    while true do
        local left = index * 2
        local right = left + 1
        local largest = index
        if left <= heapSize and queue.heap[left].priority > queue.heap[largest].priority then
            largest = left
        end
        if right <= heapSize and queue.heap[right].priority > queue.heap[largest].priority then
            largest = right
        end
        if largest == index then
            return
        end
        swapQueueEntries(queue, index, largest)
        index = largest
    end
end

function PriorityQueue:new()
    return setmetatable({
        heap = {},
        indexMap = {},
    }, self)
end

function PriorityQueue:push(element, priority)
    if self.indexMap[element] then
        return
    end
    table.insert(self.heap, { element = element, priority = priority })
    local index = #self.heap
    self.indexMap[element] = index
    siftQueueUp(self, index)
end

function PriorityQueue:pop(element)
    local index = self.indexMap[element]
    if not index then
        return nil
    end
    swapQueueEntries(self, index, #self.heap)
    local removed = table.remove(self.heap)
    self.indexMap[element] = nil
    if index <= #self.heap then
        siftQueueUp(self, index)
        siftQueueDown(self, index)
    end
    return removed.element
end

function PriorityQueue:top()
    return self.heap[1] and self.heap[1].element
end

function PriorityQueue:empty()
    return #self.heap == 0
end

