        runtime.workers.admin = task.spawn(API.CheckAdmin)
        if not isnetworkowner then
            getfenv().isnetworkowner = API.isnetworkowner_clone
        end
        runtime.startupStep = "complete"
    end

    function runtime:start(configOverrides)
        if self.lifecycle ~= "new" then
            return self
        end
        self.lifecycle = "starting"
        local environment = getgenv()
        local configured = environment.Configs
        if type(configured) ~= "table" then
            configured = {}
        end
        if type(configOverrides) == "table" then
            for key, value in pairs(configOverrides) do
                configured[key] = value
            end
        end
        environment.Default_Configs = DefaultConfigs
        fillConfigDefaults(configured, DefaultConfigs)
        environment.Configs = configured
        self.configs = configured
        self.eatFruitStorageName = fruitStorageName(self.configs["Eat Fruit"])
        self.snipeFruitStorageName = fruitStorageName(self.configs["Snipe Fruit"])
        initializeCarriedRows()

        self.running = true
        self.enabled = false
        self.status = "Starting"
        local startupPhase = "bind"
        local ok, startupError = xpcall(function()
            API.BindEvents()
            startupPhase = "startup"
            API.Startup()
        end, debug.traceback)
        if not ok then
            self.lastStartupError = startupError
            local failedStatus = "Startup failed: " .. tostring(startupError)
            if startupPhase == "startup" then
                warn(startupError)
                if not rawget(getgenv(), "__CODEX_XERO_DISABLE_STARTUP_REJOIN") then
                    pcall(function()
                        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", game.JobId)
                    end)
                end
            end
            local cleanupOk = self:stop(failedStatus, "failed")
            if not cleanupOk then
                self.status = failedStatus .. " | cleanup incomplete"
            end
            return self
        end

        self.workers.evaluator = task.spawn(function()
            while self.running do
                xpcall(API.EvaluateMainFeatures, function(passError)
                    self.lastMainError = passError
                    if string.find(passError, "attempt to compare number < nil", 1, true) then
                        delfile("Xero Hub/Kaitun/" .. LocalPlayer.Name .. ".json")
                        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", game.JobId)
                    end
                    warn(passError, "MS")
                end)
                task.wait(0.01)
            end
        end)
        self.workers.secondary = task.spawn(function()
            while self.running do
                xpcall(API.RunSecondaryFeatures, function(passError)
                    self.lastSecondaryError = passError
                    warn(passError, "AT")
                end)
                task.wait(0.01)
            end
        end)
        self.workers.snipe = task.spawn(function()
            while self.running do
                local elapsed = task.wait(10)
                if not self.running or not elapsed then
                    break
                end
                xpcall(API.SnipeFruitChanged, function(passError)
                    self.lastSnipeError = passError
                    warn(passError, "ATT")
                end)
            end
        end)
        -- Worker rieng: truoc day gacha di nho vao SnipeFruitChanged, ma ham do
        -- goi LoadProgress truoc - LoadProgress nem loi la mat luon lan quay.
        self.workers.gacha = task.spawn(function()
            while self.running do
                local elapsed = task.wait(1)
                if not self.running or not elapsed then
                    break
                end
                xpcall(self.controllers.RandomFruitGacha, function(passError)
                    self.lastGachaError = passError
                    warn(passError, "GACHA")
                end)
            end
        end)
        if self.configs["Hop Player Near"] then
            self.workers.hopFallback = task.spawn(function()
                while self.running do
                    task.wait(1)
                    if not self.running then
                        break
                    end
                    if not self.dragonTalonBonesBought then
                        local passOk, passError = xpcall(self.controllers.HopFallback, debug.traceback)
                        if not passOk then
                            self.lastHopFallbackError = passError
                            warn(passError, nil)
                        end
                    end
                end
            end)
        end
        if self.configs.Hop.Enable then
            self.workers.hop = task.spawn(function()
                while self.running do
                    task.wait(1)
                    if not self.running then
                        break
                    end
                    API.PollHopData()
                end
            end)
        end
        self.lifecycle = "running"
        self:setEnabled(true)
        return self
    end

    function runtime:setEnabled(enabled)
        if enabled then
            if not self.running then
                return self
            end
            if self.enabled and self.workers.feature then
                return self
            end
            self.enabled = true
            self.workers.feature = task.spawn(function()
                while task.wait(0.01) and self.running and self.enabled do
                    xpcall(API.RunTopFeature, function(passError)
                        self.lastFeatureError = passError
                        clearFeatureConnectionScopes()
                        warn(passError, self.queue:top())
                    end)
                end
            end)
            return self
        end

        self.enabled = false
        clearFeatureConnectionScopes()
        local featureWorker = self.workers.feature
        self.workers.feature = nil
        if featureWorker then
            pcall(task.cancel, featureWorker)
        end
        API.StopTween()
        API.RemoveVelocity()
        if self.humanoid then
            self.humanoid.PlatformStand = false
        end
        last_task = ""
        self.activeFeature = ""
        setStatus("Chilling")
        return self
    end

    function runtime:snapshot()
        return {
            running = self.running,
            enabled = self.enabled,
            status = self.status,
            sea = self.sea,
            placeId = game.PlaceId,
            quest = getQuestForLevel(self.sea, LocalPlayer.Data.Level.Value),
            hitTargets = #self.hitTargets,
            currentWeaponCategory = self.activeWeaponCategory,
            noClipEnabled = self.noClipEnabled,
            tweenState = self.currentTween and tostring(self.currentTween.PlaybackState) or "none",
        }
    end

    function runtime:stop(finalStatus, finalLifecycle)
        local cleanupOk = true
        local currentThread = coroutine.running()
        self.running = false
        local disableOk, disableError = pcall(function()
            self:setEnabled(false)
        end)
        if not disableOk then
            cleanupOk = false
            self.lastCleanupError = disableError
            self.enabled = false
        end
        local noClipOk, noClipError = pcall(API.NoClip, "off")
        if not noClipOk then
            cleanupOk = false
            self.lastCleanupError = noClipError
        end
        clearFeatureConnectionScopes()

        local ownedWorkers = {}
        for name, worker in pairs(self.workers) do
            table.insert(ownedWorkers, { name = name, thread = worker })
            self.workers[name] = nil
        end
        for _, owned in ipairs(ownedWorkers) do
            if owned.thread and owned.thread ~= currentThread then
                pcall(task.cancel, owned.thread)
            end
        end

        for _, connection in ipairs(self.connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        table.clear(self.connections)

        self.hookSpoofTarget = nil
        local hookState = self.hookState
        if hookState then
            local restoreOk, restoreError = restoreOwnedNamecallHook(hookState)
            if restoreOk then
                self.hookState = nil
                self.hookInstalled = false
            else
                cleanupOk = false
                self.lastCleanupError = restoreError
            end
        elseif self.hookInstalled then
            cleanupOk = false
            self.lastCleanupError = "namecall hook ownership unavailable"
        end

        if self.bodyVelocity then
            local destroyOk, destroyError = pcall(function()
                self.bodyVelocity:Destroy()
            end)
            if destroyOk then
                self.bodyVelocity = nil
            else
                cleanupOk = false
                self.lastCleanupError = destroyError
            end
        end
        if self.ui then
            pcall(function()
                self.ui:Destroy()
            end)
            self.ui = nil
            self.uiElements = nil
        end

        if cleanupOk then
            self.lifecycle = finalLifecycle or "stopped"
            self.status = finalStatus or "Stopped"
        else
            self.lifecycle = finalLifecycle or "cleanup_incomplete"
            self.status = (finalStatus or "Stopped") .. " | cleanup incomplete"
        end
        return cleanupOk
    end

    task.defer(function()
        sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", math.huge)
    end)
    pcall(function()
        Services.Workspace.Map.Dressrosa.FlamingoExit:Destroy()
