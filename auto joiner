        -- Startup - vi Startup chet la runtime.running = false, khong UI, khong
        -- nut On, khong gi chay. Loi buoc nao thi noi ten buoc do va di tiep.
        local function loadStep(name, fn)
            runtime.startupStep = name
            local ok, stepError = pcall(fn)
            if not ok then
                runtime.startupStepErrors = runtime.startupStepErrors or {}
                runtime.startupStepErrors[name] = tostring(stepError)
                warn(("[Xero] buoc %s loi (bo qua, chay tiep): %s"):format(
