    -- Lenh chay skill o RemoteFunction KHONG TEN duoi Humanoid; RemoteEvent cua
    -- tool mang huong ngam va trang thai giu/nha quanh no.
    local function fireSkillRemote(key, tool)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid == nil then
            return false
        end
        local runner = nil
        for _, child in ipairs(humanoid:GetChildren()) do
            if child:IsA("RemoteFunction") then
                runner = child
                break
            end
        end
        if runner == nil then
            return false
        end
        local aim = runtime.rootPart ~= nil and runtime.rootPart.Position or nil
        local target = runtime.hitTargets and runtime.hitTargets[1]
        if type(target) == "table" and target[2] ~= nil then
            local okAim, position = pcall(function()
                return target[2].Position
            end)
            if okAim then
                aim = position
            end
        end
        local toolRemote = tool ~= nil and tool:FindFirstChild("RemoteEvent") or nil
        return pcall(function()
            if toolRemote ~= nil and aim ~= nil then
                toolRemote:FireServer(true)
                toolRemote:FireServer(aim)
            end
            runner:InvokeServer(tostring(key))
            if toolRemote ~= nil and aim ~= nil then
                toolRemote:FireServer(aim)
                toolRemote:FireServer(false)
            end
        end)
    end

