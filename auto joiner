    -- ============ NGOI GIUA DAN, KHONG NGOI LEN 1 CON ============
    -- Neo vao con DAU TIEN cua GetChildren() la neo vao con o ria bai, ma
    -- BringMob chi keo trong 350 studs quanh neo -> nua bai kia khong bao gio
    -- bi keo vao (bai Factory Staff 6 con chi danh duoc 3).
    -- Tra ve neoCFrame, conDungGiuaNhat.
    function API.MobPackAnchor(mobName, reach)
        local enemies = Services.Workspace:FindFirstChild("Enemies")
        if enemies == nil then
            return nil, nil
        end
        reach = tonumber(reach) or 350
        local members = {}
        for _, enemy in ipairs(enemies:GetChildren()) do
            if enemy.Name == mobName then
                local humanoid = enemy:FindFirstChild("Humanoid")
                local root = enemy:FindFirstChild("HumanoidRootPart")
                local head = enemy:FindFirstChild("Head")
                if humanoid and humanoid.Health > 0 and root and head then
                    table.insert(members, { enemy = enemy, position = root.Position })
                end
            end
        end
        if #members == 0 then
            return nil, nil
        end
        -- Gom cum truoc khi lay trung binh: trung binh cua 2 bai xa nhau la
        -- khoang bien o giua.
        table.sort(members, function(a, b)
            if a.position.X ~= b.position.X then
                return a.position.X < b.position.X
            end
            if a.position.Y ~= b.position.Y then
                return a.position.Y < b.position.Y
            end
            return a.position.Z < b.position.Z
        end)
        local clusters = {}
        for _, member in ipairs(members) do
            local best, bestGap = nil, nil
            for index, cluster in ipairs(clusters) do
                local gap = ((cluster.total / cluster.count) - member.position).Magnitude
                if bestGap == nil or gap < bestGap then
                    best, bestGap = index, gap
                end
            end
            if best ~= nil and bestGap <= reach then
                local cluster = clusters[best]
                cluster.total = cluster.total + member.position
                cluster.count = cluster.count + 1
                table.insert(cluster.members, member)
            else
                table.insert(clusters, {
                    total = member.position,
                    count = 1,
                    members = { member },
                })
            end
        end
        -- Cum DONG NHAT thang; hoa thi lay cum gan minh hon.
        local from = runtime.rootPart ~= nil and runtime.rootPart.Position or nil
        local pick, pickCount, pickGap = nil, nil, nil
        for _, cluster in ipairs(clusters) do
            local centre = cluster.total / cluster.count
            local gap = from ~= nil and (centre - from).Magnitude or 0
            if pick == nil
                or cluster.count > pickCount
                or (cluster.count == pickCount and gap < pickGap)
            then
                pick, pickCount, pickGap = cluster, cluster.count, gap
            end
        end
        local centre = pick.total / pick.count
        -- Con dan dau = con gan tam cum nhat: ghim no thi server it phan doi nhat.
        local lead, leadGap = nil, nil
        for _, member in ipairs(pick.members) do
            local gap = (member.position - centre).Magnitude
            if leadGap == nil or gap < leadGap then
                lead, leadGap = member.enemy, gap
            end
        end
        return CFrame.new(centre), lead
    end

    local function farmNormalLevelQuestOnce(quest, destination)
        local mobName = quest.mob_name

        local packAnchor, packLead = API.MobPackAnchor(mobName)

        local found = false
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if enemy.Name == mobName and (packLead == nil or enemy == packLead) then
                local enemyHumanoid = enemy:FindFirstChild("Humanoid")
                local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
                local enemyHead = enemy:FindFirstChild("Head")
                if enemyHumanoid and enemyHumanoid.Health > 0 and enemyRoot and enemyHead then
                    found = true
                    setStatus("Auto Farm Level | Attacking mob")

                    -- GIUA DAN, khong phai vi tri cua rieng con nay.
                    local savedCFrame = packAnchor or enemyRoot.CFrame
                    local attackStartedAt = tick()
                    local originalPosition = enemyRoot.Position
                    local questStamp = runtime.questCompletedTick

                    while enemyHumanoid.Health > 0 do
                        task.wait(runtime.attackDelay)

                        -- Xong quest la DUNG NGAY, di nhan quest moi. Danh not
                        -- ca dan khong duoc gi ma mat luon dan quai cho quest sau.
                        if runtime.questCompletedTick ~= questStamp then
                            API.StopTween()
                            return
                        end

                        if not enemy.Parent
                            or enemyRoot.Parent ~= enemy
                            or enemyHead.Parent ~= enemy
                        then
                            break
                        end

                        if tick() - attackStartedAt >= 10 and enemyHumanoid.Health == enemyHumanoid.MaxHealth then
                            enemy:Destroy()
                            break
                        end
                        API.RefreshWeaponIfStuck(enemyHumanoid.Health)

                        if not runtime.humanoid or runtime.humanoid.Health <= 0 or not runtime.rootPart then
                            repeat
                                task.wait(1)
                            until runtime.humanoid and runtime.rootPart and runtime.humanoid.Health > 0
                            API.AddVelocity()
                        end

                        if (enemyRoot.Position - originalPosition).Magnitude > 200 then
                            break
                        end
                        -- Neo DUNG YEN: khong keo diem neo chay theo con vua bi
                        -- server giat ra, neu khong ca bai tu troi khoi cho spawn.
                        -- 30 studs nhu cu: 10 la dung sat quai nen bi danh trung.
                        local farmSpot = savedCFrame + Vector3.new(0, 30, 0)
                        if (farmSpot.Position - runtime.rootPart.Position).Magnitude > 50 then
                            API.StepFly(farmSpot, "Auto Farm Level")
                            API.AddVelocity()
                        end

                        if runtime.queue:empty() or runtime.queue:top() ~= "Auto Farm Level" then
                            API.StopTween()
                            return
                        end

                        enemyRoot.CFrame = savedCFrame
                        API.BringMob(savedCFrame, enemy.Name, false, enemy)
                        table.insert(runtime.hitTargets, 1, { enemy, enemyHead })
                        table.insert(runtime.gunTargets, 1, enemyHead)

                        local masteryConfig = runtime.configs["Farm Mastery"]
                        local healthPercent = enemyHumanoid.Health / enemyHumanoid.MaxHealth * 100
                        if masteryConfig.Enable
                            and runtime.masteryCategory
                            and healthPercent <= masteryConfig["Mastery Health (%)"]
                        then
                            API.EquipWeapon(runtime.masteryCategory)
                            API.FarmMastery(enemy, savedCFrame, runtime.masteryCategory)
                        else
                            if runtime.useSwordAtMaxMastery
                                and (
                                    healthPercent <= masteryConfig["Mastery Health (%)"]
                                    or LocalPlayer.Data.Stats.Sword.Level.Value == 2800
                                )
                            then
                                API.EquipWeapon("Sword")
                            else
                                API.EquipWeapon(runtime.activeWeaponCategory)
                            end
                            API.Attack()
                        end
                    end
                end
            end
        end

        if found then
            runtime.mobWaitStartedAt = tick()
            runtime.mobSpotSince = tick()
            runtime.mobFarSince = nil
            return
        end

        setStatus("Auto Farm Level | Waiting mob")
        -- ResetToIsland = MOT CAI CHET, nen chi goi khi BAY MAI KHONG TOI.
        -- Xong quest la doi sang bai kia ngay, va bai do luon dang o xa - reset
        -- ngay tu vong dau la chet moi lan xong nhiem vu. Cho bay 15 giay da.
        local travelGap = runtime.rootPart ~= nil
            and (destination.Position - runtime.rootPart.Position).Magnitude
            or 0
        -- ============ FIX DUNG CONG THAY VI RESET ============
        -- CHI reset khi KHONG TIEN GAN THEM. Truoc day chi can "xa hon 1500
        -- studs trong 15 giay" la reset, ma bay tu mat dat len Sky Area 2
        -- (Y~5550) hay ra Fish Man (X~61000) hoac ra tau o Sea 2 mat lau hon 15
        -- giay rat nhieu -> no reset NGAY GIUA DUONG BAY, hoi sinh lai duoi
        -- dat, bay lai, roi reset tiep - vong lap khong bao gio den duoc.
        if travelGap > 1500 then
            local best = runtime.mobFarBest
            if best == nil or travelGap < best - 150 then
                -- Con rut ngan duoc khoang cach: chuyen bay dang chay, gia han.
                runtime.mobFarBest = travelGap
                runtime.mobFarSince = tick()
            else
                runtime.mobFarSince = runtime.mobFarSince or tick()
            end
        else
            runtime.mobFarSince = nil
            runtime.mobFarBest = nil
        end
        if runtime.mobFarSince ~= nil
            and tick() - runtime.mobFarSince > 15
            and tick() - (runtime.mobResetAt or 0) > 30
        then
            runtime.mobFarSince = nil
            runtime.mobFarBest = nil
            runtime.mobResetAt = tick()
            API.ResetToIsland(destination)
        end
        API.StepFly(destination, "Auto Farm Level")
        API.AddVelocity()

        -- Dung tai bai cho spawn; chi doi bai khi da dung du 25 giay ma van trong.
        local now = tick()
        runtime.mobSpotSince = runtime.mobSpotSince or now
        local atSpot = runtime.rootPart ~= nil
            and (destination.Position - runtime.rootPart.Position).Magnitude <= 250
        if not atSpot then
            runtime.mobSpotSince = now
        elseif now - runtime.mobSpotSince > 25 then
            runtime.mobSpotSince = now
            API.AdvanceMobSpot(quest.mob_name, quest.mob_pos)
        end
        if now - runtime.mobWaitStartedAt > 60 then
            runtime.mobWaitStartedAt = now
            API.HopServer(nil, true)
        end
    end

