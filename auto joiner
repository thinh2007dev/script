    local function selectRaidSacrifice(doughRaid)
        local physical = runtime.progress.PhysicalMoveset
        if not physical then
            return nil
        end
        for _, row in pairs(physical) do
            local name = row.StorageKey or row.Name
            local eligible = doughRaid
                    and (row.Rarity == 3 or name == "Gravity-Gravity")
                or (not doughRaid and (row.Rarity ~= 4 or name == "Gravity-Gravity"))
            if eligible and (row.Count or 0) > 0 then
                return name
            end
        end
        return nil
    end

    -- Con trai nao de dot lay chip khong? Raid la nguon F chinh, nhung no AN
    -- MOT TRAI da cat kho - het trai la khong raid duoc, va do la luc phai
    -- kiem F bang duong khac.
    function API.HasRaidSacrifice(doughRaid)
        return selectRaidSacrifice(doughRaid) ~= nil
    end

    local function closeRaidConnectionScope()
        closeFeatureConnectionScope(runtime.featureConnectionScopes.Raid)
        runtime.raid.islandConnection = nil
    end

    -- Locations chua dao raid cua MOI nguoi tren server. Chi lay dung so thu tu
    -- can tim va lay con GAN NHAT voi moc, khong lay con dau tien tim thay.
    local function raidIslandIndex(location)
        if not location:IsA("BasePart") then
            return nil
        end
        return tonumber(location.Name:match("^Island (%d+)$"))
    end

    local function nearestRaidIsland(index, anchor, maxDistance)
        if anchor == nil then
            return nil
        end
        local best, bestDistance = nil, maxDistance
        for _, location in ipairs(Services.Workspace._WorldOrigin.Locations:GetChildren()) do
            if raidIslandIndex(location) == index then
                local distance = (location.Position - anchor).Magnitude
                if distance <= bestDistance then
                    best, bestDistance = location, distance
                end
            end
        end
        return best, bestDistance
    end

    runtime.controllers.Raid = function(queueLabel, raidType)
        if not runtime.humanoid or not runtime.rootPart or runtime.humanoid.Health <= 0 then
            return
        end
        local raid = runtime.raid
        local now = tick()
        if now - raid.lastEvent <= 3 then
            return
        end
        local islandRaiding = LocalPlayer:GetAttribute("IslandRaiding")
        if islandRaiding == false then
            raid.inProgress = false
            raid.island = nil
            closeRaidConnectionScope()
            raid.selecting = false
        end

        -- DANG TRONG RAID THI TUYET DOI KHONG VAO LUONG TRIEU HOI.
        -- Truoc day chot bang MOT thuoc tinh `IslandRaiding`, ma thuoc tinh do
        -- doc ra false trong choc lat giua tran (chet + hoi sinh, chuyen dao).
        -- Mot vong lot qua cua so do la lai ban lenh Select/summon trong khi
        -- dong ho raid van chay - dung cai "Try again soon." trong anh.
        -- RaidMapActive hoi ba nguon, trong do co dong ho "Time Left" hien tren
        -- man hinh: mot co nhap nhay khong the thang mot dong ho dang chay.
        local startedAt = tick()
        local waitingForRaid = islandRaiding == false and not API.RaidMapActive()
        while waitingForRaid do
            task.wait(0.01)
            local map = Services.Workspace.Map
            local inSecondSea = table.find(XeroQuestData.PlaceIds[2], game.PlaceId) ~= nil
            local inThirdSea = table.find(XeroQuestData.PlaceIds[3], game.PlaceId) ~= nil
            local summonButton

            if inSecondSea then
                summonButton = map.CircleIsland.RaidSummon2.Button
                if not summonButton:FindFirstChild("Main") then
                    API.TP(summonButton.WorldPivot, queueLabel)
                    API.AddVelocity()
                    return
                end
            elseif inThirdSea then
                local castle = map:FindFirstChild("Boat Castle")
                if not castle then
                    runtime.rootPart.CFrame = Services.Workspace["Boat Castle"].WorldPivot
                    return
                end
                summonButton = map["Boat Castle"].RaidSummon2.Button
                if not summonButton:FindFirstChild("Main") then
                    runtime.rootPart.CFrame = summonButton.WorldPivot
                    return
                end
            end

            local chip = runtime.carried["Special Microchip"]
            local hasChip = chip and (chip.Backpack or chip.Character)
            if not hasChip and not raid.selecting then
                -- Da mua chip roi thi CHO, khong mua nua. Chip da doi mot trai
                -- cat kho, nen tu luc do den khi raid xong (hoac chet) la MOT
                -- viec lien mach - mua them cai nua la dot them mot trai.
                if raid.committed
                    and tick() - (raid.committedAt or 0) < 180
                    and not API.RaidMapActive()
                then
                    return
                end
                -- HOI LAI NGAY TRUOC KHI MUA. Chip an mot trai da cat kho, nen
                -- chi mua khi THAT SU con can raid. Truoc day cu vao ham la
                -- mua, ke ca vua raid xong va da du F - do la "mua san chip".
                if API.RaidMapActive() or not API.RaidChipWanted() then
                    raid.requested = false
                    runtime.queue:pop("Auto Raid")
                    API.StopTween()
                    return
                end
                local selectResult = runtime.commF:InvokeServer("RaidsNpc", "Select", raidType)
                if type(selectResult) == "string" then
                    local fruitName = selectRaidSacrifice(raidType == "Dough")
                    if not fruitName then
                        if raidType == "Dough" then
                            runtime.doughRaidReady = false
                        else
                            runtime.normalRaidReady = false
                        end
                        return
                    end
                    if not queueOwns(queueLabel) then
                        API.StopTween()
                        return
                    end
                    runtime.allowFruitStorage = false
                    print("Get fruit: ", fruitName)
                    if runtime.commF:InvokeServer("LoadFruit", fruitName) == true then
                        runtime.progress.PhysicalMoveset[fruitName].Count -= 1
                        runtime.commF:InvokeServer("RaidsNpc", "Select", raidType)
                        runtime.allowFruitStorage = true
                        -- TRAI DA DOT. Tu day den luc raid xong hoac chet la
                        -- mot viec lien mach, khong mua chip nao nua.
                        raid.committed = true
                        raid.committedAt = tick()
                        print(("raid | da doi %s lay chip - khoa lai den khi raid xong")
                            :format(tostring(fruitName)))
                        task.wait(1)
                    else
                        return
                    end
                end
            end

            if hasChip then
                if inSecondSea then
                    fireclickdetector(map.CircleIsland.RaidSummon2.Button.Main.ClickDetector)
                elseif inThirdSea then
                    fireclickdetector(map["Boat Castle"].RaidSummon2.Button.Main.ClickDetector)
                end
                raid.inProgress = true
            end

            if not queueOwns(queueLabel) or runtime.humanoid.Health <= 0 then
                API.StopTween()
                return
            end
            if tick() - startedAt > 10 then
                API.StopTween()
                return
            end
            islandRaiding = LocalPlayer:GetAttribute("IslandRaiding")
            -- `not islandRaiding` nhan ca NIL - nil la "chua biet", khong phai
            -- "chua raid". Chot vao cua hoi chat hon dung nhu luc vao vong.
            waitingForRaid = islandRaiding == false and not API.RaidMapActive()
        end

        if not queueOwns(queueLabel) then
            API.StopTween()
            return
        end
        if not raid.inProgress then
            return
        end

        if not LocalPlayer.PlayerGui.Main.TopHUDList.RaidTimer.Visible then
            if raid.canAwaken and runtime.configs["Awaken Fruit"] and runtime.raidProgress then
                local awakenResult = runtime.commF:InvokeServer("Awakener", "Awaken")
                if awakenResult == 0 and runtime.commF:InvokeServer("Awakener", "Teleport") == 1 then
                    raid.inProgress = false
                    raid.island = nil
                    closeRaidConnectionScope()
                    raid.canAwaken = false
                elseif awakenResult == 1 then
                    raid.inProgress = false
                    raid.island = nil
                    closeRaidConnectionScope()
                    API.LoadProgress()
                    raid.canAwaken = false
                end
            end
            return
        end

        if raid.island then
            if not raid.island.Parent
                or (raid.island.Position - runtime.rootPart.Position).Magnitude >= 8000
            then
                runtime.humanoid.Health = 0
                return
            end
        else
            local scope = runtime.featureConnectionScopes.Raid
            if not featureConnectionScopeIsActive(scope) then
                scope = beginFeatureConnectionScope("Raid")
            end
            local islandConnection
            islandConnection = connectFeatureSignal(
                scope,
                Services.Workspace._WorldOrigin.Locations.ChildAdded,
                function(location)
                    local currentIsland = raid.island
                    if not currentIsland or not currentIsland.Parent then
                        return
                    end
                    local currentIndex = raidIslandIndex(currentIsland)
                    if currentIndex == nil or raidIslandIndex(location) ~= currentIndex + 1 then
                        return
                    end
                    -- Dao ke tiep cua CHUOI MINH luon moc noi dao minh dang dung.
                    -- Dao cua nguoi khac o xa hon -> loai.
                    local distance = (location.Position - currentIsland.Position).Magnitude
                    if distance > 2500 then
                        return
                    end
                    local existing = nearestRaidIsland(
                        currentIndex + 1,
                        currentIsland.Position,
                        distance
                    )
                    raid.island = existing or location
                end,
                function()
                    if raid.islandConnection == islandConnection then
                        raid.islandConnection = nil
                    end
                end
            )
            raid.islandConnection = islandConnection

            -- Vao raid la game spawn minh ngay tren Island 1 CUA MINH.
            raid.island = nearestRaidIsland(1, runtime.rootPart.Position, 3000)
            if not raid.island then
                runtime.humanoid.Health = 0
                return
            end
        end

        -- Bo lo su kien ChildAdded (dao ke tiep spawn truoc khi noi tin hieu):
        -- tu do chuoi cua minh, khong doi tin hieu.
        local currentIndex = raidIslandIndex(raid.island)
        if currentIndex then
            local nextIsland = nearestRaidIsland(
                currentIndex + 1,
                raid.island.Position,
                2500
            )
            if nextIsland then
                raid.island = nextIsland
            end
        end

        local healthPercent = runtime.humanoid.Health / runtime.humanoid.MaxHealth * 100
        API.TP(
            raid.island.CFrame * CFrame.new(0, healthPercent <= 50 and 500 or 80, 0),
            queueLabel
        )
        API.AddVelocity()
        if not queueOwns(queueLabel) then
            API.StopTween()
            return
        end

        sethiddenproperty(LocalPlayer, "SimulationRadius", 9000000000)
        local islandPosition = raid.island.Position
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if not queueOwns(queueLabel) then
                API.StopTween()
                return
            end

            healthPercent = runtime.humanoid.Health / runtime.humanoid.MaxHealth * 100
            -- Do khoang cach tu DAO CUA MINH, khong do tu ban than: bay lac
            -- sang gan raid nguoi khac cung khong an quai cua ho.
            if healthPercent > 50
                and enemy.Name ~= "PirateGrandBrigade"
                and enemy.Name ~= "PirateBrigade"
                and enemy.Name ~= "FishBoat"
                and enemy:FindFirstChild("Humanoid")
                and enemy.Humanoid.Health > 0
                and enemy:FindFirstChild("HumanoidRootPart")
                and (enemy.HumanoidRootPart.Position - islandPosition).Magnitude <= 1500
            then
                if enemy.HumanoidRootPart:FindFirstChild("BossNotifier") then
                    repeat
                        task.wait(runtime.attackDelay)
                        healthPercent = runtime.humanoid.Health / runtime.humanoid.MaxHealth * 100
                        if healthPercent <= 50 then
                            return
                        end
                        if (enemy.HumanoidRootPart.Position - islandPosition).Magnitude > 2000 then
                            break
                        end
                        if (enemy.HumanoidRootPart.Position - runtime.rootPart.Position).Magnitude > 50 then
                            API.TP(
                                enemy.HumanoidRootPart.CFrame
                                    + enemy.HumanoidRootPart.CFrame.UpVector * 30,
                                queueLabel,
                                false
                            )
                            API.AddVelocity()
                        end
                        if not queueOwns(queueLabel) then
                            API.StopTween()
                            return
                        end
                        runtime.hitTargets = { { enemy, enemy.Head } }
                        runtime.gunTargets = { enemy.Head }
                        API.EquipWeapon("Melee")
                        API.Attack()
                    until enemy.Humanoid.Health <= 0
                else
                    repeat
                        local anchor = enemy.HumanoidRootPart.CFrame
                        task.wait(runtime.attackDelay)
                        healthPercent = runtime.humanoid.Health / runtime.humanoid.MaxHealth * 100
                        if healthPercent <= 50 then
                            return
                        end
                        if (enemy.HumanoidRootPart.Position - islandPosition).Magnitude > 2000 then
                            break
                        end
                        local distance = (enemy.HumanoidRootPart.Position - runtime.rootPart.Position).Magnitude
                        if distance > 50 then
                            API.TP(anchor + anchor.UpVector * 30, queueLabel, false, nil, nil, enemy)
                            API.AddVelocity()
                        end
                        if not queueOwns(queueLabel) then
                            API.StopTween()
                            return
                        end
                        enemy.HumanoidRootPart.CFrame = anchor
                        API.BringMob(anchor, enemy.Name, true)
                        table.insert(runtime.hitTargets, { enemy, enemy.Head })
                        table.insert(runtime.gunTargets, enemy.Head)
                        API.EquipWeapon("Melee")
                        API.Attack()
                    until enemy.Humanoid.Health <= 0
                end
            end
        end
    end

