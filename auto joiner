    -- ============ FIX LOADISLANDS CRASH ============
    -- `.WorldPivot` CHI ton tai tren Model. Map.MysticIsland gio co ca Folder
    -- ("Chests"), va doc .WorldPivot tren Folder la THROW - keo chet Startup,
    -- nen khong co UI va khong gi chay ca:
    --   "Startup failed: WorldPivot is not a valid member of Folder
    --    Workspace.Map.MysticIsland.Chests"
    --
    -- Doc theo thu tu KHONG phu thuoc kieu: GetPivot() (Model va BasePart deu
    -- co) -> .WorldPivot -> CFrame cua mot BasePart con. Khong doc duoc thi tra
    -- nil, va caller BO QUA child do thay vi chet.
    function API.PivotOf(instance)
        if instance == nil then
            return nil
        end
        local ok, pivot = pcall(function()
            return instance:GetPivot()
        end)
        if ok and typeof(pivot) == "CFrame" then
            return pivot
        end
        ok, pivot = pcall(function()
            return instance.WorldPivot
        end)
        if ok and typeof(pivot) == "CFrame" then
            return pivot
        end
        local partOk, part = pcall(function()
            return instance:FindFirstChildWhichIsA("BasePart", true)
        end)
        if partOk and part ~= nil then
            return part.CFrame
        end
        return nil
    end

