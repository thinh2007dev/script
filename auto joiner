    local function featureConnectionScopeIsActive(scope)
        return scope ~= nil
            and scope.active == true
            and runtime.featureConnectionScopes[scope.owner] == scope
            and runtime.running
            and runtime.enabled
    end

    local function drainFeatureConnectionScope(scope)
        local entries = scope.entries
        scope.entries = {}
        for _, entry in ipairs(entries) do
            pcall(function()
                entry.connection:Disconnect()
            end)
            if entry.onDisconnect then
                pcall(entry.onDisconnect)
            end
        end
    end

    local function closeFeatureConnectionScope(scope)
        if not scope then
            return
        end
        scope.active = false
        if runtime.featureConnectionScopes[scope.owner] == scope then
            runtime.featureConnectionScopes[scope.owner] = nil
        end
        drainFeatureConnectionScope(scope)
    end

    local function beginFeatureConnectionScope(owner)
        closeFeatureConnectionScope(runtime.featureConnectionScopes[owner])
        local scope = {
            owner = owner,
            active = true,
            entries = {},
        }
        runtime.featureConnectionScopes[owner] = scope
        return scope
    end

    local function connectFeatureSignal(scope, signal, callback, onDisconnect)
        if not featureConnectionScopeIsActive(scope) then
            if onDisconnect then
                pcall(onDisconnect)
            end
            return nil
        end
        local connection = signal:Connect(function(...)
            if featureConnectionScopeIsActive(scope) then
                callback(...)
            end
        end)
        if not featureConnectionScopeIsActive(scope) then
            pcall(function()
                connection:Disconnect()
            end)
            if onDisconnect then
                pcall(onDisconnect)
            end
            return nil
        end
        table.insert(scope.entries, {
            connection = connection,
            onDisconnect = onDisconnect,
        })
        return connection
    end

    local function clearFeatureConnectionScopes()
        runtime.featureGeneration += 1
        local scopes = {}
        for owner, scope in pairs(runtime.featureConnectionScopes) do
            runtime.featureConnectionScopes[owner] = nil
            scope.active = false
            table.insert(scopes, scope)
        end
        for _, scope in ipairs(scopes) do
            drainFeatureConnectionScope(scope)
        end
        runtime.raid.islandConnection = nil
    end

    -- ============ NHAN QUEST 1 LAN, KHONG SPAM ============
    -- MOI cho goi StartQuest deu phai qua day. Bang chung "da nhan" la CHINH
    -- LENH DA GUI, khong phai bang quest tren man hinh. Tin no den khi server
    -- bao QUEST COMPLETED! (questCompletedTick) hoac qua 5 phut (chet = mat quest).
    -- Tra ve true = da nhan roi, dung ban nua.
    -- Bang quest dang hien ten quai nay? KHONG dung `.Visible`: bang co the bi
    -- thu gon (nut "+") trong khi quest van chay, luc do Visible = false ma
    -- quest van dang tinh - doc theo Visible la luon ket luan "chua nhan".
    -- So sanh khong phan biet hoa thuong, va thu ca dang so nhieu vi game viet
    -- "Defeat 8 Posessed Mummys".
    -- DOC CA BANG QUEST, khong bam mot duong dan cung. Duong
    -- Main.Quest.Container.QuestTitle.Title chi dung voi mot kieu bang; game
    -- doi bo cuc la doc khong ra, va luc do script ket luan "chua nhan" roi
    -- ban StartQuest lai - moi lan ban la RESET bo dem ve 0.
    -- CHI DUNG DE XAC NHAN. Tra ve false khong co nghia la mat quest.
    function API.QuestTitleCoversMob(mobName)
        if mobName == nil then
            return false
        end
        local singular = string.lower(tostring(mobName))
        local forms = {
            singular,
            singular .. "s",
            singular .. "es",
            (singular:gsub("y$", "ies")),
        }
        local function covers(text)
            if type(text) ~= "string" or text == "" then
                return false
            end
            local shown = string.lower(text)
            for _, form in ipairs(forms) do
                if string.find(shown, form, 1, true) ~= nil then
                    return true
                end
            end
            return false
        end

        -- ============ FIX CHET LA NHAN LAI QUEST ============
        -- BANG SONG TRUOC. Main.Quest bi stale - do duoc tren acc lv376 no van
        -- ghi "DEFEAT 5 BANDITS (0/5)" tu hoi acc con lv1. Doc no truoc thi co
        -- the ket luan "dang co quest con quai nay" cho mot quest het tu lau,
        -- roi bo qua buoc nhan quest that.
        local trackedMob = API.TrackedQuest ~= nil and API.TrackedQuest() or nil
        if trackedMob ~= nil then
            return covers(trackedMob)
        end

        local ok, text = pcall(function()
            return LocalPlayer.PlayerGui.Main.Quest.Container.QuestTitle.Title.Text
        end)
        if ok and covers(text) then
            return true
        end

        local found = false
        pcall(function()
            local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local main = playerGui and playerGui:FindFirstChild("Main")
            local panel = main and main:FindFirstChild("Quest")
            if panel == nil then
                return
            end
            for _, child in ipairs(panel:GetDescendants()) do
                if (child:IsA("TextLabel") or child:IsA("TextButton"))
                    and covers(child.Text)
                then
                    found = true
                    return
                end
            end
        end)
        return found
    end
    local function questTitleCoversMob(mobName)
        return API.QuestTitleCoversMob(mobName)
    end

    -- SO HUU QUEST TINH THEO CON QUAI, khong theo quest_name#num.
