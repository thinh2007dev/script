    function API.NoClip(mode)
        if mode ~= "on" then
            if not runtime.noClipEnabled then
                return
            end
            if runtime.noClipConnection then
                runtime.noClipConnection:Disconnect()
                runtime.noClipConnection = nil
            end
            runtime.noClipEnabled = false
            return
        end

        local character = LocalPlayer.Character
        if character == nil then
            return
        end
        -- R6 KHONG CO LowerTorso/UpperTorso, chi co Torso. Goi thang ten cua
        -- R15 la loi "LowerTorso is not a valid member" va chet ca Startup.
        for _, name in ipairs({ "LowerTorso", "UpperTorso", "Torso" }) do
            local part = character:FindFirstChild(name)
            if part ~= nil and part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
        if runtime.noClipEnabled then
            return
        end

        if runtime.noClipInitialized then
            for _, child in ipairs(runtime.rootPart:GetChildren()) do
                if isNamedMover(child) then
                    child:Destroy()
                end
            end
        else
            for _, child in ipairs(character:GetDescendants()) do
                if child:IsA("BasePart") then
                    if child.CanCollide then
                        child.CanCollide = false
                    end
                elseif isNamedMover(child) then
                    child:Destroy()
                end
            end
            runtime.noClipInitialized = true
        end

        runtime.noClipConnection = runtime.rootPart.ChildAdded:Connect(destroyNamedMover)
        runtime.noClipEnabled = true
    end

