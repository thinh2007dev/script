    -- Khong tin cai nao la dung san: thu lan luot, cai nao lam nhan vat dich
    -- chuyen thi cai do dung.
    function API.EntranceGateList(name)
        local list = {}
        local function add(position)
            if typeof(position) ~= "Vector3" then
                return
            end
            for _, existing in ipairs(list) do
                if (existing - position).Magnitude <= 50 then
                    return
                end
            end
            table.insert(list, position)
        end
        local gates = ENTRANCE_GATES[getSea(game.PlaceId)]
        add(gates ~= nil and gates[name] or nil)
        local part = API.EntrancePart(name)
        if part ~= nil then
            local pivot = API.PivotOf(part)
            add(pivot ~= nil and pivot.Position or nil)
        end
        local landing = runtime.requestIslands[name]
        add(landing ~= nil and landing.Position or nil)
        return list
    end

