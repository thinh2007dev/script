    -- Lay dong co level_req LON NHAT ma van <= level, va nho luon dong thap
    -- nhat. Khong bao gio tra ve dong cao hon level.
    local function pickRowByLevel(rows, level)
        local best, lowest = nil, nil
        for _, row in ipairs(rows) do
            local required = tonumber(row.level_req)
            if required ~= nil then
                if lowest == nil or required < tonumber(lowest.level_req) then
                    lowest = row
                end
                if required <= level
                    and (best == nil or required > tonumber(best.level_req))
                then
                    best = row
                end
            end
        end
        return best, lowest
    end

