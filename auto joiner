    local function restoreOwnedNamecallHook(hookState)
        local currentOk, currentNamecall = pcall(function()
            return hookState.metatable.__namecall
        end)
        if not currentOk then
            return false, currentNamecall
        end
        if currentNamecall ~= hookState.installed and currentNamecall ~= hookState.original then
            return false, "namecall hook ownership changed"
        end
        local writeOk = true
        local writeError
        if currentNamecall == hookState.installed then
            writeOk, writeError = pcall(function()
                setreadonly(hookState.metatable, false)
                hookState.metatable.__namecall = hookState.original
            end)
        end
        local readonlyOk, readonlyError = pcall(
            setreadonly,
            hookState.metatable,
            hookState.wasReadonly
        )
        local finalOk, finalNamecall = pcall(function()
            return hookState.metatable.__namecall
        end)
        if not writeOk then
            return false, writeError
        end
        if not readonlyOk then
            return false, readonlyError
        end
        if not finalOk then
            return false, finalNamecall
        end
        if finalNamecall ~= hookState.original then
            return false, "namecall hook restoration incomplete"
        end
        return true
    end

    function API.Hook()
        if runtime.hookInstalled then
            return
        end
        local skillKeys = { Z = true, X = true, C = true, V = true, F = true }
        local rawMetatable = getrawmetatable(game)
        local originalNamecall = rawMetatable.__namecall
        if type(isreadonly) ~= "function" or type(setreadonly) ~= "function" then
            error("readonly metatable APIs unavailable", 0)
        end
        local readonlyOk, wasReadonly = pcall(isreadonly, rawMetatable)
        if not readonlyOk or type(wasReadonly) ~= "boolean" then
            error("unable to determine metatable readonly state", 0)
        end
        local installedNamecall
        installedNamecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local spoofTarget = runtime.hookSpoofTarget
            if spoofTarget and (method == "FireServer" or method == "InvokeServer") then
                local argumentCount = select("#", ...)
                if method == "InvokeServer" and argumentCount == 2 then
                    local key, aim = ...
                    if skillKeys[key] then
                        if typeof(aim) == "CFrame" then
                            return originalNamecall(self, key, spoofTarget.Position)
                        end
                        return originalNamecall(self, key, spoofTarget)
                    end
                elseif method == "FireServer" and argumentCount == 1 and self.Name == "RemoteEvent" then
                    local aim = ...
                    if type(aim) ~= "boolean" then
                        if typeof(aim) == "CFrame" then
                            return originalNamecall(self, spoofTarget.Position)
                        end
                        return originalNamecall(self, spoofTarget)
                    end
                end
            end
            return originalNamecall(self, ...)
        end)
        local hookState = {
            metatable = rawMetatable,
            original = originalNamecall,
            installed = installedNamecall,
            wasReadonly = wasReadonly,
        }
        runtime.hookState = hookState
        runtime.hookInstalled = false
        local installOk, installError = pcall(function()
            setreadonly(rawMetatable, false)
            rawMetatable.__namecall = installedNamecall
            setreadonly(rawMetatable, wasReadonly)
        end)
        if not installOk then
            local rollbackOk, rollbackError = restoreOwnedNamecallHook(hookState)
            if rollbackOk then
                runtime.hookState = nil
                runtime.hookInstalled = false
            end
            if not rollbackOk then
                error(tostring(installError) .. " | hook rollback failed: " .. tostring(rollbackError), 0)
            end
            error(installError, 0)
        end
        runtime.hookInstalled = true
    end

