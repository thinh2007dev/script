    -- Co trai NAO dang cho nhat that khong. fruitTracker.count van dem ca trai
    -- dang bi hen lai 60 giay (nhat hut) - lay no lam dieu kien day queue thi
    -- job Get Fruits (uu tien 13, tren Auto Farm Level 1) om queue suot ma
    -- controller khong co gi de lam: dung im giua bai, dung cai ket o lv2163.
    -- Ten model ngoai map da cho biet loai trai tu xa (vd. "Smoke Fruit").
    -- Doi thang sang key trong kho, khong can bay toi/cam len tay moi nhan dang.
    local function worldFruitStorageKey(fruitModel)
        local name = fruitModel and tostring(fruitModel.Name) or ""
        local fruitName = name:match("^(.-)%s+Fruit$")
        if fruitName == nil or fruitName == "" then
            return nil
        end
        return fruitName .. "-" .. fruitName
    end

    local function fruitAlreadyStored(fruitModel)
        local storageKey = worldFruitStorageKey(fruitModel)
        local physical = runtime.inventory.PhysicalMoveset
        local stored = storageKey and physical and physical[storageKey]
        return stored ~= nil and (tonumber(stored.Count) or 0) > 0
    end
