    function API.HandleMelees()
        local equippedMelee = runtime.tools.Melee
        if runtime.meleeIndex == nil then
            if typeof(equippedMelee) == "Instance" and equippedMelee.Name ~= "Combat" then
                runtime.meleeIndex = runtime.savedMeleeIndex
            else
                runtime.meleeIndex = 1
            end
        end
        if runtime.meleeIndex > #runtime.meleeDefinitions then
            return
        end

        local rowIndex = runtime.meleeIndex
        local row = runtime.meleeDefinitions[rowIndex]
        -- SO HUU, khong phai "dang cam". Tu khi co xoay melee thi mon tren tay
        -- co the la mon khac; lay "dang cam" lam bang chung so huu se lam
        -- HandleMelees di mua lai mon da co trong tui.
        local ownedMelee = meleeToolByName(row.Name)
        if ownedMelee ~= nil then
            runtime.queue:pop("Buy Melee")
            row.Level = toolLevel(ownedMelee)
            if row.Level >= 400 then
                row.Done = true
                mergeMeleeSave(row.Name, {
                    Level = row.Level, Bought = true,
                    MasteryDone = true, Done = true,
                })
                writeMeleeSave()
                runtime.meleeIndex += 1
            end
            return
        end

        -- ============ FIX BO QUA MELEE CHUA MUA DUOC ============
        -- Mon o con tro chua mua duoc thi XEM MON KE TIEP, roi ke tiep nua.
        -- Truoc day gap mot mon `Done = false` la `return` luon, nen ca chuoi
        -- mua dung han o do: Electro can Lightning Bolt, Sharkman Karate can
        -- Water Key, Death Step can Library Key, Dragon Talon can Fire Essence.
        -- Vi du that: Black Leg du 400 -> con tro sang Electro -> dinh o day,
        -- Fishman Karate phia sau khong bao gio duoc mua du du tien.
        --
        -- KHONG mua duoc mon nao nua thi tha queue ra va cu farm bang melee
        -- hien tai - dung cach da lam voi Dragon Talon.
        local function buyableNow(candidate)
            return candidate.Done == true
                and table.find(candidate.Sea, game.PlaceId) ~= nil
                and LocalPlayer.Data.Beli.Value >= (tonumber(candidate.Price) or 0)
                and LocalPlayer.Data.Fragments.Value >= (tonumber(candidate.Fragment) or 0)
        end

        if not buyableNow(row) then
            -- Van bao thieu Fragment nhu cu, de cac he thong khac biet ma di
            -- gom Fragment thay vi im lang.
            if row.Done == true
                and LocalPlayer.Data.Fragments.Value < (tonumber(row.Fragment) or 0)
            then
                runtime.fragmentShortage = true
            end
            local pickedIndex = nil
            for index = rowIndex + 1, #runtime.meleeDefinitions do
                local candidate = runtime.meleeDefinitions[index]
                if meleeToolByName(candidate.Name) == nil
                    and buyableNow(candidate)
                then
                    pickedIndex = index
                    break
                end
            end
            if pickedIndex == nil then
                runtime.queue:pop("Buy Melee")
                return
            end
            rowIndex = pickedIndex
            row = runtime.meleeDefinitions[rowIndex]
            if runtime.meleeBuySaidFor ~= row.Name then
                runtime.meleeBuySaidFor = row.Name
                print(("buy melee | %s chua mua duoc - mua %s truoc"):format(
                    tostring(runtime.meleeDefinitions[runtime.meleeIndex].Name),
                    tostring(row.Name)))
            end
        end

        local remoteName = row.Name:gsub(" ", "")
        -- Game moi: BuyElectro(true) chi la CHECK. Mua that phai goi
        -- BuyElectro() khong tham so; Lightning Bolt va $500k duoc xu ly trong
        -- chinh lenh mua. DeliverLightningBolt chi danh cho acc DA BIET Electro.
        local function buyMeleeRemote()
            if remoteName == "DragonClaw" then
                return runtime.commF:InvokeServer("BlackbeardReward", remoteName, "2")
            end
            if remoteName ~= "Electro" then
                return runtime.commF:InvokeServer("Buy" .. remoteName)
            end
            return runtime.commF:InvokeServer("BuyElectro")
        end
        -- ============ FIX BO QUA MELEE CHUA MUA DUOC ============
        -- Ba chot cu (dung sea / du tien / row.Done) da gop het vao buyableNow
        -- o tren, va gio ap dung cho CA mon duoc chon thay. Khac biet duy nhat:
        -- chot tien truoc day chi xet o lan mua DAU (`row.Level == 0`), gio xet
        -- luon - khong bay toi NPC khi trong tui khong du tien.
        local firstPurchase = row.Level == 0

        if runtime.queue:empty() or runtime.queue:top() == "Buy Melee" then
            -- HandleMelees chay tu EvaluateMainFeatures, vong lap task.wait(0.01)
            -- -> truoc day ban remote mua ~30 lan/giay. NPC chan spam va tra
            -- "Try again soon." mai mai. Mot lan mua moi 3 giay.
            if tick() - (runtime.meleeBuyAt or 0) < 3 then
                return
            end
            runtime.meleeBuyAt = tick()
            if runtime.meleeBuyTriesFor ~= row.Name then
                runtime.meleeBuyTriesFor = row.Name
                runtime.meleeBuyTries = 0
            end
            if firstPurchase then
                print("frag: ", LocalPlayer.Data.Fragments.Value)
            end
            local npcCFrame = API.GetNPCCFrame(row.NPC)
            API.ResetToIsland(npcCFrame)
            API.TP(npcCFrame, "Buy Melee")
            buyMeleeRemote()
            -- Chi ghi "da mua" khi mon do THAT SU vao tui. Truoc day ghi vo dieu
            -- kien nen file save bao da mua trong khi chua he mua duoc.
            if LocalPlayer.Backpack:WaitForChild(row.Name, 2) == nil then
                runtime.meleeBuyTries = (runtime.meleeBuyTries or 0) + 1
                if runtime.meleeBuyTries >= 10 then
                    runtime.meleeBuyTries = 0
                    runtime.queue:pop("Buy Melee")
                    -- ============ FIX BO QUA MELEE CHUA MUA DUOC ============
                    -- CHI nhich con tro khi dang lam DUNG mon o con tro. Neu
                    -- day la mon duoc chon thay (nhay qua mon dang bi chan) thi
                    -- nhich con tro se lam mat cho cua mon bi chan.
                    if rowIndex == runtime.meleeIndex then
                        runtime.meleeIndex += 1
                    end
                    print("buy melee | " .. row.Name
                        .. " mua khong duoc, bo qua de khong ket queue")
                    API.StopTween()
                end
                return
            end
            runtime.meleeBuyTries = 0
            row.Done = true
            mergeMeleeSave(row.Name, { Level = 1, Bought = true, Done = true })
            writeMeleeSave()
        else
            runtime.queue:push("Buy Melee", runtime.queuePriorities["Buy Melee"])
        end
    end

