    runtime.controllers.Hop = function(queueLabel, hopWhenExhausted, toolName)
        if not runtime.humanoid or not runtime.rootPart then
            return
        end
        local state = runtime.hopState
        if not state.intial_check then
            state.intial_check = true
            if LocalPlayer:GetAttribute("CurrentLocation") then
                local nearestDistance = math.huge
                local nearestName
                for _, islandName in ipairs(state.islandNames) do
                    local island = Services.Workspace.Map[islandName]
                    local distance = (island.WorldPivot.Position - runtime.rootPart.Position).Magnitude
                    if distance < nearestDistance then
                        nearestDistance = distance
                        nearestName = islandName
                    end
                end
                table.insert(state.current_location, nearestName)
            end
        end

        local tool = runtime.carried[toolName]
        if tool.Backpack or tool.Character then
            if table.find(XeroQuestData.PlaceIds[2], game.PlaceId) then
                API.TP(CFrame.new(-12548.998046875, 332.40396118164, -7603.1865234375), queueLabel, true)
            else
                API.TP(CFrame.new(-379.70889282227, 73.0458984375, 304.84692382813), queueLabel, true)
            end
            return
        end

        local touchedChest = false
        for _, chest in ipairs(runtime.chests) do
            if not queueOwns(queueLabel) then
                API.StopTween()
                return
            end
            tool = runtime.carried[toolName]
            if tool.Backpack or tool.Character then
                API.StopTween()
                return
            end
            if chest.Parent and chest:IsDescendantOf(Services.Workspace) then
                touchedChest = true
                API.TP(chest.WorldPivot, queueLabel, false)
                local startedAt = tick()
                repeat
                    task.wait()
                    runtime.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                until tick() - startedAt > 0.3
            end
        end
        if touchedChest then
            return
        end

        local moved = false
        for _, islandName in ipairs(state.islandNames) do
            if not queueOwns(queueLabel) then
                API.StopTween()
                return
            end
            tool = runtime.carried[toolName]
            if tool.Backpack or tool.Character then
                API.StopTween()
                return
            end
            if not table.find(state.current_location, islandName) then
                moved = true
                API.TP(Services.Workspace.Map[islandName].WorldPivot, queueLabel, false)
                table.insert(state.current_location, islandName)
                return
            end
        end
        if not moved then
            if hopWhenExhausted then
                API.HopServer(nil, true)
            else
                table.clear(state.current_location)
            end
        end
    end

