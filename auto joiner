    function API.Notify(eventName, ...)
        if eventName ~= "Notify" then
            return
        end
        local values = { ... }
        if string.find(values[1], "QUEST COMPLETED!") then
            -- Tin hieu duy nhat dang tin cay cho "quest da xong". Ban ghi quest
            -- cu het hieu luc tu day, va cho phep nhan quest moi NGAY - khong
            -- bat cho het chot 5 giay roi danh khong cong ca quang do.
            local already = runtime.questCompletedTick
            local fresh = already == nil or tick() - already > 3
            runtime.questCompletedTick = tick()
            if not fresh then
                -- Cung mot lan xong quest bao ve hai lan: bo qua, neu khong
                -- preferPreviousQuest lat hai lan = khong doi bai.
                return
            end
            runtime.questTaken = nil
            runtime.lastQuestStartedAt = 0
            if runtime.queue:empty() then
                return
            end
            if runtime.queue:top() == "Auto Farm Level" then
                runtime.preferPreviousQuest = not runtime.preferPreviousQuest
            end
        elseif string.find(values[1], "WELL DONE!") then
            runtime.meleeProgress["Electric Claw"].Done = true
        end
    end

