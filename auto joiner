                                or evil == -3
                                or evil == 1
                                or evil == -4
                                or ((good == 1 or good == -4) and runtime.bossScanPrimed)
                                or ((good == 2 or good == -5)
                                    and (heavenlyActive or cakeQueenAvailable))
                                or ((evil == 2 or evil == -5)
                                    and (hellActive
                                        or soulReaperAvailable
                                        or hallowEssenceCarried
                                        or runtime.dragonTalonBonesBought))
                                or (good >= 3 and evil >= 3)

                            local shouldRefreshQuest = not needsCDK
                                and ((good == -4 and not runtime.bossScanPrimed)
                                    or (good == -5
                                        and not heavenlyActive
                                        and not cakeQueenAvailable)
                                    or (evil == -5
                                        and not hellActive
