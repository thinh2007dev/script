    -- ve khong phan biet duoc "thanh cong" voi "tu choi", nen tuyet doi khong
    -- ghi Done theo no.
    local function fireSubmit(row)
        if row.Accept ~= nil then
            pcall(function()
                runtime.commF:InvokeServer(row.Accept)
            end)
            task.wait(0.3)
        end
        pcall(function()
            runtime.commF:InvokeServer(table.unpack(row.args))
        end)
        task.wait(0.4)
        return not carriesItem(row.Key)
    end

    function API.SubmitMeleeKeys()
        for meleeName, row in pairs(MeleeKeySubmit) do
            local progress = runtime.meleeProgress[meleeName]
            if progress ~= nil
                and progress.Done ~= true
                and carriesItem(row.Key)
                and tick() - (runtime.keySubmitAt or 0) > 3
            then
                runtime.keySubmitAt = tick()
                -- Thay lay ca do VA tien trong cung mot lenh (Mad Scientist:
                -- ngoc + 500k). Thieu tien thi bay toi chi to n mot chuyen -
                -- giu lai, cho du beli.
                if row.Price ~= nil
                    and LocalPlayer.Data.Beli.Value < row.Price
                then
                    if tick() - (runtime.keyPriceSaidAt or 0) > 120 then
                        runtime.keyPriceSaidAt = tick()
                        print(("melee | dang cam %s nhung thieu tien %s (%d/%d)")
                            :format(row.Key, meleeName,
                                LocalPlayer.Data.Beli.Value, row.Price))
                    end
                    return
                end
                -- Thu tai cho truoc: mien phi, khong ton chuyen bay.
                if fireSubmit(row) then
                    progress.Done = true
                    runtime.meleeBuyAt = 0
                    -- ============ FIX SEA2 KEY + HOP POLICY ============
                    -- Key BIEN MAT la bang chung duy nhat. Dong moc vinh vien
                    -- ngay day, khong thi phien sau lai di san boss.
                    if API.Sea2KeyMarkDone ~= nil then
                        API.Sea2KeyMarkDone(row.Key, "da nop cho teacher")
                    end
                    print(("melee | da nop %s -> mo khoa %s"):format(
                        row.Key, meleeName))
                    return
                end
                -- Bi tu choi tu xa: phai den tan NPC. Chi lam khi queue ranh,
                -- va khong giu queue.
                local npcFrame = API.GetNPCCFrame(progress.NPC)
                if npcFrame == nil or npcFrame.Position.Magnitude < 1 then
                    return
                end
                if runtime.rootPart ~= nil
                    and (npcFrame.Position - runtime.rootPart.Position).Magnitude > 12
                then
                    if runtime.queue:empty()
                        or QueuePriorities[runtime.queue:top()]
                            <= QueuePriorities["Buy Melee"]
                    then
                        setStatus("Buy Melee | Nop " .. row.Key)
                        API.TP(npcFrame, "Buy Melee")
                        API.StopTween()
                    end
                    return
                end
                if fireSubmit(row) then
                    progress.Done = true
                    runtime.meleeBuyAt = 0
                    print(("melee | da nop %s -> mo khoa %s"):format(
                        row.Key, meleeName))
                end
                return
            end
        end
    end

