local function deepCopy(value)
    if type(value) ~= "table" then
        return value
    end
    local output = {}
    for key, child in next, value do
        output[deepCopy(key)] = deepCopy(child)
    end
    return output
end

local function fillConfigDefaults(target, defaults)
    for key, value in pairs(defaults) do
        local current = target[key]
        if current == nil or type(current) ~= type(value) then
            target[key] = value
        elseif type(value) == "table" then
            fillConfigDefaults(current, value)
        end
    end
end

local function fruitStorageName(configuredName)
    if configuredName == "" then
        return ""
    end
    local firstWord = configuredName:match("(%S+)")
    return firstWord .. "-" .. firstWord
end

