    -- ============ FIX BONE FARM / RANDOM ============
    -- MOT NOI DUY NHAT doc ("Bones","Check"). Auto Farm Bone, Random Bone,
    -- Tracker va cooldown deu doc chung runtime.bonesCheck - khong ai tu doan.
    --
    -- HAI NGUON KHAC NHAU, do bang MCP tren sever that:
    --   SO LUOT  <- Bones/Check, vi tri POS5.
    --   SO BONE  <- INVENTORY, khong phai Bones/Check.
    -- Bones/Check tra 5 gia tri (POS1=0, POS2=bang, POS3=0, POS4="00:06",
    -- POS5=luot). Luc do acc dang giu 631 bone ma CA POS1 va POS3 deu = 0:
    -- remote nay khong he cho so bone. Lay POS1 lam so bone chinh la loi bang
    -- bao "BONE 0/500" roi cay mai khong bao gio quay.
    --
    -- Ngoai Sea 3, remote nay tra ve KHONG gia tri nao (da do o sea 2) nen
    -- khong goi va khong canh bao - do la im lang binh thuong, khong phai loi.
    --
    -- nil KHAC 0. nil = chua doc duoc; 0 = server xac nhan het luot. Doc loi thi
    -- GIU cache cu, khong bien thanh 0, khong ghi cooldown, khong ket luan het.

    -- Doc runtime.progress.Material - bang ma RefreshMaterials dung lai. KHONG
    -- dung inventoryCount(): ham do doc runtime.inventory, mot bang khac, va
    -- do la ly do duong du phong trong RollBonesAll cung hut.
    -- Ten that trong inventory la "Bones [Material-572]", nhung RefreshMaterials
    -- danh chi muc theo ca StorageKey va Name nen "Bones" cung tra duoc.
    local function boneInventoryCount()
        local group = runtime.progress ~= nil and runtime.progress.Material or nil
        if type(group) ~= "table" then
            return nil
        end
        local row = group.Bones
        if type(row) == "table" and tonumber(row.Count) ~= nil then
            return tonumber(row.Count)
        end
        for key, entry in pairs(group) do
            if type(entry) == "table" and tonumber(entry.Count) ~= nil then
                local name = string.lower(tostring(entry.Name or entry.StorageKey or key))
                if string.find(name, "bone", 1, true) ~= nil then
                    return tonumber(entry.Count)
                end
            end
        end
        -- Doc duoc bang ma khong co dong bone -> that su 0 (inventory bo qua
        -- item Count = 0), khong phai "chua biet".
        return 0
    end

    function API.RefreshBonesCheck(force)
        if API.RefreshMaterials ~= nil then
            API.RefreshMaterials()
        end
        if runtime.sea ~= 3 then
            local kept = runtime.bonesCheck
            return kept and kept.bones or nil, kept and kept.rolls or nil
        end
        local now = tick()
        local cache = runtime.bonesCheck
        -- 10 giay binh thuong. Het luot ma cooldown con dai thi noi TTL ra 60
        -- giay: khong co gi de hoc them, va bang van dem nguoc bang os.time().
        local ttl = 10
        if cache ~= nil
            and (tonumber(cache.rolls) or 1) <= 0
            and API.BoneRollCooldownLeft ~= nil
            and API.BoneRollCooldownLeft() > 60
        then
            ttl = 60
        end
        if not force and cache ~= nil and now - cache.at < ttl then
            return cache.bones, cache.rolls
        end

        local packed = table.pack(pcall(
            runtime.commF.InvokeServer,
            runtime.commF,
            "Bones",
            "Check"
        ))
        if packed[1] ~= true then
            return cache and cache.bones or nil, cache and cache.rolls or nil
        end
        -- packed[1] la co cua pcall, nen POSn nam o packed[n + 1].
        -- SO BONE lay tu inventory, KHONG lay tu tuple nay.
        local boneCount = boneInventoryCount()
        local rollCount = tonumber(packed[6])
        if rollCount == nil then
            -- Sever doi hinh dang tuple: lay so nguyen 0..10 gan CUOI nhat, va
            -- khong bao gio xet packed[2] (POS1) - gia tri do khong ro nghia va
            -- do duoc la 0, lay lam luot thi thanh "het luot" gia.
            for index = packed.n, 3, -1 do
                local value = tonumber(packed[index])
                if value ~= nil
                    and value == math.floor(value)
                    and value >= 0
                    and value <= 10
                then
                    rollCount = value
                    break
                end
            end
        end
        if boneCount == nil or rollCount == nil then
            if not runtime.bonesCheckDumped then
                runtime.bonesCheckDumped = true
                warn(("bones | Bones/Check tra ve %d gia tri, khong doc ra"
                    .. " bone/luot - giu cache cu (rolls = chua biet)"):format(
                    math.max(0, packed.n - 1)))
            end
            return cache and cache.bones or nil, cache and cache.rolls or nil
        end

        runtime.bonesCheck = { at = now, bones = boneCount, rolls = rollCount }
        runtime.bonesRollAvailable = rollCount > 0

        if rollCount > 0 then
            -- Da THAY co luot trong phien nay - dieu kien de sau nay duoc dam
            -- moc cooldown. Va server cap lai som thi bo cooldown ngay, khong
            -- doi timer local.
            runtime.boneRollSeenAvailable = true
            if runtime.boneRollResetAt ~= nil then
                runtime.boneRollResetAt = nil
                print(("bones | co lai %d luot - bo cooldown, farm bone tiep")
                    :format(rollCount))
            end
        elseif runtime.boneRollSeenAvailable == true
            and runtime.boneRollResetAt == nil
        then
            -- CHI dam moc khi chinh script quan sat duoc luc allowance can:
            -- thay rolls > 0 truoc, roi thay ve 0. Vua vao game da thay 0 thi
            -- khong biet het tu luc nao - dam "vua het bay gio" la dem nguoc sai.
            runtime.boneRollSeenAvailable = false
            local window = tonumber(runtime.configs["Bone Roll Cooldown"]) or 7200
            runtime.boneRollResetAt = os.time() + window
            print(("bones | het luot, con %d bone - dem nguoc %d phut"):format(
                math.floor(boneCount), math.floor(window / 60)))
        end
        return boneCount, rollCount
    end

    -- Con bao nhieu giay nua co luot lai. CHI DE HIEN THI / fallback. Nguon
    -- quyet dinh luon la rolls tu server.
    function API.BoneRollCooldownLeft()
        local readyAt = tonumber(runtime.boneRollResetAt)
        if readyAt == nil then
            return 0
        end
        return math.max(0, readyAt - os.time())
    end

    local boneMobNames = { "Reborn Skeleton", "Living Zombie", "Demonic Soul", "Posessed Mummy" }

    -- ============ FIX BONE FARM / RANDOM ============
    -- Danh sach bai xuong doc TU runtime.quests, sap theo moc quest tang dan.
    -- Khong hardcode 2074: bai CHINH la phan tu cuoi = moc cao nhat ma level
    -- hien tai nhan duoc (lv2000 -> Living Zombie, lv2025 -> Demonic Soul,
    -- lv2050+ -> Posessed Mummy).
    --
    -- Chi nhan bai CO TOA DO trong mobPositions, de vong xoay khong bao gio tro
    -- vao mot bai khong bay toi duoc.
    local function boneCampOrder(level)
        local rows = {}
        for _, row in ipairs(runtime.quests) do
            local required = tonumber(row.level_req)
            if required ~= nil
                and required <= level
                and table.find(boneMobNames, row.mob_name) ~= nil
                and runtime.mobPositions[row.mob_name] ~= nil
            then
                local seen = false
                for _, kept in ipairs(rows) do
                    if kept.mob == row.mob_name then
                        seen = true
                        break
                    end
                end
                if not seen then
                    table.insert(rows, { mob = row.mob_name, level = required })
                end
            end
        end
        table.sort(rows, function(a, b)
            return a.level < b.level
        end)
        return rows
    end

    -- Con quai DUNG TEN bai nay con song quanh bai khong. 600 studs: rong hon
    -- ban kinh gom (350) mot chut de khong bo sot con bi keo ra mep.
    local function boneCampLiveCount(mobName, campSpot)
        local enemies = Services.Workspace:FindFirstChild("Enemies")
        if enemies == nil then
            return 0
        end
        local count = 0
        for _, enemy in ipairs(enemies:GetChildren()) do
            if enemy.Name == mobName then
                local humanoid = enemy:FindFirstChild("Humanoid")
                local root = enemy:FindFirstChild("HumanoidRootPart")
                if humanoid ~= nil
                    and root ~= nil
                    and humanoid.Health > 0
                    and (campSpot == nil
                        or (root.Position - campSpot.Position).Magnitude <= 600)
                then
                    count += 1
                end
            end
        end
        return count
    end

    -- ============ FIX BONE FARM / RANDOM ============
    -- LUON nhan MOC CAO NHAT ma level nhan duoc: lv2000 -> 2000, lv2025 ->
    -- 2025, lv2050+ -> 2050. KHONG bao gio tu chuyen sang moc thap hon.
    --
    -- Truoc day 2/3 vong no doi sang bai moc THAP hon (do bang MCP: acc lv2717
    -- dang giu HauntedQuest1#1 tuc moc 1975 trong khi bai do co moc 2050).
    -- Doi mob LA doi quest: quest cu bi bo giua duong, quay lai phai nhan lai
    -- tu 0 - do la ly do boneRotateStep = 32 ma questCompletedTick = nil, tuc
    -- 32 lan doi bai va khong xong noi mot quest nao.
    --
    -- Van khong dung im cho respawn: mot mob co NHIEU DIEM (1 NPC 2 bai) trong
    -- mobPositions, nen het con thi sang DIEM KHAC CUA CUNG MOB bang
    -- AdvanceMobSpot. Quest giu nguyen, bo dem khong bi reset.
    --
    -- Tra ve mobName, questLevel, campSpot.
    local BONE_CAMP_RADIUS = 350
    local function boneCurrentCamp(level)
        local rows = boneCampOrder(level)
        if #rows == 0 then
            return nil
        end
        local pick = rows[#rows]

        local spotList = runtime.mobPositions[pick.mob]
        local campSpot = API.PickMobSpot(pick.mob, spotList)

        -- Doi MOB moi la doi moc theo doi. Gio chi doi khi level mo moc cao hon.
        if runtime.boneCurrentCamp ~= pick.mob then
            runtime.boneCurrentCamp = pick.mob
            runtime.boneCampArrived = false
            runtime.boneCampSeenMob = false
            runtime.boneCampEmptySince = nil
        end

        if campSpot ~= nil and runtime.rootPart ~= nil then
            local gap = (campSpot.Position - runtime.rootPart.Position).Magnitude
            if gap <= BONE_CAMP_RADIUS then
                runtime.boneCampArrived = true
            end
        end

        local live = boneCampLiveCount(pick.mob, campSpot)
        if live > 0 then
            -- Con con song -> diem nay chua sach, cu gom va danh tiep.
            runtime.boneCampSeenMob = true
            runtime.boneCampEmptySince = nil
        elseif runtime.boneCampArrived then
            -- CHUA DEN / map chua stream thi cung thay 0 con, nen phai co
            -- boneCampArrived - khong duoc ket luan diem trong qua som.
            runtime.boneCampEmptySince = runtime.boneCampEmptySince or tick()
            -- Sach diem nay -> sang DIEM KHAC CUA CUNG MOB. Khong doi mob nen
            -- quest khong bi nhan lai, va cung khong dung im cho respawn.
            -- Den ma chua he thay con nao thi cho 20 giay (nguoi khac vua gom).
            local seen = runtime.boneCampSeenMob == true
            if tick() - runtime.boneCampEmptySince > (seen and 1 or 20) then
                runtime.boneCampEmptySince = nil
                runtime.boneCampArrived = false
                runtime.boneCampSeenMob = false
                API.AdvanceMobSpot(pick.mob, spotList)
                if tick() - (runtime.boneCampSaidAt or 0) > 5 then
                    runtime.boneCampSaidAt = tick()
                    print(("bones | diem %s %s - sang diem ke, van giu quest"):format(
                        tostring(pick.mob), seen and "sach" or "trong"))
                end
            end
        end
        return pick.mob, pick.level, campSpot
    end

    -- MOT CHU DUY NHAT CHO CA FARM XUONG VA RANDOM: cung mot lan doc server
    -- quyet dinh ca hai viec. Tra ve true = da nhan luot nay.
    local function runBoneStage(level)
        -- ============ FIX BONE FARM / RANDOM ============
        -- Moc level LUON doc tu config, khong hardcode o nhieu noi.
        local boneConfig = runtime.configs["Farm Config"]["Farm Bone Get x2 Exp"]
        if boneConfig == nil then
            return false
        end
        local boneLevel = tonumber(boneConfig.Level) or 2000
        local dragonTalon = runtime.meleeProgress["Dragon Talon"]
        local talonPending = dragonTalon ~= nil and not dragonTalon.Done
        if boneConfig.Enable ~= true
            or level < boneLevel
            or runtime.sea ~= 3
            or runtime.secondSeaErrand   -- dang ve sea 2 lay chia khoa
            or tick() < (runtime.boneRollStallUntil or 0)
        then
            -- Roi dieu kien thi don batch (muc 21.D), khong de treo co.
            runtime.boneRollBatchActive = false
            return false
        end

        -- Chi nhuong cho SubmitMeleeKeys khi con phai mua Dragon Talon. Xong
        -- Talon thi vong quay tiep tuc chay de an x2 EXP.
        if talonPending then
            local essence = runtime.carried["Fire Essence"]
            if essence ~= nil and (essence.Backpack or essence.Character) then
                return false
            end
        end

        -- Mot nguon duy nhat cho ca so xuong va so luot.
        local serverBones, rollsLeft = API.RefreshBonesCheck(false)
        rollsLeft = tonumber(rollsLeft)
        local boneCount = tonumber(serverBones)
            or inventoryCount("Material", "Bones")

        -- rolls == nil la CHUA DOC DUOC, KHONG phai het luot. Khong ban lenh
        -- quay mu, khong ghi cooldown - chi thu doc lai moi 60 giay va tra luot
        -- cho farm lv.
        if rollsLeft == nil then
            runtime.boneRollBatchActive = false
            if tick() >= (runtime.boneProbeAt or 0) then
                runtime.boneProbeAt = tick() + 60
                API.RefreshBonesCheck(true)
            end
            return false
        end
        -- Server xac nhan het luot: khong farm bone, khong random, ve farm lv.
        if rollsLeft <= 0 then
            runtime.boneRollBatchActive = false
            return false
        end

        -- ============ FIX BONE FARM / RANDOM ============
        -- CO x2 EXP THI DI FARM LEVEL, khong farm xuong. Quay xuong la DE LAY
        -- x2 EXP, nen dang co buff ma con cay xuong la tieu buff vao dung cai
        -- viec khong can x2. Het buff moi quay lai cay xuong.
        -- NHUNG dang quay do thi QUAY CHO HET CHUOI. x2 EXP hien ra giua batch
        -- khong duoc lam dung tay: phai xa het roi script moi ghi lai ket qua.
        -- Chi CHUA bat batch thi moi nhuong cho farm level.
        if (tonumber(runtime.expBoostSeconds) or 0) > 0
            and runtime.boneRollBatchActive ~= true
        then
            return false
        end

        -- TARGET = GIA MOT LUOT, roi quay MOT luot va KIEM TRA LAI.
        -- Truoc day target = rollsLeft * 50 (toi da 500) va batch co xa het
        -- luot. Sai o hai cho: mot luot ton 500 chu khong phai 50, va rollsLeft
        -- la SO LUOT TOI DA (luon 10) nen target dinh mai o 500 va sau khi quay
        -- no khong he kiem tra lai - dung cai may thay.
        local need = math.max(50, tonumber(runtime.boneRollCost) or 500)

        -- DU BONE -> DUNG NGAY TAI HAUNTED CASTLE, XA HET LUOT TRONG MOT BATCH.
        -- Batch da bat thi giu nguyen cho den khi het luot: khong quay ve farm
        -- giua batch, khong doi bai, khong reset.
        if runtime.boneRollBatchActive or boneCount >= need then
            if boneCount < need then
                -- Khong con du cho MOT luot. Tra quyen ve farm bone de cay tiep
                -- dung so con thieu.
                runtime.boneRollBatchActive = false
                return false
            end
            if not runtime.boneRollBatchActive then
                runtime.boneRollBatchActive = true
                runtime.boneRollBatchStartedAt = tick()
                print(("bones | du %d/%d bone, %d luot - bat dau random all")
                    :format(math.floor(boneCount), need, rollsLeft))
            end
            setStatus(("Auto Farm Level | Random bone (%d bone, %d luot)"):format(
                math.floor(boneCount), rollsLeft))
            API.StopTween()

            local rolled = API.RollBonesAll()
            local _, afterRolls = API.RefreshBonesCheck(false)
            afterRolls = tonumber(afterRolls)
            if afterRolls ~= nil and afterRolls <= 0 then
                -- Muc 21.A: server xac nhan het luot = batch THANH CONG. Gio moi
                -- cho reset / job khac chay.
                runtime.boneRollBatchActive = false
                runtime.boneRollInFlight = false
                runtime.boneRollBeforeBones = nil
                runtime.boneRollBeforeRolls = nil
                runtime.boneRollVerifyTries = 0
                print("bones | xa het luot - tra quyen cho farm lv")
                return false
            end
            if rolled then
                return true
            end
            -- Muc 21.C: server thuc su tu choi. Nghi 5 phut, KHONG dung im.
            runtime.boneRollBatchActive = false
            runtime.boneRollStallUntil = tick() + 300
            warn("bones | quay khong an - farm lv 5 phut roi thu lai")
            return false
        end

        -- CHUA DU -> farm theo vong xoay bai. Chi truyen DUNG con quai cua bai
        -- dang toi luot: truyen ca 4 ten thi FarmMob tu chon theo mobIndex va di
        -- danh bai khac, vong xoay thanh vo nghia.
        local mobName, questLevel = boneCurrentCamp(level)
        if mobName == nil then
            return false
        end
        setStatus(("Auto Farm Level | Farm Bones %d/%d (%d luot, bai %s)"):format(
            math.floor(boneCount), need, rollsLeft, mobName))
        -- enforceQuest = true: dung he thong quest hien co (co chong spam
        -- StartQuest), khong tu goi StartQuest o day.
        API.FarmMob({ mobName }, "Auto Farm Level", true, questLevel)
        return true
    end

    function API.AutoFarmLevel()
        if not runtime.humanoid or not runtime.rootPart then
            setStatus("Auto Farm Level | Having problems ...")
            return
        end

        setStatus("Auto Farm Level | Farming 1")
        local level = LocalPlayer.Data.Level.Value

        -- ============ HET FRUIT MA THIEU F: DI DANH CAKE ============
        -- Raid la duong kiem F chinh nhung no DOT MOT TRAI da cat kho. Het trai
        -- la khong raid duoc, va luc do nam im cho thi khong bao gio du F.
        --
        -- Duong thu hai: bai quai Cake Land. Giet chung nuoi bo dem 500 con CUA
        -- CA SERVER - day chinh la thu mo tran Cake Prince, ma Cake Prince la
        -- nguon F con lai. Trong luc bo dem chua day thi van len level va ra
        -- tien binh thuong, khong phi thoi gian.
        --
        -- Chi tu lv2200 (bai cake la moc 2200-2275) den 2800; tren 2800 da co
        -- nhanh cake rieng ben duoi. Du F roi thi nhanh nay tu dong tat.
        -- Boss len thi Vip Boss / Farm Boss uu tien cao hon se vao danh, o day
        -- chi lo nuoi bo dem.
        -- 5000 F la de danh cho Godhuman. CO GODHUMAN ROI thi khong con gi phai
        -- gom, giu moc nay nua chi lam acc di danh cake thay vi len level.
        local fragmentsShort = LocalPlayer.Data.Fragments.Value < 5000
            and not ownsGodhumanAlready()
        if level >= 2200
            and level < 2800
            and runtime.sea == 3
            and fragmentsShort
            and not runtime.secondSeaErrand
            and not (API.HasRaidSacrifice and API.HasRaidSacrifice(false))
        then
            setStatus("Auto Farm Level | Cake mobs (het fruit, kiem F qua Cake Prince)")
            API.FarmMob(
                { "Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker" },
                "Auto Farm Level",
                true,
                2274
            )
            return
        end

        -- TREN vat lieu Godhuman: quay het luot chi ton vai giay, con x2 EXP la
        -- do hen gio. De duoi thi Godhuman chua mua la bone stage bi bo doi.
        if runBoneStage(level) then
            return
        end

        if runLevelMaterialPreparation(level) then
            return
        end
        -- Neu acc da lo qua Sea 2/3 khi chua co Electro, LightningBolt se dua
        -- acc ve Sea 1. Dung o day cho toi khi lay xong, neu khong AutoSecondSea
        -- se day acc tro lai Sea 2 ngay khi vua teleport xong.
        local electroTripActive = runtime.meleeSave.ElectroReturnSea ~= nil
            and not runtime.meleeProgress["Electro"].Done
        if level >= 700 and runtime.sea == 1 and not electroTripActive then
            setStatus("Auto Farm Level | Second Sea")
            API.AutoSecondSea()
            return
        end
        if level >= 1500 and runtime.sea == 2 and not runtime.secondSeaErrand then
            if runtime.flamingoAccess or API.GetThirdSeaFruit() ~= nil then
                setStatus("Auto Farm Level | Third Sea")
                API.AutoThirdSea()
                return
            end
        end

        if level >= 2800 then
            setStatus("Auto Farm Level | Cake Island")
            API.FarmMob(
                { "Cookie Crafter", "Cake Guard", "Baking Staff", "Head Baker" },
                "Auto Farm Level",
                true,
                2274
            )
            return
        end

        local farmConfig = runtime.configs["Farm Config"]

        -- MO MAN SEA 1: MOT BAI SKY BANDIT DUY NHAT, LV1 -> LV59.
        -- Truoc day lv<=50 di God's Guard (Y 845) va Shanda (Y 5566), lv<=70
        -- them Royal Squad (Y 5658) - ba tang Sky khac nhau, moi tang mot cong
        -- rieng. Acc lv1 khong qua noi cong nao trong so do nen chi bay lo
        -- lung. Tu lv60 nhanh nay tat, DesertQuest thanh moc binh thuong.
        if farmConfig["First Farm At Sky"] and level < 60 then
            API.FarmMob({ "Sky Bandit" }, "Auto Farm Level")
            return
        end

        local quest = API.GetQuest(level)
        if not quest then
            setStatus("Auto Farm Level | Having problems ...")
            return
        end
        local bossQuest = API.GetBossQuest(level)
        if runtime.preferPreviousQuest then
            local previousQuest = API.GetQuest(quest.level_req - 1)
            if previousQuest
                and previousQuest.quest_name == quest.quest_name
                and (tonumber(previousQuest.level_req) or 0) <= level
            then
                setStatus("Auto Farm Level | Farming 2")
                quest = previousQuest
            end
        end

        local mobPosition = API.PickMobSpot(quest.mob_name, quest.mob_pos)

        -- IsBossAlive, khong phai GetBossCFrame: GetBossCFrame doc ca template
        -- trong ReplicatedStorage nen boss chua spawn van bao "co".
        if bossQuest
            and quest.level_req < bossQuest.level_req
            and API.IsBossAlive(bossQuest.boss_name)
        then
            API.SendStartQuest(
                bossQuest.quest_name,
                bossQuest.quest_num,
                bossQuest.boss_name
            )
            API.FarmBoss(bossQuest.boss_name, "Auto Farm Level")
            return
        end

        if not startLevelQuest(quest) then
            return
        end
        farmNormalLevelQuestOnce(quest, mobPosition)
    end

