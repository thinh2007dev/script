    -- Nang hon: mot lan throw la HUY CA VONG danh gia do, nen quyet dinh di
    -- chuyen khong duoc thuc hien. Loi im lang, chi thay acc lam gi la.
    function API.GetNPCCFrame(name)
        -- FindFirstChild + PivotOf: `Workspace.NPCs` dot-access throw neu map
        -- khong co thu muc do, va `.WorldPivot` throw neu NPC khong la Model.
        local workspaceFolder = Services.Workspace:FindFirstChild("NPCs")
        local replicatedFolder = Services.ReplicatedStorage:FindFirstChild("NPCs")
        local workspaceNPC = workspaceFolder ~= nil
            and workspaceFolder:FindFirstChild(name) or nil
        local replicatedNPC = replicatedFolder ~= nil
            and replicatedFolder:FindFirstChild(name) or nil
        local found = API.PivotOf(workspaceNPC)
            or API.PivotOf(replicatedNPC)
            or runtime.npcFrames[name]
        if found then
            return found
        end
        for _, npc in ipairs(API.SafeNilInstances()) do
            if npc.Name == name then
                local pivot = API.PivotOf(npc)
                if pivot ~= nil then
                    runtime.npcFrames[npc.Name] = pivot
                    return pivot
                end
            end
        end
        return nil
    end

