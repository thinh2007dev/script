    -- ============ GOM CA BAI, VA CA BAI PHAI AN DAME ============
    -- Ba loi chong nhau o day lam chi MOT con an dame:
    --
    -- 1. `if brought >= 1 then return end` - dung sau DUNG MOT con. Goi la
    --    "gom quai" nhung thuc te chi keo them mot con.
    -- 2. `isnetworkowner(enemyRoot)` - Roblox DA BO SimulationRadius khoi
    --    Player, nen sethiddenproperty la vo tac dung va isnetworkowner tra
    --    FALSE cho moi NPC do server mo phong. Chot nay vinh vien sai ->
    --    khong con nao duoc keo vao.
    -- 3. table.clear nam BEN TRONG nhanh do -> khong keo duoc con nao thi
    --    danh sach KHONG BAO GIO duoc xoa, ma vong farm chen them moi vong
    --    (~100Hz). hitTargets phinh vo han, server tu choi ca goi registerHit
    --    -> KHONG con nao an dame, ke ca con dang danh.
    --
    -- Server kiem goi danh theo HITBOX vu khi chu khong theo ai so huu vat ly,
    -- nen con khong so huu van la muc tieu hop le. So huu chi con dung de xoa
    -- van toc - phan duy nhat that su can no.
    function API.BringMob(destination, mobName, allowAnyName, excludedEnemy, radius)
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", 9000000000)
        end)
        -- XOA VO DIEU KIEN, ngay day.
        table.clear(runtime.hitTargets)
        table.clear(runtime.gunTargets)
        -- So theo doi: con nao gom lan truoc ma lan nay khong gom nua thi phai
        -- TRA LAI VAT LY cho no, khong thi no roi xuyen mat dat va mat han.
        local held = runtime.gatheredMobs
        if held == nil then
            held = {}
            runtime.gatheredMobs = held
        end
        local keep = {}
        local reach = tonumber(radius) or 350
        local limit = math.clamp(
            tonumber(runtime.configs["Gather Mobs"]) or 10, 1, 40)
        local brought = 0
        for _, enemy in ipairs(Services.Workspace.Enemies:GetChildren()) do
            if brought >= limit then
                break
            end
            if (excludedEnemy == nil or enemy ~= excludedEnemy)
                and (enemy.Name == mobName or allowAnyName)
            then
                local humanoid = enemy:FindFirstChild("Humanoid")
                local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
                local head = enemy:FindFirstChild("Head")
                if humanoid
                    and enemyRoot
                    and head
                    and humanoid.Health > 0
                    and (enemyRoot.Position - destination.Position).Magnitude <= reach
                then
                    pcall(function()
                        -- KHONG DUOC NEO. Anchored = true la mat quyen so huu
                        -- vat ly, server bo qua moi lenh ghi CFrame cua client
                        -- -> ca dan dung im o cho cu, chi con duy nhat con o
                        -- gan la trung don. Do la loi "chi danh 1 con".
                        enemyRoot.AssemblyLinearVelocity = Vector3.zero
                        enemyRoot.AssemblyAngularVelocity = Vector3.zero
                        enemyRoot.CanCollide = false
                        head.CanCollide = false
                        enemyRoot.CFrame = destination
                        humanoid.PlatformStand = true
                        humanoid.AutoRotate = false
                    end)
                    keep[enemy] = true
                    held[enemy] = true
                    table.insert(runtime.hitTargets, { enemy, head })
                    table.insert(runtime.gunTargets, head)
                    brought += 1
                end
            end
        end
        -- TRA LAI VAT LY cho con nao khong con gom nua. Bo mac chung voi
        -- CanCollide = false + PlatformStand = true la chung roi xuyen mat dat
        -- va mat han (bai rong, ket o "Waiting mob") - chi vong danh moi giu
        -- duoc, ma vong danh thoat ra ngay khi con dau dan chet.
        for enemy in pairs(held) do
            if keep[enemy] == nil then
                pcall(function()
                    local root = enemy:FindFirstChild("HumanoidRootPart")
                    if root ~= nil then
                        root.CanCollide = true
                    end
                    local humanoid = enemy:FindFirstChild("Humanoid")
                    if humanoid ~= nil then
                        humanoid.PlatformStand = false
                        humanoid.AutoRotate = true
                    end
                end)
                held[enemy] = nil
            end
        end

        runtime.gatherCount = brought
        if tick() - (runtime.gatherSaidAt or 0) > 30 then
            runtime.gatherSaidAt = tick()
            print(("gather | gom %d/%d con vao mot diem"):format(brought, limit))
        end
    end

