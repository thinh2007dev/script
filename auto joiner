    -- Ten kho do va ten hien thi khac thu tu chu va dau ngoac: cung mot mon la
    -- "Hunter Cape (Black)" o rương va "Black Hunter Cape" o cho khac. So sanh
    -- bang tap chu da sap xep thi moi cach viet deu bang nhau.
    local function normalizeAccessoryName(value)
        local words = {}
        for word in tostring(value):lower():gmatch("%w+") do
            table.insert(words, word)
        end
        table.sort(words)
        return table.concat(words, " ")
    end

    local WARRIOR_HELMET_KEY = normalizeAccessoryName("Warrior Helmet")

    local function isWarriorHelmet(value)
        return normalizeAccessoryName(value) == WARRIOR_HELMET_KEY
    end

    -- Tim mu trong MOI nhom cua runtime.progress, khong chi "Wear". Rương gan
    -- nhan "Accessory" cho mon nay nen chot ownsProgress("Wear", ...) luon sai
    -- -> ham thoat ngay tu dau va khong bao gio doi mu.
    -- Tra ve row (co ItemId / NetworkedUID) hoac nil.
    local function findWarriorHelmetRow()
        for _, group in pairs(runtime.progress) do
            if type(group) == "table" then
                for key, row in pairs(group) do
                    if type(row) == "table"
                        and (isWarriorHelmet(key)
                            or isWarriorHelmet(row.Name)
                            or isWarriorHelmet(row.StorageKey))
                    then
                        return row
                    end
                end
            end
        end
        return nil
    end

    local function maintainWarriorHelmet()
        if not runtime.configs["Auto Warrior Helmet"] then
            return
        end
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            return
        end

        -- Mu 850 nay phai lam xong nhiem vu Bartilo moi co, nen truoc do khong
        -- co gi de doi - im lang, khong ban remote.
        local wornHelmet, wornOther = nil, nil
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                -- Mu nhan dien bang TEN, khong bang ToolTip: mot ban game doi
                -- ToolTip la chot nay hong va script doi mu vo tan.
                if isWarriorHelmet(child.Name) then
                    wornHelmet = child
                elseif child.ToolTip == "Wear" then
                    wornOther = child
                end
            end
        end
        if wornHelmet ~= nil then
            runtime.helmetTries = 0
            return
        end

        local helmet = nil
        for _, child in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if child:IsA("Tool") and isWarriorHelmet(child.Name) then
                helmet = child
                break
            end
        end

        if helmet ~= nil then
            -- Dang doi mon khac: cat no vao tui truoc, neu khong hai mon cung
            -- nam trong Character va game giu lai cai cu.
            if wornOther ~= nil then
                pcall(function()
                    wornOther.Parent = LocalPlayer.Backpack
                end)
                if tick() - (runtime.helmetSwapSaidAt or 0) > 60 then
                    runtime.helmetSwapSaidAt = tick()
                    print("wear | thao " .. tostring(wornOther.Name)
                        .. " de doi lai Warrior Helmet")
                end
            end
            -- REPARENT, khong dung EquipTool: EquipTool THAY cai dang cam nen no
            -- danh nhau voi EquipWeapon("Melee") - doi mu roi doi melee, ca phien
            -- khong bao gio doi duoc mu. Day thang vao Character thi giu ca hai.
            pcall(function()
                helmet.Parent = character
            end)
            runtime.helmetTries = 0
            if tick() - (runtime.helmetSaidAt or 0) > 60 then
                runtime.helmetSaidAt = tick()
                print("wear | da doi Warrior Helmet")
            end
            return
        end

        if tick() - (runtime.helmetLoadAt or 0) < 15 then
            return
        end
        runtime.helmetLoadAt = tick()

        local row = findWarriorHelmetRow()
        if row == nil then
            local inventory = API.GetInventory()
            if type(inventory) == "table" then
                for _, item in ipairs(inventory) do
                    if isWarriorHelmet(item.Name) or isWarriorHelmet(item.StorageKey) then
                        row = item
                        break
                    end
                end
            end
        end
        if row == nil then
            runtime.helmetTries = 0
            return
        end

        -- Ban remote goi mu ra khoi rương. Hai duong: SetEquip qua
        -- JuiceNetworkRF (duong rương dung) va LoadItem qua CommF. Ban khong
        -- doan duoc duong nao an nen ban ca hai; ban nao khong co ItemId/key
        -- thi tu bo qua.
        runtime.helmetTries = (runtime.helmetTries or 0) + 1
        if runtime.helmetTries > 3 then
            runtime.helmetTries = 0
            runtime.helmetLoadAt = tick() + 300
            warn("wear | goi Warrior Helmet 3 lan khong ra - nghi 5 phut")
            return
        end
        if row.ItemId ~= nil and runtime.juiceNetworkRF ~= nil then
            pcall(function()
                runtime.juiceNetworkRF:InvokeServer({
                    Type = "SetEquip",
                    ItemId = row.ItemId,
                    IsEquipped = true,
                })
            end)
        end
        local key = row.NetworkedUID or row.WEAK_UID or row.ItemId or row.StorageKey
        if key ~= nil then
            pcall(function()
                runtime.commF:InvokeServer("LoadItem", key)
            end)
        end
