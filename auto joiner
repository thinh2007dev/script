    -- Bay toi dao roi reset de hoi sinh tai do. Chi dung khi < islandResetRange studs.
    function API.IslandTeleportReset(islandCFrame, islandName, region)
        if not runtime.rootPart then
            return false
        end
        -- ============ FIX BONE FARM / RANDOM ============
        -- Dang xa luot random bone thi KHONG chet/reset: phai dung nguyen tai
        -- Haunted Castle cho het batch, xong batch moi cho reset lai.
        if runtime.boneRollBatchActive == true then
            return false
        end
        -- KHONG chan theo quest o day. Chet co mat quest, nhung TakeQuest nhan
        -- lai ngay vong sau - ton vai giay, doi lai la bay qua ca vung bien mat
        -- vai phut va con bi server dut ve. Qua dao khac thi RESET moi nhanh.
        -- Cai chan dung cho la "cung dao thi bay thang" o ResetToIsland.
        if (islandCFrame.Position - runtime.rootPart.Position).Magnitude > runtime.islandResetRange then
            return false
        end

        API.CancelTween()
        if region then
            runtime.locationRemote:FireServer(region)
        end

        -- ============ NHAY TOI DAO ROI GIU, KHONG NHAY 1 FRAME ============
        -- Server chi nhan SetLastSpawnPoint khi minh DANG O tren dao, nen buoc
        -- nhay nay la bat buoc - bo no di la mat luon co che bay nhanh.
        -- Ghi CFrame 1 frame thi server dut ve va nhan vat bi vang len troi
        -- ("dich chuyen len sieu cao"). Giu vai frame, khoa van toc, va dat
        -- dung cao do pivot chu khong cong them.
        API.AddVelocity()
        local landing = CFrame.new(islandCFrame.Position)
        local holdUntil = tick() + 0.25
        repeat
            local rootPart = runtime.rootPart
            if rootPart == nil or rootPart.Parent == nil then
                break
            end
            rootPart.CFrame = landing
            rootPart.Velocity = Vector3.new(0, 0, 0)
            task.wait()
        until tick() > holdUntil

        -- Cho server ghi nhan diem hoi sinh TRUOC khi chet, neu khong la chet
        -- xong hoi sinh lai cho cu. Ban hai lan cach nhau 0.2s la du - 0.5s cu
        -- chi lam moi lan reset dai them gan mot giay vo ich.
        if islandName then
            runtime.commF:InvokeServer("SetLastSpawnPoint", islandName)
            task.wait(0.2)
            runtime.commF:InvokeServer("SetLastSpawnPoint", islandName)
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.Health = 0
        end
        -- Co han: runtime.humanoid la tham chieu CACHED, sau khi chet no tro toi
        -- cai xac Health = 0 vinh vien -> vong `until Health > 0` treo mai.
        --
        -- Nhip 0.1s chu khong phai 0.5s: thoi gian hoi sinh la cua Roblox, minh
        -- khong rut duoc, nhung doi them toi 0.5s sau khi da song lai thi rut
        -- duoc. Han cho 12s thay vi 20s.
        local deadline = tick() + 12
        repeat
            task.wait(0.1)
            pcall(API.RefreshCharacter)
        until (runtime.rootPart
                and runtime.humanoid
                and runtime.humanoid.Health > 0)
            or tick() > deadline
        API.AddVelocity()
        return runtime.humanoid ~= nil and runtime.humanoid.Health > 0
    end

    -- Teleport reset toi dao gan diem den nhat (trong tam islandResetRange)
    function API.ResetToIsland(destination)
        if not runtime.rootPart then
            return false
        end
        -- ============ FIX DUNG CONG THAY VI RESET ============
        -- CO CONG requestEntrance THI KHONG BAO GIO RESET. Sky Area 1 (Y~870),
        -- Sky Area 2 (Y~5550), Fish Man (X~61000), Ghost Ship (Z~32850),
        -- Temple Of Time... khong co diem hoi sinh nao gan, nen reset chi lam
        -- chet vo ich roi van phai bay tu duoi len. Ma vong CHO QUAI cua Auto
        -- Farm Level goi lai ham nay moi 30 giay -> thanh vong chet/reset lien
        -- tuc, dung cai dang thay o dao Sky va Fishman.
        --
        -- Chan tai DAY vi day la CHU DUY NHAT cua quyet dinh reset. Truoc day
        -- chi hai khoi trong API.TP kiem tra cong, con bon noi goi truc tiep
        -- (cho quai o Auto Farm Level, FarmMob, Buy Melee, Get Fruits) thi
        -- khong noi nao kiem tra. Bo reset o day thi caller roi xuong duong bay
        -- binh thuong, va API.TP se ban requestEntrance cho chuyen di xa.
        if API.HasEntranceFor ~= nil and API.HasEntranceFor(destination) then
            return false
        end
        local currentDistance = (destination.Position - runtime.rootPart.Position).Magnitude
        if currentDistance <= 1000 then
            return false
        end

        local spawns = Services.Workspace._WorldOrigin.PlayerSpawns[LocalPlayer.Team.Name]:GetChildren()
        local allowUnderwater = destination.Position.Y < 0

        -- DAO DANG DUNG: moi bai tren cung mot dao deu quy ve cung mot spawn.
        -- Cac bai chung NPC hoac chi khac cho nhan quest nam cung dao, nen reset
        -- la chet de nhay trong chinh cho dang dung - vo ich va dut mach farm.
        -- Xet ca spawn xau vi day chi la cau hoi "toi dang o dao nao".
        local selfIsland, selfDistance = nil, nil
        for _, spawn in ipairs(spawns) do
            local gap = (spawn.WorldPivot.Position - runtime.rootPart.Position).Magnitude
            if selfDistance == nil or gap < selfDistance then
                selfIsland, selfDistance = spawn, gap
            end
        end

        local best, bestDistance
        for _, spawn in ipairs(spawns) do
            local pivot = spawn.WorldPivot
            if not runtime.badResetIslands[spawn.Name]
                and (allowUnderwater or pivot.Position.Y > 5)
                and (pivot.Position - runtime.rootPart.Position).Magnitude <= runtime.islandResetRange
            then
                local toDestination = (pivot.Position - destination.Position).Magnitude
                if toDestination < currentDistance and (not bestDistance or toDestination < bestDistance) then
                    bestDistance = toDestination
                    best = spawn
                end
            end
        end
        if not best then
            return false
        end
        -- Cung dao thi bay thang. Chi doi sang dao doc lap moi teleport reset.
        if best == selfIsland then
            return false
        end
        return API.IslandTeleportReset(
            best.WorldPivot,
            best.Name,
            API.GetNearestRegion(best.WorldPivot)
        )
    end

