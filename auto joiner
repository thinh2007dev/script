    local function meleeState(name)
        local row = runtime.meleeProgress and runtime.meleeProgress[name]
        local saved = (runtime.meleeSave.Melee or {})[name]
        local level = tonumber(saved and saved.Level) or tonumber(row and row.Level) or 0
        local bought = (saved ~= nil and saved.Bought == true) or level > 0
        if bought then
            return ("mastery %d"):format(math.floor(level)), C_OK
        end
        local key = API.MeleeKeySubmit and API.MeleeKeySubmit[name]
        if key ~= nil then
            if API.CarriesItem ~= nil and API.CarriesItem(key.Key) then
                return "co " .. key.Key .. ", dang nop", C_MID
            end
            if row ~= nil and row.Done == true then
                return "da nop key, chua mua", C_MID
            end
            return "thieu " .. key.Key, C_DIM
        end
        if row ~= nil and row.Done == true then
            return "mo khoa roi, chua mua", C_MID
        end
        return "chua mua", C_DIM
    end

    local function updateTracker()
        local data = LocalPlayer:FindFirstChild("Data")
        local level = data and data:FindFirstChild("Level")
        local beli = data and data:FindFirstChild("Beli")
        local frag = data and data:FindFirstChild("Fragments")
        lblStats.Text = ("Lv %s  |  Sea %s  |  $ %s  |  F %s"):format(
            tostring(level and level.Value or "?"),
            tostring(runtime.sea or "?"),
            shortNumber(beli and beli.Value),
            shortNumber(frag and frag.Value))
        lblJob.Text = "JOB: " .. tostring(runtime.status or "")

        -- QUEUE THEO DUNG THU TU SE CHAY. Heap chi bao dam moi cai goc, nen
        -- phai chep ra roi sap lai - duyet heap tho la in ra thu tu sai.
        -- Day la dong quan trong nhat: gan nhu moi lan "script dung yen" deu
        -- la mot job uu tien cao om queue ma khong lam gi.
        local ordered = {}
        pcall(function()
            for _, entry in ipairs(runtime.queue.heap) do
                table.insert(ordered, entry)
            end
        end)
        table.sort(ordered, function(a, b)
            return (a.priority or 0) > (b.priority or 0)
        end)
        local shown = {}
        for index = 1, math.min(#ordered, 4) do
            table.insert(shown, ("%s(%s)"):format(
                tostring(ordered[index].element),
                tostring(ordered[index].priority)))
        end
        if #ordered > 4 then
            table.insert(shown, ("+%d"):format(#ordered - 4))
        end
        lblQueue.Text = #shown > 0
            and ("QUEUE: " .. table.concat(shown, " > "))
            or "QUEUE: (trong)"

        -- ============ FIX BONE FARM / RANDOM ============
        -- BANG CHI HIEN THI state cua engine: doc cung API.RefreshBonesCheck /
        -- runtime.bonesCheck, KHONG tu tinh rolls hay target rieng.
        --
        -- Bang cung phai TU GOI RefreshBonesCheck. Truoc day no chi doc
        -- runtime.bonesCheck da co san, ma RollBonesAll dat bien do ve nil - nen
        -- khi bone stage khong chay (dang di Lightning Bolt, dang doi sea, dang
        -- nghi) thi khong ai nap lai: bang dung mai o so cu va luot hien "?".
        -- RefreshBonesCheck co cache 10 giay nen day chi ton 1 lenh / 10 giay.
        local serverBones, serverRolls = nil, nil
        if API.RefreshBonesCheck ~= nil then
            serverBones, serverRolls = API.RefreshBonesCheck(false)
        end
        local bones = tonumber(serverBones)
            or (API.InventoryCount and API.InventoryCount("Material", "Bones"))
            or 0
        local rolls = tonumber(serverRolls)
        if rolls == nil then
            -- nil = CHUA DOC DUOC. Tuyet doi khong hien "HET LUOT".
            lblBone.Text = ("BONE %d  |  ROLLS ?  |  CHUA DOC DUOC"):format(
                math.floor(bones))
            lblBone.TextColor3 = C_DIM
        elseif rolls <= 0 then
            local left = API.BoneRollCooldownLeft ~= nil
                and API.BoneRollCooldownLeft() or 0
            lblBone.Text = ("BONE %d  |  HET LUOT  |  con %02d:%02d:%02d"):format(
                math.floor(bones),
                math.floor(left / 3600),
                math.floor(left % 3600 / 60),
                left % 60)
            lblBone.TextColor3 = C_DIM
        else
            -- ============ FIX BONE FARM / RANDOM ============
            -- Target DONG voi runBoneStage: GIA MOT LUOT (500 do duoc), khong
            -- phai rolls * 50. ROLLS la so luot TOI DA moi chu ky (luon 10).
            local need = math.max(50, tonumber(runtime.boneRollCost) or 500)
            local phase = "DANG FARM"
            if (tonumber(runtime.expBoostSeconds) or 0) > 0
                and runtime.boneRollBatchActive ~= true
            then
                phase = "CO x2 EXP - FARM LV"
            elseif runtime.boneRollBatchActive == true or bones >= need then
                phase = "RANDOMING"
            end
            lblBone.Text = ("BONE %d/%d  |  ROLLS %d  |  %s"):format(
                math.floor(bones), need, rolls, phase)
            lblBone.TextColor3 = bones >= need and C_OK or C_MID
        end

        local clouds = API.CloudPieceCount and API.CloudPieceCount() or 0
        local retry = math.max(0, math.floor((runtime.cloudRetryAt or 0) - tick()))
        if clouds > 0 then
            lblCloud.Text = ("MAY BAO: co %d manh - di pha lay ngoc"):format(clouds)
            lblCloud.TextColor3 = C_OK
        elseif retry > 0 then
            lblCloud.Text = ("MAY BAO: nghi %ds roi thu lai"):format(retry)
            lblCloud.TextColor3 = C_MID
        else
            local state = runtime.electroQuestState
            lblCloud.Text = ("MAY BAO: chua co  |  quest %s"):format(
                state == nil and "chua doc"
                    or state >= 5 and "chua nhan"
                    or state == 2 and "da nop ngoc"
                    or ("da nhan (buoc %d)"):format(state))
            lblCloud.TextColor3 = C_DIM
        end

        for _, cell in pairs(cells) do
            local row = cell.Row
            local text, color = "-", C_DIM
            if row.Kind == "Melee" then
                text, color = meleeState(row.Name)
            elseif row.Kind == "Carried" then
                local has = API.CarriesItem ~= nil and API.CarriesItem(row.Name)
                text = has and "dang cam" or "khong"
                color = has and C_OK or C_DIM
            elseif row.Kind == "Material" then
                local count = API.InventoryCount
                    and API.InventoryCount("Material", row.Name) or 0
                text = "x" .. tostring(math.floor(count))
                color = count > 0 and C_OK or C_BAD
            elseif row.Kind == "Fragment" then
                local have = frag and frag.Value or 0
                text = ("%s / 5000"):format(shortNumber(have))
                color = have >= 5000 and C_OK or C_MID
            elseif row.Kind == "Wear" then
                local owned = API.OwnsProgress ~= nil
                    and API.OwnsProgress("Wear", row.Name)
                text = owned and "da co" or "chua co"
                color = owned and C_OK or C_BAD
            end
            cell.Dot.BackgroundColor3 = color
            cell.Value.Text = text
            cell.Value.TextColor3 = color
        end
    end

    local trackerButton = Instance.new("TextButton")
    trackerButton.Size = UDim2.new(1, 0, 0.42, 0)
    trackerButton.Position = UDim2.new(0, 0, 1, 6)
    trackerButton.BackgroundColor3 = Color3.fromRGB(32, 36, 46)
    trackerButton.Text = "Tracker"
    trackerButton.TextColor3 = Color3.fromRGB(230, 234, 242)
    trackerButton.Font = Enum.Font.GothamBold
    trackerButton.TextSize = 11
    trackerButton.AutoButtonColor = false
    trackerButton.Parent = ui.button
    local trackerButtonCorner = Instance.new("UICorner")
    trackerButtonCorner.CornerRadius = UDim.new(0, 6)
    trackerButtonCorner.Parent = trackerButton
    table.insert(runtime.connections, trackerButton.MouseButton1Click:Connect(function()
        panel.Visible = not panel.Visible
    end))

    ui.tracker = panel
    pcall(updateTracker)
    runtime.workers.tracker = task.spawn(function()
        while runtime.running and panel.Parent do
            task.wait(1)
            pcall(updateTracker)
        end
    end)
    -- ===================== HET BANG THEO DOI =====================

    table.insert(runtime.connections, ui.input_box.Focused:Connect(function()
        ui.input_glow.BackgroundTransparency = 0
    end))
    table.insert(runtime.connections, ui.input_box.FocusLost:Connect(function()
        local text = ui.input_box.Text
        if text ~= "" then
            runtime.api.SubmitJoinTarget(text)
        end
        ui.input_glow.BackgroundTransparency = 0.4
    end))
    table.insert(runtime.connections, ui.button.MouseButton1Click:Connect(function()
        if runtime.workers.feature then
            runtime:setEnabled(false)
            ui.status_text.Text = "Chilling"
            ui.button.Text = "Off"
            ui.button.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        else
            runtime:setEnabled(true)
            ui.button.Text = "On"
            ui.button.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        end
    end))
end)
runtime.workers.uiSetup = uiSetupThread

print(
    "[Xero]",
    runtime.running and "started" or "failed",
    tostring(runtime.status),
    tostring(runtime.sea),
    tostring(game.PlaceId)
)
return runtime
