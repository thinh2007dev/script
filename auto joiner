    function API.GetInventory()
        local output = {}
        local keys = inventoryKeys
        local itemConfig = inventoryItemConfig
        if not inventoryService or not keys or not itemConfig then
            return output
        end

        if not inventoryService.IsInitialized then
            pcall(function()
                inventoryService.init()
            end)
        end

        local items = nil
        pcall(function()
            items = inventoryService:GetItems(keys.QUANTITY)
        end)
        if not items then
            return output
        end

        for _, item in items do
            local count = item.Value or item.Count or 1
            if count > 0 then
                local metadata = nil
                pcall(function()
                    metadata = itemConfig.match(item.ItemId):asNullable()
                end)

                local name = metadata and metadata.Display and metadata.Display.Name
                    or metadata and metadata.Index and metadata.Index.DebugLabel
                    or metadata and metadata.Index and metadata.Index.StorageKey
                    or item.ItemId
                local itemType = metadata and metadata.Index and metadata.Index.IdType
                    or metadata and metadata.Type
                    or "Other"
                local storageKey = metadata and metadata.Index and metadata.Index.StorageKey or item.ItemId
                local rarity = metadata and metadata.Quality and metadata.Quality.RarityValue or 0
                local mastery = 0
                pcall(function()
                    mastery = inventoryService:ReadItem(keys.MASTERY, item.ItemId, item.NetworkedUID) or 0
                end)

                table.insert(output, {
                    Name = name,
                    Type = itemType,
                    Count = count,
                    Value = count,
                    Mastery = mastery,
                    NetworkedUID = item.NetworkedUID,
                    ItemId = item.ItemId,
                    StorageKey = storageKey,
                    WEAK_UID = item.NetworkedUID or item.ItemId or storageKey,
                    Rarity = rarity,
                })
            end
        end
        return output
    end

