                        fullyAwakened = false
                        break
                    end
                end
                if fullyAwakened then
                    runtime.raid.canAwaken = false
                    runtime.featureSpecs["Auto Raid"] = {
                        func = runtime.controllers.Raid,
                        args = table.pack("Auto Raid", "Ice"),
                    }
                else
                    runtime.featureSpecs["Auto Raid"] = {
                        func = runtime.controllers.Raid,
                        args = table.pack("Auto Raid", fruitName:match("^(.-)-")),
                    }
                    runtime.raid.requested = true
                    runtime.raid.canAwaken = true
                end
            end
        end

        local hasIndraColors = progressCount("Pure Red") > 0
            and progressCount("Winter Sky") > 0
            and progressCount("Snow White") > 0
        local godsChalice = runtime.carried["God's Chalice"]
        local sweetChalice = runtime.carried["Sweet Chalice"]
        local hasGodsChalice = godsChalice.Backpack or godsChalice.Character
        local hasSweetChalice = sweetChalice.Backpack or sweetChalice.Character
        setQueued(
            "Auto Spawn rip_indra",
            sea == 3
                and runtime.configs["Auto Spawn rip_indra"]
                and hasIndraColors
                and hasGodsChalice
                and (not ownsProgress("Wear", "Valkyrie Helm")
                    or not ownsProgress("Moveset", "Tushita"))
        )
        setQueued(
            "Auto Spawn Dough King",
            runtime.configs["Auto Spawn Dough King"]
                and (hasSweetChalice or hasGodsChalice)
                and not ownsProgress("Material", "Mirror Fractal")
        )

        local needsLever = false
