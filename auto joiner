        if not needAny then
            runtime.sea2KeyHopRetryAt = 0
            runtime.sea2KeyLookBoss = nil
            return
        end

        -- BOSS LOCAL LUON UU TIEN TRUOC HOP. Dung o sea nao cung xet - boss chi
        -- spawn o sea 2 nen IsBossAlive tu loc, va day la duong "boss tu spawn
        -- thi van danh" khi tat quyen hop.
        for bossName, row in pairs(wantedBosses) do
            if API.IsBossAlive(bossName) then
                if tick() - (runtime.sea2BossSaidAt or 0) > 30 then
                    runtime.sea2BossSaidAt = tick()
                    print(("[SEA2 KEY] %s alive -> farm %s"):format(
                        bossName, row.Label))
                end
                -- ============ FIX SEA2 KEY + HOP POLICY ============
                -- Boss dang song: bo co "di kiem tra" de GetBossCFrame quay lai
                -- toa do THAT cua boss, va tra lai ngan sach hop.
                runtime.sea2KeyLookBoss = nil
                runtime.sea2LookDeadline = nil
                runtime.sea2LookRestUntil = 0
                if API.Sea2KeyHopReset ~= nil then
                    API.Sea2KeyHopReset()
                end
                schedule("Farm Boss", bossName, "Farm Boss")
                return
            end
        end

        -- Dang cam key thi khong san boss nua - viec con lai la nop, va
        -- API.SubmitMeleeKeys (chay o RunSecondaryFeatures) lo phan do.
        for _, row in ipairs(keyState.rows) do
            if keyState[row.Key].holding then
                runtime.sea2KeyLookBoss = nil
                return
            end
        end

        -- ============ FIX X2 EXP: DON HET VAO FARM LEVEL ============
        -- Dang co x2 EXP thi KHONG ve Sea 2, KHONG bay xem o spawn, KHONG hop.
        -- Ba viec do ton hang phut ma khong an EXP, tieu het buff.
        -- Boss dang song ngay canh thi VAN danh - nhanh do o TREN cho nay, gan
        -- nhu mien phi va lai ra key luon. Het buff moi lam phan ton thoi gian.
        -- Lv 2800 thi EXP vo nghia nen khong chan.
        if (tonumber(runtime.expBoostSeconds) or 0) > 0
            and LocalPlayer.Data.Level.Value ~= 2800
        then
            runtime.sea2KeyLookBoss = nil
            runtime.sea2LookDeadline = nil
            return
        end

        -- Ra khoi sea 2 / khong con san nua thi phai bo co, neu khong
        -- GetBossCFrame se con tra o spawn cho cac feature khac.
        if runtime.sea ~= 2 then
            runtime.sea2KeyLookBoss = nil
        end

        if runtime.sea == 3 then
            -- Da len sea 3 ma con thieu key: day moi la RETURN errand.
            if not runtime.secondSeaErrand then
                return
            end
            local trip = runtime.secondSeaTrip
            if not trip then
                trip = { count = 0, at = 0 }
                runtime.secondSeaTrip = trip
            end
            if tick() - trip.at < 30 then
                return
            end
            trip.at = tick()
            trip.count += 1
            if trip.count > 5 then
                trip.count = 0
                runtime.secondSeaErrandRetryAt = tick() + 600
                warn("sea 2 | ve lay chia khoa bi tu choi 5 lan, 10 phut nua thu lai")
                return
            end
            setStatus("Buy Melee | Ve sea 2 lay chia khoa")
            runtime.commF:InvokeServer("TravelDressrosa")
            task.wait(5)
            return
        end
        if runtime.sea ~= 2 then
            return
        end
        if runtime.secondSeaTrip then
            runtime.secondSeaTrip.count = 0
        end

        -- ============ FIX SEA2 KEY + HOP POLICY ============
        -- Enemy chi render quanh player, nen IsBossAlive o tren chi thay boss
        -- khi da dung gan o spawn. Dung o bai farm thi no LUON thay "khong co"
        -- roi doi sever, sever moi cung khong thay -> hop vo han. Phai bay toi
        -- o spawn GAN NHAT xem truoc; toi roi ma trong thi luc do moi duoc hop.
        if runtime.rootPart == nil then
            return
        end
        local lookBoss, lookAway = nil, nil
        for bossName in pairs(wantedBosses) do
            local spawnCFrame = API.BossSpawnCFrame(bossName)
            if spawnCFrame ~= nil then
                local away = (runtime.rootPart.Position - spawnCFrame.Position).Magnitude
                if lookAway == nil or away < lookAway then
                    lookBoss, lookAway = bossName, away
                end
            end
        end
        local arrived = lookBoss ~= nil and lookAway <= SEA2_BOSS_SPAWN_RADIUS
        if lookBoss == nil or arrived then
            -- Khong co toa do de xem, hoac DA dung tai o spawn ma trong. Nghi
            -- mot lat truoc khi xem lai: neu khong, Auto Farm Level keo nhan
            -- vat ve bai, vong sau lai thay "xa o spawn" roi bay lai - di di
            -- ve ve mai ma khong farm duoc gi.
            runtime.sea2KeyLookBoss = nil
            runtime.sea2LookDeadline = nil
            if arrived then
                runtime.sea2LookRestUntil = tick() + SEA2_LOOK_REST
            end
        elseif tick() >= (runtime.sea2LookRestUntil or 0) then
            if runtime.sea2LookDeadline == nil then
                runtime.sea2LookDeadline = tick() + SEA2_LOOK_DEADLINE
            end
            if tick() < runtime.sea2LookDeadline then
                runtime.sea2KeyLookBoss = lookBoss
                if tick() - (runtime.sea2LookSaidAt or 0) > 30 then
                    runtime.sea2LookSaidAt = tick()
                    print(("[SEA2 KEY] toi o spawn %s kiem tra (%d studs)"):format(
                        lookBoss, math.floor(lookAway)))
                end
                schedule("Farm Boss", lookBoss, "Farm Boss")
                return
            end
            -- Bay khong toi trong han gio: dung treo o day, tra quyen lai cho
            -- nhanh hop ben duoi.
            warn(("[SEA2 KEY] khong toi duoc o spawn %s trong %ds -> doi sever")
                :format(lookBoss, SEA2_LOOK_DEADLINE))
            runtime.sea2KeyLookBoss = nil
            runtime.sea2LookDeadline = nil
            runtime.sea2LookRestUntil = tick() + SEA2_LOOK_REST
        else
            runtime.sea2KeyLookBoss = nil
        end

        -- Da dung tai o spawn ma khong co boss -> moi tinh chuyen doi sever.
        -- Quyen RIENG, khong doc "Disable All Hop" va khong doc "Hop.Enable".
        if runtime.configs["Auto Hop Sea 2 Key Boss"] ~= true then
            return
        end
        -- retryAt CHI chan viec THU HOP TIEP sau mot lan hop LOI - luc do van
        -- con trong cung mot process nen tick() dung duoc.
        if tick() < (runtime.sea2KeyHopRetryAt or 0) then
            return
        end
        if runtime.hopInProgress == true then
            return
        end

        -- NGAN SACH HOP LUU XUONG FILE. tick() mat sau moi lan hop (process
        -- moi), nen moi chot chong-spam bang tick deu bi xoa khi rejoin - do la
        -- ly do thu hai vong hop khong bao gio dung. Moc phai la os.time().
        local hopCount, standDownUntil, lastHopAt = 0, 0, 0
        if API.Sea2KeyHopBudget ~= nil then
            hopCount, standDownUntil, lastHopAt = API.Sea2KeyHopBudget()
        end
        local nowStamp = os.time()
        if nowStamp < standDownUntil then
            return
        end
        if nowStamp - lastHopAt < SEA2_KEY_HOP_INTERVAL then
            return
        end

        if API.Sea2KeyHopSpend ~= nil
            and API.Sea2KeyHopSpend(SEA2_KEY_HOP_REST, SEA2_KEY_HOP_BUDGET)
        then
            warn(("[SEA2 KEY] da thu %d sever khong ra boss -> nghi %d phut,"
                .. " farm level tiep"):format(
                SEA2_KEY_HOP_BUDGET, math.floor(SEA2_KEY_HOP_REST / 60)))
            return
        end

        local names = {}
        for bossName in pairs(wantedBosses) do
            table.insert(names, bossName)
        end
        table.sort(names)
        print(("[SEA2 KEY] o spawn trong (%s) -> doi sever thu %d/%d..."):format(
            table.concat(names, " / "), hopCount + 1, SEA2_KEY_HOP_BUDGET))
        setStatus("Farm Boss | Doi sever tim " .. table.concat(names, " / "))

        -- HOP LOI THI QUAY VE FARM LEVEL, khong treo va khong spam.
        local hopOk = false
        local callOk, result = pcall(API.HopServer, nil, true, false, "Sea2KeyBoss")
        if callOk then
            hopOk = result == true
        end
        if not hopOk then
            runtime.hopInProgress = false
            runtime.sea2KeyHopRetryAt = tick() + 60
            warn(("[SEA2 KEY] Hop failed (%s) -> farm level sea 2, 60s nua thu lai")
                :format(tostring(runtime.hopLastError
                    or (not callOk and result) or "khong co sever hop le")))
        end
    end

