                then
                    runtime.commF:InvokeServer("LoadItem", "Tushita")
                end
                runtime.useSwordAtMaxMastery = true
            else
                runtime.useSwordAtMaxMastery = false
                if yama and tushita then
                    local doorStatus = runtime.commF:InvokeServer("CDKQuest", "OpenDoor")
                    if doorStatus == "opened" then
                        local progress = runtime.commF:InvokeServer("CDKQuest", "Progress")
