    -- Chu ky that (ban ghi remote): Check -> getInventoryFruits -> Purchase, va
    -- doi so la BANG, khong phai chuoi. Goi gachaRF:InvokeServer("BoxName") tran
    -- nhu truoc thi server bo qua - do la ly do khong bao gio ra trai.
    -- Cua so khoe trai sau khi random. No HIEN SAU khi Purchase tra ve, nen
    -- phai chay nen va go lien tuc vai giay chu khong go mot phat.
    -- Ten ScreenGui la "<TenHop>_Window", khong phai mot ten co dinh - do la ly
    -- do go theo mot ten cung khong bao gio trung. De lai cua so nay la moi lan
    -- random sau bi chan.
    local function dismissGachaWindow(boxName)
        task.spawn(function()
            local controllers = Services.ReplicatedStorage:FindFirstChild("Controllers")
            local ui = controllers and controllers:FindFirstChild("UI")
            local gachaWindow = nil
            if ui ~= nil and ui:FindFirstChild("GachaWindow") ~= nil then
                pcall(function()
                    gachaWindow = require(ui.GachaWindow)
                end)
            end
            local spinner = runtime.dlcBoxController
            local names = { "SpinnerWindow", "__ReplicatedSpinnerInstances" }
            if type(boxName) == "string" and boxName ~= "" then
                table.insert(names, boxName .. "_Window")
            end
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            for _ = 1, 30 do
                if type(gachaWindow) == "table"
                    and type(gachaWindow.Close) == "function"
                then
                    pcall(function()
                        gachaWindow:Close(true)
                    end)
                end
                if type(spinner) == "table" then
                    for _, fn in ipairs({ "Close", "Skip", "Stop", "Hide", "ForceClose" }) do
                        if type(spinner[fn]) == "function" then
                            pcall(function()
                                spinner[fn](spinner)
                            end)
                        end
                    end
                end
                if playerGui ~= nil then
                    for _, name in ipairs(names) do
                        local gui = playerGui:FindFirstChild(name)
                        if gui ~= nil then
                            pcall(function()
                                if gui:IsA("ScreenGui") and gui.Enabled then
                                    gui.Enabled = false
                                end
                            end)
                        end
                    end
                    -- Quet theo MAU TEN. Cua so dat ten theo hop
                    -- ("ZiolesGacha_Window", "MagnetEventGacha26_Window") nen
                    -- chu "gacha"/"spinner" bat duoc ca hai ma khong phai doan
                    -- ten day du. Chi tat ScreenGui, KHONG bam nut nao - trong
                    -- cua so gacha co ca muc mua bang Robux.
                    pcall(function()
                        for _, gui in ipairs(playerGui:GetChildren()) do
                            if gui:IsA("ScreenGui") and gui.Enabled then
                                local lowered = string.lower(gui.Name)
                                if string.find(lowered, "gacha", 1, true)
                                    or string.find(lowered, "spinner", 1, true)
                                then
                                    gui.Enabled = false
                                end
                            end
                        end
                    end)
                end
                task.wait(0.2)
            end
        end)
    end

    -- ============ FIX AUTO RANDOM FRUIT ============
    -- CA HAI ten hop da xac thuc bang CheckGachaAsync tren sever that (MCP):
    --   MagnetEventGacha26  Price{ItemId=1574 "Magnet Token" Value=500}
    --   ZiolesGacha         Price{DisplayName="Money" Value=430750}
    -- Goi phai la DAU CHAM: client.CheckGachaAsync(box). Goi kieu hai cham
    -- (client:CheckGachaAsync) bi server tra loi "unknown gacha from name:
    -- table" vi self bi day vao cho tham so ten hop.
    -- Khong suy ten hop tu ten window/controller (window controller ten
    -- "Cousin" nhung hop that lai la "ZiolesGacha").
    local GACHA = {
        Npc = "Blox Fruit Gacha",
        Magnet = "MagnetEventGacha26",
        Beli = "ZiolesGacha",
        client = nil,
        said = {},
    }

    -- DUNG CODE GAME (Controllers.GachaClient), khong tu dung bang cho
    -- GachaNetworkRF: duong nay da chay that trong tool test, va Net cua game
    -- tu serialize dung tham so.
    --   CheckGachaAsync(box, npc) -> bang Price/Level, KHONG ton gi.
    --   PurchaseGachaAsync(box)   -> mua that. Luu y KHONG co tham so npc.
    local function gachaClient()
        if GACHA.client ~= nil then
            return GACHA.client
        end
        local controllers = Services.ReplicatedStorage:FindFirstChild("Controllers")
        local node = controllers and controllers:FindFirstChild("GachaClient")
        if node == nil then
            return nil
        end
        local ok, mod = pcall(require, node)
        if not ok or type(mod) ~= "table" then
            return nil
        end
        GACHA.client = mod
        return mod
    end

    -- Mot dong moi 30 giay cho CUNG MOT noi dung - du de theo doi tren console
    -- ma khong spam.
    local function gachaSay(message)
        if tick() - (GACHA.said[message] or 0) < 30 then
            return
        end
        GACHA.said[message] = tick()
        print("[GACHA] " .. message)
    end

    -- ============ FIX AUTO RANDOM FRUIT: CHON THEO SO TOKEN ============
    -- MOT nguon duy nhat cho cau hoi "acc dang co bao nhieu Magnet Token".
    --
    -- Tra ve so, hoac nil khi CHUA DOC DUOC. nil KHAC 0: acc co the dang co
    -- 1000 token ma inventory chua replicate xong, va coi nil = 0 la di tieu
    -- beli oan.
    --
    -- KHONG hardcode group. Magnet Token nam o group nao la do IdType cua game
    -- quyet dinh, nen quet moi group va so theo TEN. Neu inventory da doc duoc
    -- ma khong co dong Magnet Token thi day la bang chung THAT cua so 0 (vi
    -- GetInventory bo qua item Count = 0), khong phai "chua biet".
    --
    -- Du phong cuoi: CheckGachaAsync(...).Price.CURRENT - so token that do
    -- server tra ve. TUYET DOI khong lay Price.VALUE: do la GIA mot luot (500).
    local MAGNET_TOKEN_KEY = "magnettoken"
    local function magnetKey(value)
        return (tostring(value or ""):lower():gsub("[^%w]", ""))
    end

    local function getMagnetTokenCount(force)
        -- force = vua random xong, phai bo ca chot 5 giay cua RefreshMaterials
        -- chu khong duoc quyet dinh tren so truoc khi tieu.
        if force then
            runtime.materialsRefreshedAt = nil
        end
        if API.RefreshMaterials ~= nil then
            pcall(API.RefreshMaterials)
        end

        local sawInventory = false
        for _, group in pairs(runtime.progress) do
            if type(group) == "table" then
                for key, row in pairs(group) do
                    if type(row) == "table" and row.Count ~= nil then
                        sawInventory = true
                        if magnetKey(key) == MAGNET_TOKEN_KEY
                            or magnetKey(row.Name) == MAGNET_TOKEN_KEY
                            or magnetKey(row.StorageKey) == MAGNET_TOKEN_KEY
                        then
                            local count = tonumber(row.Count)
                            if count ~= nil then
                                return count
                            end
                        end
                    end
                end
            end
        end

        local client = gachaClient()
        if client ~= nil and type(client.CheckGachaAsync) == "function" then
            local ok, check = pcall(client.CheckGachaAsync, GACHA.Magnet, GACHA.Npc)
            if ok and type(check) == "table" and type(check.Price) == "table" then
                local current = tonumber(check.Price.Current)
                if current ~= nil then
                    return current
                end
            end
        end

        -- Inventory doc duoc nhung khong co Magnet Token -> that su la 0.
        if sawInventory then
            return 0
        end
        return nil
    end

    -- Server tra ve CHUOI la TU CHOI. Phan biet tiep vi hai loai xu ly khac
    -- nhau: "wait"/"cooldown"/"try again"/"soon" la cooldown CHUNG cua random
    -- fruit (Beli cung dang bi khoa -> dung thu tiep), con lai la thieu dieu
    -- kien rieng cua hop do (-> duoc phep thu hop khac).
    local function gachaRefusalReason(text)
        local message = string.lower(tostring(text or ""))
        if message:find("wait", 1, true)
            or message:find("cooldown", 1, true)
            or message:find("try again", 1, true)
            or message:find("soon", 1, true)
        then
            return "cooldown"
        end
        return "refused"
    end

    -- Tra ve success(boolean), reason(string).
    --   "purchased" | "cooldown" | "currency" | "refused" | "error"
    local function rollGachaBox(boxName)
        if type(boxName) ~= "string" or boxName == "" then
            return false, "refused"
        end
        local client = gachaClient()
        if client == nil or type(client.PurchaseGachaAsync) ~= "function" then
            return false, "error"
        end

        -- CHECK TRUOC de khong ban Purchase vo ich: doc RequirementMet va
        -- Current/Value cua Price. Magnet: Value = 500 Magnet Token.
        if type(client.CheckGachaAsync) == "function" then
            local checkOk, check = pcall(client.CheckGachaAsync, boxName, GACHA.Npc)
            if not checkOk then
                return false, "error"
            end
            if type(check) == "string" then
                return false, gachaRefusalReason(check)
            end
            if type(check) == "table" then
                -- ============ FIX AUTO RANDOM FRUIT ============
                -- COOLDOWN doc TU SERVER, xet TRUOC currency. Do bang MCP tren
                -- sever that: Cooldown.TimeEnds la moc os.time() (con 4493s
                -- ~ 1h14m) va DUNG CHUNG cho ca hai hop. Truoc day khong ai doc
                -- field nay nen moi chu ky lai ban mot lenh Purchase vo ich roi
                -- in "refused" - dung la log ma may dang thay.
                local cooldown = check.Cooldown
                if type(cooldown) == "table" then
                    local endsAt = tonumber(cooldown.TimeEnds)
                    if endsAt ~= nil and endsAt > os.time() then
                        runtime.gachaCooldownUntil = endsAt
                        return false, "cooldown"
                    end
                    if cooldown.RequirementMet == false then
                        return false, "cooldown"
                    end
                    runtime.gachaCooldownUntil = nil
                end
                local level = check.Level
                if type(level) == "table" and level.RequirementMet == false then
                    return false, "refused"
                end
                local price = check.Price
                if type(price) == "table" then
                    if price.RequirementMet == false then
                        return false, "currency"
                    end
                    local current = tonumber(price.Current)
                    local value = tonumber(price.Value)
                    if current ~= nil and value ~= nil and current < value then
                        return false, "currency"
                    end
                end
            end
            -- check tra nil: khong ket luan gi, cu thu Purchase.
        end

        pcall(function()
            runtime.commF:InvokeServer("getInventoryFruits")
        end)
        local buyOk, buyResult = pcall(client.PurchaseGachaAsync, boxName)
        -- Go NGAY: cua so khoe trai hien SAU khi Purchase tra ve, nen bo go
        -- phai dang chay san.
        dismissGachaWindow(boxName)

        if not buyOk then
            return false, "error"
        end
        if buyResult == nil or buyResult == false then
            return false, "refused"
        end
        if type(buyResult) == "string" then
            -- DAY LA LOI CU. `buyResult ~= nil and buyResult ~= false` cho
            -- "You must wait ..." di qua nhu mua thanh cong -> tra true sai ->
            -- StoreBackpackFruits chay gia.
            return false, gachaRefusalReason(buyResult)
        end
        return true, "purchased"
    end

    -- ============ FIX AUTO RANDOM FRUIT ============
    -- ============ FIX AUTO RANDOM FRUIT: CHON THEO SO TOKEN ============
    -- MOT RULE DUY NHAT, quyet dinh TRUOC khi ban bat ky lenh nao:
    --   Magnet Token >= 500 -> random Magnet, KHONG thu Beli.
    --   Magnet Token <  500 -> random Beli,   KHONG ban lenh Magnet.
    --
    -- Truoc day la "thu Magnet, that bai thi fallback Beli". Suy tu that bai la
    -- DOAN: no ban mot lenh Magnet oan moi chu ky khi acc thieu token, va tra
    -- lai thi cooldown/loi remote lai bi hieu thanh "khong du token" roi di
    -- tieu beli. Cooldown va loi remote KHONG doi currency - chi SO TOKEN doi.
    --
    -- Da bo han GachaRotation { Magnet, Magnet, Beli } va runtime.gachaTurn.
    local MAGNET_PRICE = 500

    -- Con bao nhieu giay nua moi random duoc. Moc la os.time() nen song qua
    -- ca lan hop / rejoin.
    local function gachaCooldownLeft()
        local readyAt = tonumber(runtime.gachaCooldownUntil)
        if readyAt == nil then
            return 0
        end
        return math.max(0, readyAt - os.time())
    end
    API.GachaCooldownLeft = gachaCooldownLeft

    local function RandomFruitGacha()
        if tick() - (runtime.gachaAt or 0) < 10 then
            return false
        end
        runtime.gachaAt = tick()

        -- ============ FIX AUTO RANDOM FRUIT ============
        -- Dang cooldown thi KHONG doc token, KHONG ban lenh, va noi mot dong
        -- moi 5 phut. Doi currency luc nay vo nghia: cooldown dung chung.
        local waitLeft = gachaCooldownLeft()
        if waitLeft > 0 then
            if tick() - (runtime.gachaCooldownSaidAt or 0) > 300 then
                runtime.gachaCooldownSaidAt = tick()
                print(("[GACHA] cooldown con %02d:%02d:%02d"):format(
                    math.floor(waitLeft / 3600),
                    math.floor(waitLeft % 3600 / 60),
                    waitLeft % 60))
            end
            return false
        end

        -- Doc lai NGAY TRUOC khi quyet dinh, khong dung so cache cu.
        local magnetCount = getMagnetTokenCount(true)
        if magnetCount == nil then
            -- nil = CHUA DOC DUOC. Khong random mu bang Beli.
            gachaSay("Magnet Token UNKNOWN -> bo qua chu ky, thu lai sau")
            return false
        end
        gachaSay(("Magnet Token: %d"):format(math.floor(magnetCount)))

        local useMagnet = magnetCount >= MAGNET_PRICE
        local label = useMagnet and "Magnet" or "Beli"
        gachaSay(useMagnet
            and (">=%d -> random Magnet"):format(MAGNET_PRICE)
            or ("<%d -> random Beli"):format(MAGNET_PRICE))

        local ok, reason = rollGachaBox(useMagnet and GACHA.Magnet or GACHA.Beli)
        if ok then
            gachaSay(label .. " success -> refresh token count")
            if runtime.controllers.StoreBackpackFruits then
                runtime.controllers.StoreBackpackFruits()
            end
            -- Vua tieu token/beli: bo cache de chu ky sau doc so THAT.
            runtime.materialsRefreshedAt = nil
            return true
        end
        -- Cooldown / loi remote: CHO chu ky sau, khong doi sang currency khac.
        gachaSay(("%s fail (%s) - cho chu ky sau"):format(label, tostring(reason)))
        return false
    end
    runtime.controllers.RandomFruitGacha = RandomFruitGacha

    -- Quay HET luot mot mach, dung tai cho. Dung ngay khi ra Fire Essence,
    -- het luot, het xuong, hoac server tu choi.
    -- ============ FIX BONE FARM / RANDOM ============
    -- OWNER DUY NHAT cua ("Bones","Buy"). Khong worker nao khac duoc goi lenh
    -- nay - hai noi cung quay se doi remote va verify nham ket qua cua nhau.
    -- Xa HET so luot trong MOT batch, verify tung luot bang bang chung server.
    function API.RollBonesAll()
        local dragonTalon = runtime.meleeProgress["Dragon Talon"]
        local talonPending = dragonTalon ~= nil and not dragonTalon.Done
        local boneConfig = runtime.configs["Farm Config"]["Farm Bone Get x2 Exp"]
        local boneLevel = tonumber(boneConfig and boneConfig.Level) or 2000
        -- Muc 21.D: chet hoac roi Sea 3 thi don state in-flight va thoat an toan.
        if not runtime.humanoid
            or runtime.humanoid.Health <= 0
            or runtime.sea ~= 3
            or LocalPlayer.Data.Level.Value < boneLevel
        then
            runtime.boneRollInFlight = false
            runtime.boneRollBeforeBones = nil
            runtime.boneRollBeforeRolls = nil
            runtime.boneRollVerifyTries = 0
            return false
        end

        local rolled = 0
        while true do
            local serverBones, rolls = API.RefreshBonesCheck(false)
            rolls = tonumber(rolls)
            local bones = tonumber(serverBones)
                or inventoryCount("Material", "Bones")
            -- rolls == nil la "doc khong ra", KHONG phai "het luot": van ban
            -- thu, chinh server tra loi. Chan cu o day la loi khong bao gio quay.
            -- ============ FIX BONE FARM / RANDOM ============
            -- Nguong la GIA MOT LUOT (500), khong phai 50. Het xuong cho mot
            -- luot thi ve cay tiep, va vong nay tu nhien chi quay so luot ma
            -- so xuong hien co cho phep - dung "farm dung so luong roi quay".
            local cost = math.max(50, tonumber(runtime.boneRollCost) or 500)
            if bones < cost or (rolls ~= nil and rolls <= 0) then
                break
            end
            if talonPending
                and API.CarriesItem ~= nil
                and API.CarriesItem("Fire Essence")
            then
                break
            end
            -- Chet giua batch thi thoat, dung ban lenh vao xac.
            if runtime.humanoid == nil or runtime.humanoid.Health <= 0 then
                break
            end

            runtime.boneRollBeforeBones = bones
            runtime.boneRollBeforeRolls = rolls
            runtime.boneRollInFlight = true
            runtime.boneRollLastAttemptAt = tick()
            local ok, result = pcall(function()
                return runtime.commF:InvokeServer("Bones", "Buy", 1, 1)
            end)
            runtime.boneRollInFlight = false
            -- ============ FIX BONE FARM / RANDOM ============
            -- SERVER TU CHOI BANG SO 0, khong bang false. Do bang MCP: goi
            -- ("Bones","Buy",1,1) khi thieu xuong tra ve number 0 (kem lai ca
            -- bo trang thai nhu Check). Code cu chi xet `result == false` nen
            -- so 0 di qua nhu da mua, roi verify khong thay giam va ket luan
            -- "loi remote" - chinh la cai stall 5 phut.
            if not ok
                or result == false
                or result == 0
                or type(result) == "string"
            then
                runtime.boneRollLastError = tostring(result)
                warn(("bones | server tu choi random (%s) - ve cay tiep"):format(
                    tostring(result)))
                break
            end

            -- KHONG TIN MA TRA VE. Bang chung la BONES GIAM hoac ROLLS GIAM.
            --
            -- Va khong duoc check qua nhanh: 0.6 giay la qua ngan, server chua
            -- replicate xong nen lan doc dau tra ve dung so CU -> ket luan sai
            -- "khong nhan lenh" -> dung ngay sau luot dau. Doi >= 1 giay, doc
            -- CUONG BUC (bo cache bonesCheck 10 giay va chot RefreshMaterials 5
            -- giay), hoi toi 3 lan moi ket luan.
            local moved = false
            -- ============ FIX BONE FARM / RANDOM ============
            -- Giu lai so doc duoc lan cuoi de khi that bai con NOI RA duoc so
            -- nao khong doi. Truoc day chi bao "khong thay giam" nen khong the
            -- biet la server tu choi, hay la POS5 khong phai luot con lai.
            local lastBones, lastRolls = nil, nil
            runtime.boneRollVerifyTries = 0
            for _ = 1, 3 do
                runtime.boneRollVerifyTries = runtime.boneRollVerifyTries + 1
                runtime.bonesCheck = nil
                runtime.materialsRefreshedAt = nil
                runtime.boneRollVerifyAt = tick() + 1
                task.wait(1)
                local afterBones, afterRolls = API.RefreshBonesCheck(true)
                afterBones = tonumber(afterBones)
                afterRolls = tonumber(afterRolls)
                lastBones, lastRolls = afterBones, afterRolls
                if (afterBones ~= nil and afterBones < bones)
                    or (afterRolls ~= nil and rolls ~= nil and afterRolls < rolls)
                then
                    moved = true
                    break
                end
            end
            if not moved then
                runtime.boneRollLastError = "bones/rolls khong giam"
                warn(("bones | doc lai %d lan van khong thay giam - dung batch"
                    .. " (bone %s -> %s, luot %s -> %s, server tra %s)"):format(
                    runtime.boneRollVerifyTries,
                    tostring(bones), tostring(lastBones),
                    tostring(rolls), tostring(lastRolls),
                    tostring(result)))
                break
            end
            rolled += 1
            -- Tu hoc GIA THAT mot luot tu chenh lech do duoc, de khong phu
            -- thuoc con so 500 cung neu server doi gia.
            if lastBones ~= nil then
                local spent = bones - lastBones
                if spent >= 50 and spent <= 5000 then
                    runtime.boneRollCost = spent
                end
            end
            if talonPending then
                runtime.dragonTalonBonesBought = true
            end
        end
        runtime.boneRollBeforeBones = nil
        runtime.boneRollBeforeRolls = nil
        runtime.boneRollVerifyTries = 0
        if rolled > 0 then
            -- Xoa ca hai cache khi ket thuc dot quay. Khong xoa thi lan doc ke
            -- tiep con an cache 10 giay / 5 giay va bang hien so TRUOC khi quay.
            runtime.bonesCheck = nil
            runtime.materialsRefreshedAt = nil
            print(("bones | da random %d luot"):format(rolled))
        end
        return rolled > 0
    end

