    local function masteryRequirement(tool)
        local skills = runtime.masteryUI[tool.Name]
        if not skills then
            return nil
        end
        local cached = runtime.masteryThresholds[tool.Name]
        if cached ~= nil then
            return cached
        end
        local required = -math.huge
        for _, key in ipairs({ "Z", "X", "C", "F", "V" }) do
            local skill = skills[key]
            local levelLabel = skill and skill:FindFirstChild("Level")
            local level = levelLabel and tonumber(levelLabel.Text:match("%d+"))
            if level then
                required = math.max(required, level)
            end
        end
        runtime.masteryThresholds[tool.Name] = required
        return required
    end

    local function ensureMasteryStat(category)
        local data = LocalPlayer.Data
        local statName = category == "Blox Fruit" and "Demon Fruit" or category
        local stat = data.Stats:FindFirstChild(statName)
        if stat and stat.Level.Value >= 2800 then
            return true
        end

        local points = data.Points.Value
        if points > 0 then
            local melee = data.Stats.Melee.Level.Value
            local defense = data.Stats.Defense.Level.Value
            if melee < 2800 then
                runtime.commF:InvokeServer("AddPoint", "Melee", points)
            elseif defense < 2800 then
                runtime.commF:InvokeServer("AddPoint", "Defense", points)
            else
                runtime.commF:InvokeServer("AddPoint", statName, points)
            end
        elseif data.StatRefunds.Value > 0 then
            runtime.commF:InvokeServer("redeemRefundPoints", "Refund Points")
        elseif data.Fragments.Value >= 2500 then
            runtime.commF:InvokeServer("BlackbeardReward", "Refund", "1")
            runtime.commF:InvokeServer("BlackbeardReward", "Refund", "2")
        else
            runtime.fragmentShortage = true
        end
        return false
    end

    function API.UpdateMasterySelection()
        local config = runtime.configs["Farm Mastery"]
        if not config.Enable
            or not runtime.meleeIndex
            or runtime.meleeIndex <= #runtime.meleeDefinitions
            or runtime.useSwordAtMaxMastery
            or LocalPlayer.Data.Level.Value ~= 2800
        then
            return
        end

        runtime.masteryComplete = false
        for _, category in pairs(config["Farm Mastery Weapons"]) do
            if category == "Blox Fruit" then
                local tool = runtime.tools[category]
                if tool ~= "cac" and not table.find(runtime.masteryCompleted, tool.Name) then
                    local required = masteryRequirement(tool)
                    if required == nil then
                        API.EquipWeapon(category)
                        return
                    end
                    if toolLevel(tool) >= required then
                        runtime.masteryCategory = nil
                        table.insert(runtime.masteryCompleted, tool.Name)
                    else
                        if ensureMasteryStat(category) then
                            runtime.masteryCategory = category
                        end
                        return
                    end
                end
            elseif category == "Sword" or category == "Gun" then
                local desiredWeapons = config[category .. "s To Farm"] or {}
                for _, weaponName in pairs(desiredWeapons) do
                    local owned = runtime.progress[category]
                        and runtime.progress[category][weaponName]
                    if owned and not table.find(runtime.masteryCompleted, weaponName) then
                        local tool = runtime.tools[category]
                        if tool == "cac"
                            or tool.Name ~= weaponName
                            or (tool.Parent ~= LocalPlayer.Character
                                and tool.Parent ~= LocalPlayer.Backpack)
                        then
                            runtime.commF:InvokeServer("LoadItem", weaponName)
                            return
                        end

                        local required = masteryRequirement(tool)
                        if required == nil then
                            API.EquipWeapon(category)
                            return
                        end
                        if toolLevel(tool) >= required then
                            if category == "Gun" then
                                runtime.masteryCategory = nil
                            end
                            runtime.activeWeaponCategory = "Melee"
                            table.insert(runtime.masteryCompleted, weaponName)
                        else
                            if ensureMasteryStat(category) then
                                if category == "Gun" then
                                    runtime.activeWeaponCategory = category
                                end
                                runtime.masteryCategory = category
                            end
                            return
                        end
                    end
                end
            end
        end
        runtime.masteryComplete = true
    end

    function API.CheckColorsDealer()
        -- CHOT 20 GIAY. Ham nay goi tu RunSecondaryFeatures (vong ~100Hz) va
        -- truoc gio KHONG co chot nao: ban ghi remote cho thay "ColorsDealer"
        -- ban ~7 lan MOI GIAY, khong nghi, suot phien. Barista Cousin 20 PHUT
        -- moi doi mot mau nen khong co gi thay doi nhanh hon the.
        if tick() - (runtime.colorsDealerAt or 0) < 20 then
            return
        end
        runtime.colorsDealerAt = tick()
        -- Du ca ba mau roi thi khong con gi de hoc.
        if progressCount("Pure Red") > 0
            and progressCount("Winter Sky") > 0
            and progressCount("Snow White") > 0
        then
            return
        end
        local askOk, color = pcall(function()
            return runtime.commF:InvokeServer("ColorsDealer", "1")
        end)
        if not askOk then
            return
        end
        if not color
            or color == 1
            or not table.find({ "Pure Red", "Snow White", "Winter Sky" }, color)
        then
            return
        end

        local skin = runtime.idMap.Skin and runtime.idMap.Skin[color]
        if not skin then
            return
        end
        local hasQuest = false
        pcall(function()
            hasQuest = runtime.skinDefinition.Definition.Quest.match(skin):isSome()
        end)
        if not hasQuest then
            return
        end
        local recipes = runtime.recipesAndMaterials and runtime.recipesAndMaterials.Recipes
        if recipes and recipes[color] then
            return
        end
        runtime.commF:InvokeServer("ColorsDealer", "2")
        API.LoadProgress()
    end

