        -- Chi giu bai quai CUNG DAO voi toa do trong bang. Cung mot ten quai co
        -- marker o nhieu dao; giu het thi farm bay qua lai giua 2 dao mai
        -- (Port Town <-> dao ke) va khong bao gio danh duoc con nao.
        local function homeMobSpots(mobName, home)
            local spots = liveMobSpots(mobName)
            if spots == nil then
                return nil
            end
            if typeof(spots) == "CFrame" then
                spots = { spots }
            end
            if home == nil then
                return spots
            end
            local kept = {}
            for _, spot in ipairs(spots) do
                if (spot.Position - home).Magnitude <= 1500 then
                    table.insert(kept, spot)
                end
            end
            -- KHONG bai song nao gan toa do trong bang = GAME DA DOI DAO, chu
            -- khong phai het quai. Truoc day tra nil o day nen bang giu nguyen
            -- toa do CHET va farm bay vao khoang khong. Bam lay cum song gan
            -- toa do cu nhat va lay do lam dao moi - du lieu song luon dung hon
            -- bang viet tay.
            if #kept == 0 then
                local anchor, anchorGap = nil, nil
                for _, spot in ipairs(spots) do
                    local gap = (spot.Position - home).Magnitude
                    if anchorGap == nil or gap < anchorGap then
                        anchor, anchorGap = spot, gap
                    end
                end
                if anchor == nil then
                    return nil
                end
                runtime.mobHome[mobName] = anchor.Position
                for _, spot in ipairs(spots) do
                    if (spot.Position - anchor.Position).Magnitude <= 1500 then
                        table.insert(kept, spot)
                    end
                end
                if tick() - (runtime.mobMovedSaidAt or 0) > 30 then
                    runtime.mobMovedSaidAt = tick()
                    print(("farm | %s: bang toa do da cu (lech %d studs) - lay bai song")
                        :format(tostring(mobName), math.floor(anchorGap or 0)))
                end
            end
            if #kept == 1 then
                return kept[1]
            end
            return kept
        end

        -- TUYEN QUEST LAY TU BANG XeroQuestData.Quests, KHONG DUNG NUA.
        -- Truoc day dung lai ca bang tu module Quests cua game: LevelReq va
        -- thu tu bien nhau -> acc 1516 nhay sang moc 1575. Du lieu song chi
        -- dung de CAP NHAT TOA DO (bai quai + NPC), khong doi moc level.
        runtime.mobHome = runtime.mobHome or {}
        for _, quest in ipairs(runtime.quests) do
            runtime.mobHome[quest.mob_name] = runtime.mobHome[quest.mob_name]
                or firstPosition(quest.mob_pos)
            local mobSpots = homeMobSpots(quest.mob_name, runtime.mobHome[quest.mob_name])
            if mobSpots ~= nil then
