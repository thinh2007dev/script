    local function storeFruitIfAllowed(child)
        local name = child.Name
        if not name:match("Fruit$") or not runtime.allowFruitStorage then
            return
        end
        local firstWord = name:match("(%S+)")
        local storageKey = firstWord .. "-" .. firstWord
        local physicalMovesets = runtime.inventory.PhysicalMoveset
        local stored = physicalMovesets and physicalMovesets[storageKey]
        if stored and stored.Count >= LocalPlayer.Data.FruitCap.Value then
            return
        end

        for _ = 1, 3 do
            runtime.commF:InvokeServer("StoreFruit", storageKey, child)
            task.wait(0.5)
            if child.Parent ~= LocalPlayer.Backpack then
                runtime.normalRaidReady = true
                runtime.doughRaidReady = true
                runtime.skullGuitarState.can_buy = true
                return
            end
        end
    end

