        -- Ca hai thu muc deu la dot-access: map khong co "NPCs" la throw. Va
        -- `.WorldPivot` tran o day cung la cai bay nhu MysticIsland.
        -- Workspace GHI DE (toa do song), ReplicatedStorage chi bu cho ten con
        -- thieu - giu dung thu tu uu tien cu.
        for _, source in ipairs({
            { folder = Services.Workspace:FindFirstChild("NPCs"), overwrite = true },
            { folder = Services.ReplicatedStorage:FindFirstChild("NPCs"), overwrite = false },
        }) do
            if source.folder ~= nil then
                local childrenOk, children = pcall(function()
                    return source.folder:GetChildren()
                end)
                if childrenOk and type(children) == "table" then
                    for _, npc in ipairs(children) do
                        local nameOk, name = pcall(function()
                            return npc.Name
                        end)
                        if nameOk and type(name) == "string"
                            and (source.overwrite or runtime.npcFrames[name] == nil)
                        then
                            local pivot = API.PivotOf(npc)
                            if pivot ~= nil then
                                runtime.npcFrames[name] = pivot
                            end
                        end
                    end
                end
            end
        end
        for _, npc in ipairs(API.SafeNilInstances()) do
            local loadedOk, loaded = pcall(function()
                return npc:GetAttribute("NPCLoaded")
            end)
            if loadedOk and loaded and runtime.npcFrames[npc.Name] == nil then
                local pivot = API.PivotOf(npc)
                if pivot ~= nil then
                    runtime.npcFrames[npc.Name] = pivot
                end
            end
        end
    end

