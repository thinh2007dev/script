        end

        -- Cap nhat het toa do quai con lai (farm material, bone, cake...).
        for mobName, current in pairs(runtime.mobPositions) do
            runtime.mobHome[mobName] = runtime.mobHome[mobName] or firstPosition(current)
            local mobSpots = homeMobSpots(mobName, runtime.mobHome[mobName])
            if mobSpots ~= nil then
                runtime.mobPositions[mobName] = mobSpots
            end
        end

        local markerNames = 0
        for _ in pairs(markerPositions) do
            markerNames += 1
        end
        print(("quests | sea=%d rows=%d markerNames=%d"):format(
