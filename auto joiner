        if not config.Enable
            or (config["When x2 Exp Expired"]
                and runtime.expBoostSeconds > 0
                and LocalPlayer.Data.Level.Value ~= 2800)
        then
            return false
        end

        for _, category in ipairs({ "Swords", "Guns", "Accessories" }) do
