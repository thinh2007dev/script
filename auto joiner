        if string.find(humanoid.DisplayName, "Boss", 1, true) then
            runtime.bossTemplateFrames[child.Name] = child.HumanoidRootPart.CFrame
            return
        end
        if child.Name == "Diablo" or child.Name == "Deandre" or child.Name == "Urban" then
            runtime.eliteBossName = child.Name
            runtime.bossTemplateFrames[child.Name] = child.HumanoidRootPart.CFrame
        end
