    local function getHopSeenBucket(category, eventName)
        local byCategory = runtime.hopDataSeen[category]
        if type(byCategory) ~= "table" then
            byCategory = {}
            runtime.hopDataSeen[category] = byCategory
        end
        local byEvent = byCategory[eventName]
        if type(byEvent) ~= "table" then
            byEvent = {}
            byCategory[eventName] = byEvent
        end
        return byEvent
    end

    local function teleportToHopCandidate(category, eventName, encryptedKey, observedAt)
        local byEvent = getHopSeenBucket(category, eventName)
        byEvent[encryptedKey] = tostring(observedAt)
        persistHopSeen()

        local plaintext = decodeHopServerKey(encryptedKey)
        if not plaintext then
            return
        end
        local fields = plaintext:split("|")
        local placeId = tonumber(fields[1])
        local jobId = fields[2]
        if byEvent[jobId] then
            return
        end
        byEvent[jobId] = tostring(observedAt)
        persistHopSeen()

        if placeId ~= game.PlaceId then
            return
        end
        -- Duong doi sever thu hai (san boss theo hopdata). Cung phai tuan
        -- "Disable All Hop", neu khong tat hop van con mot cua bo ngo.
        if runtime.configs["Disable All Hop"] ~= false then
            return
        end
        print("set hop")
        runtime.hopInProgress = true
        ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", jobId)
        task.wait(5)
    end

    local function qualifiesHopEvent(eventName)
        if eventName == "rip_indra True Form" then
            local needsTushita = runtime.configs.Hop["Hop Find Tushita"]
                and not ownsProgress("Moveset", "Tushita")
                and not runtime.tushitaDoorOpened
                and API.GetBossCFrame("rip_indra True Form") == "undefined"
            local needsValkyrie = runtime.configs.Hop["Hop Find Valkyrie Helm"]
                and not ownsProgress("Wear", "Valkyrie Helm")
                and hopPriorityAvailable("Auto Hop Boss")
            return needsTushita or needsValkyrie
        end
        if eventName == "Dough King" then
            return runtime.configs.Hop["Hop Find Mirror Fractal"]
                and not ownsProgress("Material", "Mirror Fractal")
                and hopPriorityAvailable("Auto Hop Boss")
        end
        if eventName == "Soul Reaper" then
            return runtime.configs.Hop["Hop Find Soul Reaper"]
                and LocalPlayer.Data.Level.Value == 2800
                and hopPriorityAvailable("Auto Hop Boss")
                and runtime.cdkProgress
                and runtime.cdkProgress.Evil == 2
        end
        if eventName == "Mirage" then
            return runtime.configs.Hop["Hop Find Mirage"]
                and hopPriorityAvailable("Auto Hop Mirage")
                and not runtime.templeDoorOpen
                and type(runtime.raceV4State) == "number"
                and runtime.raceV4State > 3
                and runtime.raceV3State == -2
                and LocalPlayer.Data.Level.Value == 2800
        end
        if eventName == "Darkbeard" then
            return runtime.configs.Hop["Hop Find Darkbeard"]
                and not ownsProgress("Material", "Dark Fragment")
                and table.find(XeroQuestData.PlaceIds[2], game.PlaceId) ~= nil
                and runtime.queue:top() == "Auto Skull Guitar"
                and runtime.skullGuitarState.finding_fist
        end
        return false
    end

    function API.PollHopData()
        if runtime.hopInProgress
            or runtime.expBoostSeconds ~= 0
            or LocalPlayer.Data.Level.Value < 2000
        then
            return runtime.hopData
        end

        local now = os.time()
        for _, byEvent in pairs(runtime.hopDataSeen) do
            for _, byJob in pairs(byEvent) do
                for jobId, timestamp in pairs(byJob) do
                    if now - (tonumber(timestamp) or 0) > 300 then
                        byJob[jobId] = nil
                    end
                end
            end
        end

        if runtime.lastHopPoll == nil or tick() - runtime.lastHopPoll > 10 then
            local requestFunction = request or http_request or http and http.request or syn and syn.request
            if type(requestFunction) == "function" then
                local ok, response = pcall(requestFunction, {
                    Url = "https://hops2.xerohub.click/hopdata.json",
                    Method = "GET",
                    Headers = {
                        ["Content-Type"] = "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7",
                        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
                    },
                })
                if ok and response and response.Body then
                    local decodedOk, decoded = pcall(
                        Services.HttpService.JSONDecode,
                        Services.HttpService,
                        response.Body
                    )
                    if decodedOk and type(decoded) == "table" then
                        runtime.hopData = decoded
                        runtime.lastHopPoll = tick()
                        if writefile then
                            pcall(
                                writefile,
                                hopCachePath,
                                Services.HttpService:JSONEncode({
                                    hop_data = runtime.hopData,
                                    last_poll = runtime.lastHopPoll,
                                })
                            )
                        end
                    end
                end
            end
        end

        local unlockables = runtime.unlockables
        if not unlockables or not unlockables.KilledIndraBoss then
            return runtime.hopData
        end
        for category, byEvent in pairs(runtime.hopData) do
            if type(byEvent) == "table" then
                for eventName, byEncryptedKey in pairs(byEvent) do
                    if type(byEncryptedKey) == "table" and qualifiesHopEvent(eventName) then
                        local seenBucket = getHopSeenBucket(category, eventName)
                        for encryptedKey, timestamp in pairs(byEncryptedKey) do
                            local age = now - (tonumber(timestamp) or 0)
                            if age <= 300
                                and not seenBucket[encryptedKey]
                            then
                                teleportToHopCandidate(
                                    category,
                                    eventName,
                                    encryptedKey,
                                    timestamp
                                )
                            end
                        end
                    end
                end
            end
        end
        return runtime.hopData
    end

