    -- hoi "sever nay co boss khong" KHONG the tra loi tu bai farm; phai bay toi
    -- o spawn roi moi ket luan. Ham nay cho toa do o spawn du boss chua spawn.
    --
    -- Ba nguon vi moi sea/sever bay mot kieu (da do o sea 2):
    --   1. _WorldOrigin.EnemySpawns."<Ten> [Lv. N] [Boss]"   (Tide Keeper)
    --   2. _WorldOrigin."<TEN HOA> Respawn Marker"   (Awakened Ice Admiral)
    --   3. ReplicatedStorage.FortBuilderReplicatedSpawnPositionsFolder."<Ten>"
    function API.BossSpawnCFrame(name)
        if type(name) ~= "string" or name == "" then
            return nil
        end
        local cached = runtime.bossSpawnFrames[name]
        if typeof(cached) == "CFrame" then
            return cached
        end
        local origin = Services.Workspace:FindFirstChild("_WorldOrigin")
        if origin ~= nil then
            local wanted = string.upper(name)
            for _, child in ipairs(origin:GetChildren()) do
                local childName = string.upper(child.Name)
                if string.find(childName, "RESPAWN MARKER", 1, true) ~= nil
                    and string.find(childName, wanted, 1, true) ~= nil
                then
                    local pivot = API.PivotOf(child)
                    if pivot ~= nil then
                        runtime.bossSpawnFrames[name] = pivot
                        return pivot
                    end
                end
            end
        end
        local folder = Services.ReplicatedStorage
            :FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
        local node = folder ~= nil and folder:FindFirstChild(name) or nil
        if node ~= nil then
            local pivot = API.PivotOf(node)
            if pivot ~= nil then
                runtime.bossSpawnFrames[name] = pivot
                return pivot
            end
        end
        return nil
    end

