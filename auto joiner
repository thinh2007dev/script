    local function carriesItem(itemName)
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local character = LocalPlayer.Character
        return (backpack ~= nil and backpack:FindFirstChild(itemName) ~= nil)
            or (character ~= nil and character:FindFirstChild(itemName) ~= nil)
