        -- Gom cum 500 studs. KHONG lay trung binh: trung binh cua 2 bai o 2 dao
        -- khac nhau la khoang bien o giua.
        local function liveMobSpots(mobName)
            local positions = markerPositions[mobName]
            if type(positions) ~= "table" or #positions == 0 then
                return nil
            end
            local clusters = {}
            for _, position in ipairs(positions) do
                local nearestIndex, nearestDistance = nil, math.huge
                for index, cluster in ipairs(clusters) do
                    local gap = (position - cluster.total / cluster.count).Magnitude
                    if gap < nearestDistance then
                        nearestIndex, nearestDistance = index, gap
                    end
                end
                if nearestIndex ~= nil and nearestDistance <= 500 then
                    local cluster = clusters[nearestIndex]
                    cluster.total += position
                    cluster.count += 1
                else
                    table.insert(clusters, { total = position, count = 1 })
                end
            end
            local spots = {}
            for _, cluster in ipairs(clusters) do
                table.insert(spots, CFrame.new(
                    cluster.total / cluster.count + Vector3.new(0, 30, 0)
                ))
            end
            if #spots == 1 then
                return spots[1]
            end
            return spots
        end

